<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="QueueApp.Features.History.HistoryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.History"
             xmlns:models="clr-namespace:QueueApp.Features.History.Models"
             xmlns:helpers="clr-namespace:QueueApp.Features.History.Helpers"
             xmlns:skeleton="clr-namespace:QueueApp.Shared.Templates.Skeleton"
             x:DataType="vm:HistoryPageViewModel"
             IconImageSource="icon_history"
             Title="History"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,Auto,*" Style="{StaticResource grid_Page}">

        <!-- Title and filter bar are known strings and stay real while the list loads. -->
        <Label Grid.Row="0" Text="History"
               Margin="16,16,16,0"
               Style="{StaticResource lbl26_Bold_PageTitle}"/>

        <helpers:HistoryFilterBar Grid.Row="1"
                                   IsAllSelected="{Binding IsAllSelected}"
                                   IsVisitsSelected="{Binding IsVisitsSelected}"
                                   IsBookingsSelected="{Binding IsBookingsSelected}"
                                   SetFilterCommand="{Binding SetFilterCommand}"/>

        <Grid Grid.Row="2">

            <CollectionView ItemsSource="{Binding Groups}"
                             IsGrouped="True"
                             IsVisible="{Binding ShowList}"
                             ItemSizingStrategy="MeasureFirstItem"
                             ItemsUpdatingScrollMode="KeepScrollOffset">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="models:HistoryGroup">
                        <helpers:HistoryGroupHeaderView/>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryRow">
                        <helpers:HistoryRowView OpenCommand="{Binding OpenRowCommand, Source={RelativeSource AncestorType={x:Type vm:HistoryPageViewModel}}}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <helpers:HistoryEmptyStateView IsVisible="{Binding IsEmpty}"
                                            EmptyTitle="{Binding EmptyTitle}"
                                            EmptyBody="{Binding EmptyBody}"
                                            BrowseCommand="{Binding BrowseCommand}"/>

            <!--
                The skeleton's way out. The group headers are not drawn while loading because their
                text is bucketed from the rows themselves — they are data here, not chrome, and the
                page cannot know them yet.
            -->
            <helpers:HistoryEmptyStateView IsVisible="{Binding HasLoadFailed}"
                                            Icon="ic_alert"
                                            EmptyTitle="{x:Static vm:HistoryPageViewModel.LoadFailureTitle}"
                                            EmptyBody="{Binding LoadFailureText}"
                                            ActionText="{x:Static vm:HistoryPageViewModel.RetryActionText}"
                                            BrowseCommand="{Binding RetryLoadCommand}"/>

            <skeleton:SkeletonList Kind="ListRow"
                                   Count="{x:Static vm:HistoryPageViewModel.SkeletonRowCount}"
                                   VerticalOptions="Start"
                                   IsVisible="{Binding IsFirstLoading}"/>
        </Grid>
    </Grid>
</ContentPage>
