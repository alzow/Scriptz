<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="QueueApp.Features.History.HistoryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.History"
             x:DataType="vm:HistoryPageViewModel"
             Style="{StaticResource NavigationPageStyle}">
    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
        <Label Text="History" Style="{StaticResource lbl20_Bold_TextDark}" HorizontalOptions="Center"/>
        <Label Text="Your past visits will show up here." TextColor="Gray" HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>
