<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QueueApp.Features.History.Models"
             x:Name="Root"
             x:DataType="models:HistoryRow"
             x:Class="QueueApp.Features.History.Helpers.HistoryRowView">
    <Border Style="{StaticResource brd16_White}"
            HeightRequest="72"
            Margin="20,0,20,8"
            Padding="12,0">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCommand, Source={x:Reference Root}}"
                                   CommandParameter="{Binding .}"/>
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">

            <Border Grid.Column="0"
                    WidthRequest="44" HeightRequest="44"
                    BackgroundColor="{StaticResource SurfaceRaised}"
                    Stroke="{StaticResource Line}"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="13"/>
                </Border.StrokeShape>
                <Image Source="{Binding CategoryIcon}"
                       WidthRequest="26" HeightRequest="26"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                <Label Text="{Binding BusinessName}"
                       FontSize="14.5" FontAttributes="Bold" CharacterSpacing="-0.2"
                       TextColor="{StaticResource TextPrimary}"
                       LineBreakMode="TailTruncation"/>
                <Label Text="{Binding MetaLine}"
                       FontSize="11.5"
                       TextColor="{StaticResource TextMuted}"
                       LineBreakMode="TailTruncation"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="5" HorizontalOptions="End" VerticalOptions="Center">
                <Border Padding="8,4"
                        BackgroundColor="{Binding StatusFill}"
                        Stroke="{Binding StatusStroke}"
                        StrokeThickness="{Binding StatusStrokeThickness}"
                        HorizontalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="7"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="4">
                        <Image Source="ic_alert" WidthRequest="10" HeightRequest="10"
                               IsVisible="{Binding ShowWarningIcon}" VerticalOptions="Center"/>
                        <Label Text="{Binding StatusText}"
                               FontFamily="RobotoBold" FontSize="9.5" CharacterSpacing="0.8"
                               TextColor="{Binding StatusInk}"/>
                    </HorizontalStackLayout>
                </Border>
                <Label Text="{Binding TimeText}"
                       FontFamily="RobotoRegular" FontSize="10" CharacterSpacing="0.5"
                       TextColor="{StaticResource TextFaint}"
                       HorizontalOptions="End"/>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
