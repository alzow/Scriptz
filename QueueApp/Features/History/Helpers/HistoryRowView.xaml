<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             xmlns:models="clr-namespace:QueueApp.Features.History.Models"
             x:Name="Root"
             x:DataType="models:HistoryRow"
             x:Class="QueueApp.Features.History.Helpers.HistoryRowView">
    <!--
        Height, margin, padding, column spacing and the leading tile all come from the ListRow
        styles rather than from literals here, because SkeletonListRowView reads the same keys.
        Change a number there and both this row and its skeleton move together; there is nowhere
        left for the two to drift apart.
    -->
    <Border Style="{StaticResource brd16_ListRow}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCommand, Source={x:Reference Root}}"
                                   CommandParameter="{Binding .}"/>
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*,Auto" Style="{StaticResource grid_ListRow}">

            <Border Grid.Column="0" Style="{StaticResource brd13_RowIcon}">
                <Image Source="{Binding CategoryIcon}"
                       WidthRequest="26" HeightRequest="26"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <VerticalStackLayout Grid.Column="1" Style="{StaticResource vsl_RowText}">
                <Label Text="{Binding BusinessName}"
                       Style="{StaticResource lbl14_Bold_HistoryRow}"
                       LineBreakMode="TailTruncation"/>
                <Label Text="{Binding MetaLine}"
                       Style="{StaticResource lbl12_Regular_HistoryMeta}"
                       LineBreakMode="TailTruncation"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Style="{StaticResource vsl_RowTrailing}">
                <Border Padding="8,4"
                        BackgroundColor="{Binding StatusFill}"
                        Stroke="{Binding StatusStroke}"
                        StrokeThickness="{Binding StatusStrokeThickness}"
                        HorizontalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="7"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="4">
                        <tpl:ThemedIcon Icon="ic_alert" WidthRequest="10" HeightRequest="10"
                               IsVisible="{Binding ShowWarningIcon}" VerticalOptions="Center"/>
                        <Label Text="{Binding StatusText}"
                               Style="{StaticResource lbl11_Bold_StatusPill}"
                               TextColor="{Binding StatusInk}"/>
                    </HorizontalStackLayout>
                </Border>
                <Label Text="{Binding TimeText}"
                       Style="{StaticResource lbl11_Regular_Timestamp}"
                       HorizontalOptions="End"/>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
