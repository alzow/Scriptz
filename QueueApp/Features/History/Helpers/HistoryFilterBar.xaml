<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.History.Helpers.HistoryFilterBar">
    <HorizontalStackLayout Spacing="8" Margin="20,16,20,4">
        <Border Style="{StaticResource brd16_Chip}">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsAllSelected, Source={x:Reference Root}}" Value="True">
                    <Setter Property="Style" Value="{StaticResource brd16_Chip_Selected}"/>
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsAllSelected, Source={x:Reference Root}}" Value="False">
                    <Setter Property="Style" Value="{StaticResource brd16_Chip}"/>
                </DataTrigger>
            </Border.Triggers>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SetFilterCommand, Source={x:Reference Root}}" CommandParameter="All"/>
            </Border.GestureRecognizers>
            <Label Text="All" Style="{StaticResource lbl13_Chip}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsAllSelected, Source={x:Reference Root}}" Value="True">
                        <Setter Property="Style" Value="{StaticResource lbl13_Chip_Selected}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsAllSelected, Source={x:Reference Root}}" Value="False">
                        <Setter Property="Style" Value="{StaticResource lbl13_Chip}"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Border>

        <Border Style="{StaticResource brd16_Chip}">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsVisitsSelected, Source={x:Reference Root}}" Value="True">
                    <Setter Property="Style" Value="{StaticResource brd16_Chip_Selected}"/>
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsVisitsSelected, Source={x:Reference Root}}" Value="False">
                    <Setter Property="Style" Value="{StaticResource brd16_Chip}"/>
                </DataTrigger>
            </Border.Triggers>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SetFilterCommand, Source={x:Reference Root}}" CommandParameter="Visits"/>
            </Border.GestureRecognizers>
            <Label Text="Visits" Style="{StaticResource lbl13_Chip}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsVisitsSelected, Source={x:Reference Root}}" Value="True">
                        <Setter Property="Style" Value="{StaticResource lbl13_Chip_Selected}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsVisitsSelected, Source={x:Reference Root}}" Value="False">
                        <Setter Property="Style" Value="{StaticResource lbl13_Chip}"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Border>

        <Border Style="{StaticResource brd16_Chip}">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsBookingsSelected, Source={x:Reference Root}}" Value="True">
                    <Setter Property="Style" Value="{StaticResource brd16_Chip_Selected}"/>
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsBookingsSelected, Source={x:Reference Root}}" Value="False">
                    <Setter Property="Style" Value="{StaticResource brd16_Chip}"/>
                </DataTrigger>
            </Border.Triggers>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SetFilterCommand, Source={x:Reference Root}}" CommandParameter="Bookings"/>
            </Border.GestureRecognizers>
            <Label Text="Bookings" Style="{StaticResource lbl13_Chip}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsBookingsSelected, Source={x:Reference Root}}" Value="True">
                        <Setter Property="Style" Value="{StaticResource lbl13_Chip_Selected}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsBookingsSelected, Source={x:Reference Root}}" Value="False">
                        <Setter Property="Style" Value="{StaticResource lbl13_Chip}"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Border>
    </HorizontalStackLayout>
</ContentView>
