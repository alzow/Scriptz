<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.History.Helpers.HistoryEmptyStateView">
    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="40,0" MaximumWidthRequest="300">
        <Border WidthRequest="84" HeightRequest="84"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Line}"
                StrokeThickness="1"
                StrokeDashArray="4,3"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="26"/>
            </Border.StrokeShape>
            <Image Source="ic_ticket" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>
        <Label Text="{Binding EmptyTitle, Source={x:Reference Root}}" Style="{StaticResource lbl20_Bold_TextDark}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        <Label Text="{Binding EmptyBody, Source={x:Reference Root}}" TextColor="{StaticResource TextMuted}" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        <Border Padding="20,11" Margin="0,10,0,0" BackgroundColor="Transparent" Stroke="{StaticResource Line}" StrokeThickness="1" HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding BrowseCommand, Source={x:Reference Root}}"/>
            </Border.GestureRecognizers>
            <Label Text="Browse nearby" FontAttributes="Bold" FontSize="13.5" TextColor="{StaticResource TextPrimary}"/>
        </Border>
    </VerticalStackLayout>
</ContentView>
