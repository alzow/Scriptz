<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.CategoryPicker"
             xmlns:helpers="clr-namespace:QueueApp.Features.CategoryPicker.Helpers"
             x:Name="Root"
             x:Class="QueueApp.Features.CategoryPicker.CategoryPickerPage"
             x:DataType="vm:CategoryPickerPageViewModel"
             Title="Browse"
             IconImageSource="icon_dashboard"
             Style="{StaticResource NavigationPageStyle}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,28" Spacing="0">

                <!-- Greeting + notifications -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding WelcomeMessage}" Style="{StaticResource lbl22_Bold_Cream}"/>
                        <HorizontalStackLayout Spacing="6">
                            <Ellipse Fill="{StaticResource Green}" WidthRequest="5" HeightRequest="5" VerticalOptions="Center"/>
                            <Label Text="Lenasia" Style="{StaticResource lbl12_Regular_TextLight}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            WidthRequest="38" HeightRequest="38"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Line}" StrokeThickness="1"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Label Text="🔔" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Search -->
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Line}" StrokeThickness="1"
                        HeightRequest="44"
                        Margin="0,16,0,0"
                        Padding="14,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="13"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="🔍" FontSize="13" VerticalOptions="Center" Margin="0,0,10,0"/>
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Search barbers, car washes, clinics"
                               PlaceholderColor="{StaticResource TextMuted}"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="13.5"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Live queue hero, or the quiet idle band -->
                <helpers:LiveQueueHeroView Margin="0,16,0,0"
                        IsVisible="{Binding HasActiveEntry}"
                        ActiveEntry="{Binding ActiveEntry}"
                        DirectionsCommand="{Binding OpenDirectionsCommand}"
                        LeaveCommand="{Binding LeaveQueueCommand}"
                        IsLeaving="{Binding IsLeavingQueue}"/>
                <helpers:IdleDiscoveryBandView Margin="0,16,0,0"
                        IsVisible="{Binding HasActiveEntry, Converter={StaticResource InvertedBoolConverter}}"
                        QuietestNowText="{Binding QuietestNowText}"/>

                <!-- Categories -->
                <Label Text="BROWSE BY CATEGORY" Style="{StaticResource SectionTitle}" Margin="0,26,0,12"/>
                <helpers:CategoryCarouselView
                        Categories="{Binding Categories}"
                        SelectedCategory="{Binding SelectedCategory}"
                        SelectCommand="{Binding SelectCategoryCommand}"/>

                <!-- Upcoming bookings -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,26,0,10" IsVisible="{Binding HasUpcomingBookings}">
                    <Label Grid.Column="0" Text="UPCOMING" Style="{StaticResource SectionTitle}"/>
                </Grid>
                <helpers:UpcomingBookingsListView
                        IsVisible="{Binding HasUpcomingBookings}"
                        Items="{Binding UpcomingBookings}"
                        CancelCommand="{Binding CancelBookingCommand}"/>

                <!-- Nearby businesses -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,26,0,10">
                    <Label Grid.Column="0" Text="OPEN NOW NEAR YOU" Style="{StaticResource SectionTitle}"/>
                    <Label Grid.Column="1" Text="See all" Style="{StaticResource lbl13_Bold_Orange}" FontSize="11">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SeeAllBusinessesCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <helpers:BrowseBusinessListView
                        Items="{Binding Businesses}"
                        OpenCommand="{Binding OpenBusinessCommand}"/>
                <Label Text="No businesses match yet."
                       Style="{StaticResource lbl13_Regular_TextLight}"
                       IsVisible="{Binding IsBusinessesEmpty}"
                       HorizontalOptions="Center"
                       Margin="0,20,0,0"/>
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                    Color="{StaticResource Green}" Margin="0,16,0,0"/>

                <!-- Frequent -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,26,0,10" IsVisible="{Binding HasFrequentBusinesses}">
                    <Label Grid.Column="0" Text="YOU GO HERE A LOT" Style="{StaticResource SectionTitle}"/>
                </Grid>
                <helpers:FrequentBusinessListView
                        IsVisible="{Binding HasFrequentBusinesses}"
                        Items="{Binding FrequentBusinesses}"
                        OpenCommand="{Binding OpenBusinessCommand}"/>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
