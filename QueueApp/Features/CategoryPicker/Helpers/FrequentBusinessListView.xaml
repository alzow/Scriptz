<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             xmlns:models="clr-namespace:QueueApp.Features.CategoryPicker.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.CategoryPicker.Helpers.FrequentBusinessListView">

    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:FrequentBusinessItem">
                <Border Style="{StaticResource brd16_White}" Padding="14" Margin="0,5">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding OpenCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="52,*" ColumnSpacing="13">
                        <Border Grid.Column="0"
                                WidthRequest="52" HeightRequest="52"
                                Style="{StaticResource brd_Raised_Lined}"
                                Padding="0" VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <tpl:ThemedIcon Icon="ic_refresh" WidthRequest="24" HeightRequest="24"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding BusinessName}"
                                       Style="{StaticResource lbl15_Bold_TextDark}"/>
                                <Border Grid.Column="1"
                                        Style="{StaticResource brd7_Raised_Tag}"
                                        Padding="8,4" VerticalOptions="Center">
                                    <Label Text="{Binding VisitCountText}" Style="{StaticResource lbl11_Bold_TextMuted}"/>
                                </Border>
                            </Grid>
                            <Label Text="{Binding LastVisitText}" Style="{StaticResource lbl12_Regular_TextLight}"/>
                            <Label Text="{Binding UsualText}" Style="{StaticResource lbl11_Regular_TextMuted}" Margin="0,1,0,0"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>

</ContentView>
