<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.CategoryPicker.Helpers.IdleDiscoveryBandView">

    <Border Style="{StaticResource brd_Ghost_Dashed}"
            Padding="18,20">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="18"/>
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="7">
            <Label Text="You're not waiting anywhere." Style="{StaticResource lbl18_Bold_TextDark}"/>
            <Label Text="Pick a category to see who's open and how long the queue is right now. Join from here — walk in when it's nearly your turn."
                   Style="{StaticResource lbl13_Regular_TextLight}"/>
        </VerticalStackLayout>
    </Border>

</ContentView>
