<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.CategoryPicker.Helpers.IdleDiscoveryBandView">

    <!-- Shown instead of LiveQueueHeroView when the customer isn't queued anywhere — quiet and
         dashed on purpose, so the loudest thing on the screen is never decorative. -->
    <Border BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource Line}" StrokeThickness="1"
            StrokeDashArray="4,3"
            Padding="18,20">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="18"/>
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="7">
            <Label Text="You're not waiting anywhere." Style="{StaticResource lbl18_Bold_TextDark}"/>
            <Label Text="Pick a category to see who's open and how long the queue is right now. Join from here — walk in when it's nearly your turn."
                   Style="{StaticResource lbl13_Regular_TextLight}"/>
            <Border BackgroundColor="{StaticResource SurfaceRaised}"
                    Stroke="{StaticResource Line}" StrokeThickness="1"
                    Padding="11,7"
                    HorizontalOptions="Start"
                    Margin="0,7,0,0"
                    IsVisible="{Binding QuietestNowText, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9"/>
                </Border.StrokeShape>
                <Label Style="{StaticResource lbl12_Regular_TextLight}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Quietest now "/>
                            <Span Text="{Binding QuietestNowText, Source={x:Reference Root}}"
                                  TextColor="{StaticResource Green}" FontFamily="RobotoBold"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Border>
        </VerticalStackLayout>
    </Border>

</ContentView>
