<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:bookingModels="clr-namespace:QueueApp.Services.Api.Booking.Models"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             x:Name="Root"
             x:Class="QueueApp.Features.CategoryPicker.Helpers.UpcomingBookingsListView">

    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="bookingModels:UpcomingBookingResponse">
                <Border Style="{StaticResource brd16_White}" Padding="14" Margin="0,5">

                    <!-- Date rail, then the booking, then what you can do about it. The rail is Auto
                         so a two-digit day sets its own width instead of being squeezed. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">

                        <Grid Grid.Column="0" ColumnDefinitions="Auto,1" ColumnSpacing="13"
                              VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2"
                                                 MinimumWidthRequest="30"
                                                 HorizontalOptions="Center">
                                <Label Text="{Binding DayText}"
                                       Style="{StaticResource lbl19_Bold_TextDark}"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding MonthText}"
                                       Style="{StaticResource lbl9_Mono_TextMuted}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <BoxView Grid.Column="1" Color="{StaticResource Line}"/>
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding BusinessName}" Style="{StaticResource lbl15_Bold_TextDark}"/>
                            <Label Text="{Binding ScheduleText}" Style="{StaticResource lbl12_Regular_TextLight}"/>
                            <Label Text="{Binding ProgressStatus}"
                                   IsVisible="{Binding HasProgress}"
                                   Style="{StaticResource lbl11_Medium_Green}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="8"
                                             HorizontalOptions="End" VerticalOptions="Center">

                            <!-- Confirmed is the default; a pending request is the exception, so it
                                 is the one the trigger repaints. -->
                            <Border Style="{StaticResource brd20_StatusPill}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="pending">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PurpleBadgeFill}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding StatusLabel}" Style="{StaticResource lbl10_Bold_Green}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="pending">
                                            <Setter Property="TextColor" Value="{StaticResource Purple}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <controls:AlzowLoadingButton
                                    Text="Cancel"
                                    LoadingText="Cancelling…"
                                    IsVisible="{Binding IsCancellable}"
                                    Command="{Binding BindingContext.CancelCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}"
                                    IsLoading="{Binding IsCancelling}"
                                    ButtonStyle="{StaticResource btn12_Bold_RowAction}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>

</ContentView>
