<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:bookingModels="clr-namespace:QueueApp.Services.Api.Booking.Models"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             x:Name="Root"
             x:Class="QueueApp.Features.CategoryPicker.Helpers.UpcomingBookingsListView">

    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="bookingModels:UpcomingBookingResponse">
                <Border Style="{StaticResource brd16_White}" Padding="14" Margin="0,5">
                    <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="13">
                        <VerticalStackLayout Grid.Column="0"
                                              HorizontalOptions="Center"
                                              Spacing="2"
                                              Padding="0,0,13,0">
                            <VerticalStackLayout.Resources>
                                <Style TargetType="BoxView">
                                    <Setter Property="Color" Value="{StaticResource Line}"/>
                                </Style>
                            </VerticalStackLayout.Resources>
                            <Label Text="{Binding DayText}" FontFamily="RobotoBold" FontSize="19"
                                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="{Binding MonthText}" Style="{StaticResource SectionTitle}" FontSize="9"/>
                        </VerticalStackLayout>
                        <BoxView Grid.Column="0" WidthRequest="1" Color="{StaticResource Line}" HorizontalOptions="End"/>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding BusinessName}" Style="{StaticResource lbl15_Bold_TextDark}"/>
                            <Label Style="{StaticResource lbl12_Regular_TextLight}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding TimeText}"/>
                                        <Span Text=" · "/>
                                        <Span Text="{Binding ServiceName}"/>
                                        <Span Text=" with "/>
                                        <Span Text="{Binding OperatorName}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End">
                            <Border StrokeThickness="0" Padding="8,4" HorizontalOptions="End">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Border.BackgroundColor>
                                    <Binding Path="Status" Converter="{StaticResource EqualsToColorConverter}"
                                             ConverterParameter="pending|#26A45EFF|#2139FF7A"/>
                                </Border.BackgroundColor>
                                <Label Text="{Binding StatusLabel}" FontFamily="RobotoBold" FontSize="10">
                                    <Label.TextColor>
                                        <Binding Path="Status" Converter="{StaticResource EqualsToColorConverter}"
                                                 ConverterParameter="pending|#A45EFF|#39FF7A"/>
                                    </Label.TextColor>
                                </Label>
                            </Border>
                            <controls:AlzowLoadingButton
                                    Text="Cancel"
                                    LoadingText="Cancelling…"
                                    IsVisible="{Binding IsCancellable}"
                                    Command="{Binding BindingContext.CancelCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}"
                                    IsLoading="{Binding IsCancelling}"
                                    ButtonStyle="{StaticResource TertiaryButtonStyle}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>

</ContentView>
