<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.CategoryPicker.Helpers.LocationBarView">

    <!-- Tap to (re)resolve the customer's device location — the Mr-Delivery-style "deliver to"
         bar. Falls back to whatever LocationLabel is bound to (the fixed suburb, by default)
         when GPS/permission isn't available; see ILocationService. -->
    <HorizontalStackLayout Spacing="5">
        <HorizontalStackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding RefreshCommand, Source={x:Reference Root}}"/>
        </HorizontalStackLayout.GestureRecognizers>

        <Label Text="📍" FontSize="11" VerticalOptions="Center"/>
        <Label Text="{Binding LocationLabel, Source={x:Reference Root}}"
               Style="{StaticResource lbl12_Regular_TextLight}"
               VerticalOptions="Center"/>
        <Label Text="⌄" FontSize="11" TextColor="{StaticResource TextMuted}"
               VerticalOptions="Center"
               IsVisible="{Binding IsResolving, Source={x:Reference Root}, Converter={StaticResource InvertedBoolConverter}}"/>
        <ActivityIndicator IsRunning="{Binding IsResolving, Source={x:Reference Root}}"
                            IsVisible="{Binding IsResolving, Source={x:Reference Root}}"
                            Color="{StaticResource TextMuted}"
                            WidthRequest="12" HeightRequest="12"
                            VerticalOptions="Center"/>
    </HorizontalStackLayout>

</ContentView>
