<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:businessModels="clr-namespace:QueueApp.Services.Api.Business.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.CategoryPicker.Helpers.BrowseBusinessListView">

    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="businessModels:BrowseBusinessSummaryResponse">
                <!-- Padding, margin, height floor and column spacing come from the Card styles,
                     which SkeletonCardView reads too. -->
                <Border Style="{StaticResource brd16_BrowseCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding OpenCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" Style="{StaticResource grid_BrowseCard}">
                        <Border Grid.Column="0"
                                WidthRequest="{StaticResource dim_CardIcon}"
                                HeightRequest="{StaticResource dim_CardIcon}"
                                StrokeThickness="1"
                                Padding="0"
                                VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.BackgroundColor>
                                <Binding Path="WaitBucket"
                                         Converter="{StaticResource WaitBucketToTintConverter}"/>
                            </Border.BackgroundColor>
                            <Border.Stroke>
                                <Binding Path="WaitBucket"
                                         Converter="{StaticResource WaitBucketToStrokeConverter}"/>
                            </Border.Stroke>
                            <Image Source="{Binding CategoryIcon}"
                                   WidthRequest="26" HeightRequest="26"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Style="{StaticResource vsl_RowText}" VerticalOptions="Start">
                            <Label Text="{Binding Name}"
                                   Style="{StaticResource lbl15_Bold_TextDark}"
                                   LineBreakMode="TailTruncation"/>

                            <Label Text="{Binding MetaText}" Style="{StaticResource lbl12_Regular_TextLight}"/>

                            <ProgressBar Progress="{Binding WaitFraction}"
                                         HeightRequest="3"
                                         Margin="0,2,0,0"
                                         Style="{StaticResource pb_WaitTrack}"
                                         IsVisible="{Binding AvgWaitMinutes, Converter={StaticResource IsNotNullConverter}}">
                                <ProgressBar.ProgressColor>
                                    <Binding Path="WaitBucket"
                                             Converter="{StaticResource WaitBucketToBarConverter}"/>
                                </ProgressBar.ProgressColor>
                            </ProgressBar>

                            <Label Text="{Binding SubText}"
                                   Style="{StaticResource lbl11_Regular_TextMuted}"
                                   Margin="0,1,0,0"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>

</ContentView>
