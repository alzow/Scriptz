<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.CategoryPicker"
             x:Name="Root"
             x:Class="QueueApp.Features.CategoryPicker.Helpers.CategoryCarouselView">

    <CollectionView ItemsSource="{Binding Categories, Source={x:Reference Root}}"
                     HeightRequest="94"
                     ItemsUpdatingScrollMode="KeepScrollOffset">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="14" SnapPointsType="None"/>
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:ServiceCategory">
                <VerticalStackLayout Spacing="8" WidthRequest="64"
                                      Opacity="{Binding Available, Converter={StaticResource BoolToOpacityConverter}}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding BindingContext.SelectCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding .}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Border WidthRequest="62" HeightRequest="62"
                            BackgroundColor="{StaticResource SurfaceRaised}"
                            StrokeThickness="1.5"
                            StrokeShape="Ellipse"
                            Padding="0">
                        <Border.Stroke>
                            <MultiBinding Converter="{StaticResource ItemEqualsSelectedToColorConverter}"
                                          ConverterParameter="#39FF7A|#343D4D">
                                <Binding Path="."/>
                                <Binding Path="BindingContext.SelectedCategory" Source="{x:Reference Root}"/>
                            </MultiBinding>
                        </Border.Stroke>
                        <Label Text="{Binding Icon}" Style="{StaticResource lbl26_Regular_Emoji}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="{Binding Display}" Style="{StaticResource lbl11_Bold_TextMid}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentView>
