<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QueueApp.Features.Welcome.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.Welcome.Helpers.WelcomeDotsView">

    <HorizontalStackLayout Spacing="6"
                           HorizontalOptions="Start"
                           BindableLayout.ItemsSource="{Binding Panels, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:WelcomePanel">
                <Border Style="{StaticResource brd_WelcomeDot}"/>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </HorizontalStackLayout>

</ContentView>
