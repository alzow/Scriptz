<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.Welcome.Helpers.WelcomeBrandBarView">

    <HorizontalStackLayout Spacing="9" Padding="24,22,24,0">

        <Label Text="{Binding BrandText, Source={x:Reference Root}}"
               Style="{StaticResource lbl19_Bold_Wordmark}"
               VerticalOptions="End"/>

        <Label Text="{Binding EyebrowText, Source={x:Reference Root}}"
               Style="{StaticResource lbl11_Mono_Wordmark}"
               VerticalOptions="End"
               IsVisible="{Binding EyebrowText, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>

    </HorizontalStackLayout>

</ContentView>
