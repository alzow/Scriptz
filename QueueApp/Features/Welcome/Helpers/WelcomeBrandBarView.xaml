<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.Welcome.Helpers.WelcomeBrandBarView">

    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="24,18,24,10">

        <Border Grid.Column="0"
                Style="{StaticResource brd14_Orange}"
                WidthRequest="34" HeightRequest="34"
                VerticalOptions="Center">
            <Image Source="logo_monogram_reversed"
                   WidthRequest="19" HeightRequest="19"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>

        <Label Grid.Column="1"
               Text="{Binding BrandText, Source={x:Reference Root}}"
               Style="{StaticResource lbl20_Bold_Wordmark}"
               VerticalOptions="Center"/>

        <Label Grid.Column="2"
               Text="{Binding EyebrowText, Source={x:Reference Root}}"
               Style="{StaticResource lbl11_Mono_TextFaint}"
               VerticalOptions="Center"
               IsVisible="{Binding EyebrowText, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>

    </Grid>

</ContentView>
