<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.Welcome.Helpers.WelcomeCtaBlockView">

    <VerticalStackLayout Spacing="10" Padding="24,16,24,22">

        <Button Text="{Binding PrimaryText, Source={x:Reference Root}}"
                Command="{Binding PrimaryCommand, Source={x:Reference Root}}"
                Style="{StaticResource btn17_Bold_WelcomePrimary}"/>

        <Button Text="{Binding SecondaryText, Source={x:Reference Root}}"
                Command="{Binding SecondaryCommand, Source={x:Reference Root}}"
                Style="{StaticResource btn15_Bold_WelcomeSecondary}"/>

        <Label Text="{Binding FootnoteText, Source={x:Reference Root}}"
               Style="{StaticResource lbl12_Regular_CtaFootnote}"
               HorizontalOptions="Center"
               Margin="0,4,0,0"/>

    </VerticalStackLayout>

</ContentView>
