<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.Welcome.Helpers.WelcomePanelView">

    <Grid RowDefinitions="*,Auto" Padding="24,2,24,0">

        <Border Grid.Row="0"
                Style="{StaticResource brd20_WelcomeArt}"
                Padding="20,16">
            <Image Source="{Binding IllustrationSource, Source={x:Reference Root}}"
                   Aspect="AspectFit"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"/>
        </Border>

        <VerticalStackLayout Grid.Row="1" Spacing="9" Margin="0,22,0,0">
            <Label Text="{Binding NumberText, Source={x:Reference Root}}"
                   Style="{StaticResource lbl13_Mono_PanelNumber}"/>
            <Label Text="{Binding HeadlineText, Source={x:Reference Root}}"
                   Style="{StaticResource lbl30_Bold_WelcomeHeadline}"/>
            <Label Text="{Binding BodyText, Source={x:Reference Root}}"
                   Style="{StaticResource lbl15_Regular_WelcomeBody}"/>
        </VerticalStackLayout>

    </Grid>

</ContentView>
