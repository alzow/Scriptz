<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QueueApp.Features.BusinessDetail.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessDetail.Helpers.DayStepView">

    <ScrollView IsVisible="{Binding ShowDayStep, Source={x:Reference Root}}">
        <VerticalStackLayout Spacing="0">

            <CollectionView ItemsSource="{Binding DayChoices, Source={x:Reference Root}}" HeightRequest="86" Margin="20,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="9"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DayChoiceItem">
                        <Border WidthRequest="64" Padding="4,11"
                                Opacity="{Binding DayOpacity}"
                                BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Line}" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Green}"/>
                                    <Setter Property="BackgroundColor" Value="{StaticResource GreenSelectedFill}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectDayCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding DayOfWeekText}" HorizontalOptions="Center"
                                       Style="{StaticResource lbl9_Mono_TextMuted}"/>
                                <Label Text="{Binding DayNumberText}" HorizontalOptions="Center"
                                       Style="{StaticResource lbl18_Bold_TextDark}"/>
                                <Label Text="{Binding FreeText}" HorizontalOptions="Center"
                                       LineBreakMode="TailTruncation"
                                       Style="{StaticResource lbl12_Regular_TextLight}" FontSize="9"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsLoadingDays, Source={x:Reference Root}}" IsVisible="{Binding IsLoadingDays, Source={x:Reference Root}}"
                               Color="{StaticResource Green}" Margin="0,12,0,0"/>

            <Border Margin="20,16,20,0" Padding="14,6"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Line}" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,9">
                        <Label Grid.Column="0" Text="Selected" Style="{StaticResource lbl12_Regular_TextLight}"/>
                        <Label Grid.Column="1" Text="{Binding SelectedDay.Date, Source={x:Reference Root}, StringFormat='{0:ddd d MMM}'}"
                               Style="{StaticResource lbl13_Mono_TextPrimary}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,9">
                        <Label Grid.Column="0" Text="{Binding ReviewOperatorLabel, Source={x:Reference Root}}" Style="{StaticResource lbl12_Regular_TextLight}"/>
                        <Label Grid.Column="1" Text="{Binding SelectedOperatorChoice.Name, Source={x:Reference Root}}" Style="{StaticResource lbl13_Mono_TextPrimary}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding DayFineprint, Source={x:Reference Root}}" Margin="20,14,20,20"
                   Style="{StaticResource lbl12_Regular_TextLight}" FontSize="11"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentView>
