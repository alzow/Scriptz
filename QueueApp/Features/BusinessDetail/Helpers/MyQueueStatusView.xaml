<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessDetail.Helpers.MyQueueStatusView">

    <VerticalStackLayout Spacing="12">

        <!-- Being served right now — replaces position/wait entirely, not just hides them -->
        <Label Style="{StaticResource lbl18_Bold_TextDark}" IsVisible="{Binding IsBeingServed, Source={x:Reference Root}}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="You're being served by "/>
                    <Span Text="{Binding MyStatus.OperatorName, Source={x:Reference Root}}"/>
                    <Span Text=" now"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!-- Still waiting — the position/wait estimate as before -->
        <VerticalStackLayout IsVisible="{Binding IsBeingServed, Source={x:Reference Root}, Converter={StaticResource InvertedBoolConverter}}">
            <Label Style="{StaticResource lbl18_Bold_TextDark}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="You're #"/>
                        <Span Text="{Binding MyStatus.Position, Source={x:Reference Root}}"/>
                        <Span Text=" for "/>
                        <Span Text="{Binding MyStatus.OperatorName, Source={x:Reference Root}}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Style="{StaticResource lbl14_Regular_TextDark}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="~"/>
                        <Span Text="{Binding MyWaitMinutes, Source={x:Reference Root}}"/>
                        <Span Text=" min estimated wait"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>

        <controls:AlzowLoadingButton
            Text="Leave queue"
            LoadingText="Leaving…"
            Command="{Binding LeaveCommand, Source={x:Reference Root}}"
            IsLoading="{Binding IsLeaving, Source={x:Reference Root}}"
            IsVisible="{Binding IsBeingServed, Source={x:Reference Root}, Converter={StaticResource InvertedBoolConverter}}"
            ButtonStyle="{StaticResource DangerButtonStyle}"/>
    </VerticalStackLayout>

</ContentView>
