<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             VerticalOptions="Start"
             x:Class="QueueApp.Features.BusinessDetail.Helpers.LiveCardView">

    <Border x:Name="LiveCardBorder" Margin="20,18,20,0" Padding="15"
            BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource Line}" StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="18"/>
        </Border.StrokeShape>
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsBookingMode, Source={x:Reference Root}}" Value="True">
                <Setter Property="Stroke" Value="{StaticResource PurpleDim}"/>
            </DataTrigger>
        </Border.Triggers>

        <VerticalStackLayout Spacing="0">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding LiveCardTitle, Source={x:Reference Root}}"
                       Style="{StaticResource lbl9_Mono_TextMuted}" VerticalOptions="Center"/>
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <Ellipse WidthRequest="6" HeightRequest="6" VerticalOptions="Center"
                             Fill="{StaticResource Green}"
                             IsVisible="{Binding ShowLiveDot, Source={x:Reference Root}}"/>
                    <Label Text="{Binding LiveCardStatus, Source={x:Reference Root}}" Style="{StaticResource lbl10_Mono_Green}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsBookingMode, Source={x:Reference Root}}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Purple}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsOpen, Source={x:Reference Root}}" Value="False">
                                <Setter Property="TextColor" Value="{StaticResource TextFaint}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,1,*,1,*" Margin="0,14,0,15">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Label Text="{Binding PrimaryStatValue, Source={x:Reference Root}}" HorizontalOptions="Center"
                           Style="{StaticResource lbl22_Mono_TextPrimary}"/>
                    <Label Text="{Binding PrimaryStatLabel, Source={x:Reference Root}}" HorizontalOptions="Center"
                           Style="{StaticResource lbl12_Regular_TextLight}"/>
                </VerticalStackLayout>
                <BoxView Grid.Column="1" WidthRequest="1" HeightRequest="30"
                         BackgroundColor="{StaticResource Line}" VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="2" Spacing="6">
                    <Label Text="{Binding SecondaryStatValue, Source={x:Reference Root}}" HorizontalOptions="Center"
                           Style="{StaticResource lbl22_Mono_TextPrimary}"/>
                    <Label Text="{Binding SecondaryStatLabel, Source={x:Reference Root}}" HorizontalOptions="Center"
                           Style="{StaticResource lbl12_Regular_TextLight}"/>
                </VerticalStackLayout>
                <BoxView Grid.Column="3" WidthRequest="1" HeightRequest="30"
                         BackgroundColor="{StaticResource Line}" VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="4" Spacing="6">
                    <Label Text="{Binding TertiaryStatValue, Source={x:Reference Root}}" HorizontalOptions="Center"
                           Style="{StaticResource lbl22_Mono_TextPrimary}"/>
                    <Label Text="{Binding TertiaryStatLabel, Source={x:Reference Root}}" HorizontalOptions="Center"
                           Style="{StaticResource lbl12_Regular_TextLight}"/>
                </VerticalStackLayout>
            </Grid>

            <Button Text="{Binding CtaText, Source={x:Reference Root}}"
                    Command="{Binding StartFlowCommand, Source={x:Reference Root}}"
                    IsEnabled="{Binding IsCtaEnabled, Source={x:Reference Root}}"
                    HeightRequest="48"
                    Style="{StaticResource PrimaryButtonStyle}"/>

            <Label Text="{Binding LiveFootnote, Source={x:Reference Root}}" HorizontalOptions="Center"
                   Margin="0,11,0,0"
                   Style="{StaticResource lbl9_Mono_TextMuted}"/>
        </VerticalStackLayout>
    </Border>

</ContentView>
