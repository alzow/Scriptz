<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessDetail.Helpers.DatePickerSectionView">

    <!-- Horizontal scroller, next 14 days -->
    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSectionVisible, Source={x:Reference Root}}">
        <Label Text="When?" Style="{StaticResource lbl18_Bold_TextDark}"/>
        <CollectionView ItemsSource="{Binding DateOptions, Source={x:Reference Root}}"
                        HeightRequest="64">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="sys:DateTime">
                    <Border Padding="10" Stroke="{StaticResource Line}" StrokeThickness="1.5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.BackgroundColor>
                            <MultiBinding Converter="{StaticResource ItemEqualsSelectedToColorConverter}" ConverterParameter="#A45EFF|#1C222D">
                                <Binding Path="." />
                                <Binding Path="SelectedDate" Source="{x:Reference Root}" />
                            </MultiBinding>
                        </Border.BackgroundColor>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label Text="{Binding ., StringFormat='{0:ddd}'}" Style="{StaticResource lbl14_Regular_TextDark}" HorizontalOptions="Center">
                                <Label.TextColor>
                                    <MultiBinding Converter="{StaticResource ItemEqualsSelectedToColorConverter}" ConverterParameter="#FFFFFF|#8A8F98">
                                        <Binding Path="." />
                                        <Binding Path="SelectedDate" Source="{x:Reference Root}" />
                                    </MultiBinding>
                                </Label.TextColor>
                            </Label>
                            <Label Text="{Binding ., StringFormat='{0:d}'}" Style="{StaticResource lbl15_Bold_TextDark}" HorizontalOptions="Center">
                                <Label.TextColor>
                                    <MultiBinding Converter="{StaticResource ItemEqualsSelectedToColorConverter}" ConverterParameter="#FFFFFF|#F2F4F7">
                                        <Binding Path="." />
                                        <Binding Path="SelectedDate" Source="{x:Reference Root}" />
                                    </MultiBinding>
                                </Label.TextColor>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentView>
