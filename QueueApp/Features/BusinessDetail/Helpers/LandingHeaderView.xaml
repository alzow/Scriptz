<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             VerticalOptions="Start"
             x:Class="QueueApp.Features.BusinessDetail.Helpers.LandingHeaderView">

    <VerticalStackLayout Spacing="0">

        <HorizontalStackLayout Spacing="6" Padding="20,12,20,16">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoBackCommand, Source={x:Reference Root}}"/>
            </HorizontalStackLayout.GestureRecognizers>
            <Image Source="ic_chevron_left" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
            <Label Text="Back" Style="{StaticResource lbl13_Regular_TextMid}" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="20,0">
            <Label Grid.Column="0" Text="{Binding BusinessName, Source={x:Reference Root}}"
                   Style="{StaticResource lbl24_Bold_TextDark}"/>
            <Border Grid.Column="1" Padding="9,5" VerticalOptions="Start"
                    Style="{StaticResource brd8_OpenPill}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsOpen, Source={x:Reference Root}}" Value="True">
                        <Setter Property="Style" Value="{StaticResource brd8_OpenPill}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsOpen, Source={x:Reference Root}}" Value="False">
                        <Setter Property="Style" Value="{StaticResource brd8_ClosedPill}"/>
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding OpenPillText, Source={x:Reference Root}}"
                       Style="{StaticResource lbl10_Mono_Open}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsOpen, Source={x:Reference Root}}" Value="True">
                            <Setter Property="Style" Value="{StaticResource lbl10_Mono_Open}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsOpen, Source={x:Reference Root}}" Value="False">
                            <Setter Property="Style" Value="{StaticResource lbl10_Mono_Closed}"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </Grid>

        <Label Text="{Binding AddressLine, Source={x:Reference Root}}" Style="{StaticResource lbl13_Regular_TextMid}"
               Padding="20,7,20,0"/>

        <Label Text="{Binding ModeLine, Source={x:Reference Root}}" Style="{StaticResource lbl10_Mono_TextFaint}"
               Padding="20,12,20,16"/>
        <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}" Margin="20,0"/>

    </VerticalStackLayout>

</ContentView>
