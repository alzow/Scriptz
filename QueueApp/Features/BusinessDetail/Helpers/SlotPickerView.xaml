<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:bookingModels="clr-namespace:QueueApp.Services.Api.Booking.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessDetail.Helpers.SlotPickerView">

    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSectionVisible, Source={x:Reference Root}}">
        <Label Text="Pick a time" Style="{StaticResource lbl18_Bold_TextDark}"/>
        <ActivityIndicator IsRunning="{Binding IsLoading, Source={x:Reference Root}}"
                            IsVisible="{Binding IsLoading, Source={x:Reference Root}}"
                            Color="{StaticResource Orange}"/>
        <Label Text="No times available this day." IsVisible="{Binding IsEmpty, Source={x:Reference Root}}"
               Style="{StaticResource lbl14_Regular_TextDark}"/>
        <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding Slots, Source={x:Reference Root}}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="bookingModels:SlotResponse">
                    <Border Style="{StaticResource brd16_White}" Padding="10" Margin="4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding TimeDisplay}" Style="{StaticResource lbl15_Bold_TextDark}" HorizontalOptions="Center"/>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>
    </VerticalStackLayout>

</ContentView>
