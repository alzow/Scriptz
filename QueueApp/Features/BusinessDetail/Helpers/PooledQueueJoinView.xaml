<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessDetail.Helpers.PooledQueueJoinView">

    <!-- Shown instead of the per-operator list on businesses where the system assigns the
         resource (e.g. a car wash bay) rather than the customer picking one — one combined
         figure and a single Join button. -->
    <VerticalStackLayout Spacing="10">
        <Label Text="Live queue" Style="{StaticResource lbl18_Bold_TextDark}"/>
        <Grid ColumnDefinitions="*,Auto" Padding="0,6">
            <VerticalStackLayout Grid.Column="0">
                <Label Style="{StaticResource lbl16_Regular_TextDark}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding WaitingCount, Source={x:Reference Root}}"/>
                            <Span Text=" ahead"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Style="{StaticResource lbl14_Regular_TextDark}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="~"/>
                            <Span Text="{Binding WaitMinutes, Source={x:Reference Root}}"/>
                            <Span Text=" min estimated wait"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
            <controls:AlzowLoadingButton
                Grid.Column="1"
                Text="Join"
                LoadingText="Joining…"
                Command="{Binding JoinCommand, Source={x:Reference Root}}"
                IsLoading="{Binding IsJoining, Source={x:Reference Root}}"
                ButtonStyle="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
    </VerticalStackLayout>

</ContentView>
