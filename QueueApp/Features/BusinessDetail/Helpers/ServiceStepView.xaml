<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QueueApp.Shared.Domain.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessDetail.Helpers.ServiceStepView">

    <CollectionView ItemsSource="{Binding ServiceRows, Source={x:Reference Root}}"
                    IsVisible="{Binding ShowServiceStep, Source={x:Reference Root}}"
                    Margin="20,0,20,0">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:ServiceChoiceItem">
                <Border Padding="12" Margin="0,0,0,8"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Line}" StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Green}"/>
                            <Setter Property="BackgroundColor" Value="{StaticResource GreenSelectedFill}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectServiceCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding Name}" Style="{StaticResource lbl14_Bold_TextDark}"/>
                            <Label Text="{Binding DurationText}" Style="{StaticResource lbl12_Regular_TextLight}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding PriceText}" VerticalOptions="Center"
                               Style="{StaticResource lbl13_Mono_TextPrimary}"/>
                        <Border Grid.Column="2" WidthRequest="22" HeightRequest="22" Padding="0"
                                BackgroundColor="Transparent"
                                Stroke="{StaticResource Line}" StrokeThickness="1"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="11"/>
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Green}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Image Source="ic_check" WidthRequest="12" HeightRequest="12"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding IsSelected}"/>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentView>
