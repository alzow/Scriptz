<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:bookingModels="clr-namespace:QueueApp.Services.Api.Booking.Models"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessDetail.Helpers.BookingHistoryStripView">

    <VerticalStackLayout Spacing="8">
        <Label Text="Your bookings" Style="{StaticResource lbl18_Bold_TextDark}"/>
        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Bookings, Source={x:Reference Root}}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="bookingModels:MyBookingSummaryResponse">
                    <Border Style="{StaticResource brd16_White}" Padding="14" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding DateTimeDisplay}" Style="{StaticResource lbl15_Bold_TextDark}"/>
                                <Label Style="{StaticResource lbl14_Regular_TextDark}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding ServiceName}"/>
                                            <Span Text=" · "/>
                                            <Span Text="{Binding OperatorName}"/>
                                            <Span Text=" · "/>
                                            <Span Text="{Binding StatusLabel}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <controls:AlzowLoadingButton Grid.Column="1"
                                    Text="Cancel"
                                    IsVisible="{Binding IsCancellable}"
                                    Command="{Binding CancelCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}"
                                    IsLoading="{Binding IsCancelling}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>

</ContentView>
