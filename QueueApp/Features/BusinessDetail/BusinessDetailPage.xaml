<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.BusinessDetail"
             xmlns:bdHelpers="clr-namespace:QueueApp.Features.BusinessDetail.Helpers"
             xmlns:topbar="clr-namespace:QueueApp.Shared.Templates.TopBar"
             x:Class="QueueApp.Features.BusinessDetail.BusinessDetailPage"
             x:DataType="vm:BusinessDetailPageViewModel"
             Title="{Binding BusinessName}"
             BackgroundColor="{StaticResource DeepBackground}"
             Style="{StaticResource NavigationPageStyle}">

    <Grid RowDefinitions="Auto,*">

        <!-- ================= TOP BAR — flow and confirmation only ================= -->
        <topbar:TopBarView Grid.Row="0"
                IsVisible="False"
                BusinessName="{Binding BusinessName}"
                GoBackCommand="{Binding GoBackCommand}"/>

        <!-- ========================================================================
             LANDING
             ======================================================================== -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">

            <bdHelpers:LandingHeaderView Grid.Row="0"
                    BusinessName="{Binding BusinessName}"
                    IsOpen="{Binding IsOpen}"
                    OpenPillText="{Binding OpenPillText}"
                    AddressLine="{Binding AddressLine}"
                    ModeLine="{Binding ModeLine}"
                    GoBackCommand="{Binding GoBackCommand}"/>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="0" Padding="0,0,0,24">

                    <bdHelpers:LiveCardView
                            IsBookingMode="{Binding IsBookingMode}"
                            IsOpen="{Binding IsOpen}"
                            LiveCardTitle="{Binding LiveCardTitle}"
                            LiveCardStatus="{Binding LiveCardStatus}"
                            ShowLiveDot="{Binding ShowLiveDot}"
                            PrimaryStatValue="{Binding PrimaryStatValue}"
                            PrimaryStatLabel="{Binding PrimaryStatLabel}"
                            SecondaryStatValue="{Binding SecondaryStatValue}"
                            SecondaryStatLabel="{Binding SecondaryStatLabel}"
                            TertiaryStatValue="{Binding TertiaryStatValue}"
                            TertiaryStatLabel="{Binding TertiaryStatLabel}"
                            CtaText="{Binding CtaText}"
                            IsCtaEnabled="{Binding IsCtaEnabled}"
                            LiveFootnote="{Binding LiveFootnote}"
                            StartFlowCommand="{Binding StartFlowCommand}"/>

                    <Border Style="{StaticResource brd14_White}" Margin="18,14,18,0" Padding="14,13"
                            IsVisible="{Binding HasSomethingActive}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding ActiveStripText}"
                                   Style="{StaticResource lbl14_Bold_TextDark}"
                                   VerticalOptions="Center"/>
                            <Image Grid.Column="1" Source="ic_chevron_right"
                                   WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenConfirmationCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <bdHelpers:ServicesListSectionView
                            HasServices="{Binding HasServices}"
                            ServicesCountText="{Binding ServicesCountText}"
                            ServiceRows="{Binding ServiceRows}"
                            ServicesListHeight="{Binding ServicesListHeight}"/>

                    <bdHelpers:TeamSectionView
                            HasTeam="{Binding HasTeam}"
                            TeamSectionTitle="{Binding TeamSectionTitle}"
                            TeamCountText="{Binding TeamCountText}"
                            TeamMembers="{Binding TeamMembers}"/>

                    <bdHelpers:GettingThereSectionView
                            AddressLine="{Binding AddressLine}"
                            DistanceText="{Binding DistanceText}"
                            HasDistance="{Binding HasDistance}"
                            OpenDirectionsCommand="{Binding OpenDirectionsCommand}"/>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Green}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>

    </Grid>

</ContentPage>
