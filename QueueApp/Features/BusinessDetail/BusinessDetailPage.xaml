<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.BusinessDetail"
             xmlns:responses="clr-namespace:QueueApp.Services.Api.Queue.Models"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             x:Class="QueueApp.Features.BusinessDetail.BusinessDetailPage"
             x:DataType="vm:BusinessDetailPageViewModel"
             Title="{Binding Business.Name}"
             Style="{StaticResource NavigationPageStyle}">

    <Grid RowDefinitions="Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                       Title="{Binding Business.Name}"
                                       BackCommand="{Binding GoBackCommand}"/>

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{Binding Business.Name}" Style="{StaticResource lbl24_Bold_TextDark}"/>
            <Label Text="{Binding Business.Address}" Style="{StaticResource lbl13_Regular_TextLight}"/>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsQueueMode}">

                <!-- BROWSING: not in this queue yet -->
                <VerticalStackLayout Spacing="10"
                                      IsVisible="{Binding IsInQueue, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="Live queue" Style="{StaticResource lbl18_Bold_TextDark}"/>
                    <VerticalStackLayout Spacing="0"
                                          BindableLayout.ItemsSource="{Binding QueueSummary}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="responses:QueueSummaryRow">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding OperatorName}"
                                               Style="{StaticResource lbl16_Regular_TextDark}"/>
                                        <Label Style="{StaticResource lbl13_Regular_TextLight}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding WaitingCount}"/>
                                                    <Span Text=" waiting · ~"/>
                                                    <Span Text="{Binding NewJoinWaitMinutes}"/>
                                                    <Span Text=" min"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <controls:AlzowLoadingButton
                                        Grid.Column="1"
                                        Text="Join"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.JoinCommand}"
                                        CommandParameter="{Binding .}"
                                        IsLoading="{Binding IsJoining}"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- IN QUEUE: show position, not the summary list -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsInQueue}">

                    <!-- Being served right now — replaces position/wait entirely, not just hides them -->
                    <Label Style="{StaticResource lbl18_Bold_TextDark}" IsVisible="{Binding IsBeingServed}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="You're being served by "/>
                                <Span Text="{Binding MyStatus.OperatorName}"/>
                                <Span Text=" now"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Still waiting — the position/wait estimate as before -->
                    <VerticalStackLayout IsVisible="{Binding IsBeingServed, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Style="{StaticResource lbl18_Bold_TextDark}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="You're #"/>
                                    <Span Text="{Binding MyStatus.Position}"/>
                                    <Span Text=" for "/>
                                    <Span Text="{Binding MyStatus.OperatorName}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Style="{StaticResource lbl13_Regular_TextLight}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="~"/>
                                    <Span Text="{Binding MyWaitMinutes}"/>
                                    <Span Text=" min estimated wait"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>

                    <controls:AlzowLoadingButton
                        Text="Leave queue"
                        Command="{Binding LeaveCommand}"
                        IsLoading="{Binding IsLeaving}"
                        IsVisible="{Binding IsBeingServed, Converter={StaticResource InvertedBoolConverter}}"/>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsBookingMode}">
                <Label Text="Booking" Style="{StaticResource lbl18_Bold_TextDark}"/>
                <Label Text="Online booking for this business is coming soon."
                       Style="{StaticResource lbl13_Regular_TextLight}"/>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>

        </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
