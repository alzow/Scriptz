<?xml version="1.0" encoding="utf-8" ?>
<bottomsheet:BottomSheetPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:sheets="clr-namespace:QueueApp.Features.OperatorQueue.Sheets"
                        xmlns:bottomsheet="clr-namespace:QueueApp.Shared.Templates.BottomSheet"
                        xmlns:models="clr-namespace:QueueApp.Features.OperatorQueue.Models"
                        x:Name="Root"
                        x:Class="QueueApp.Features.OperatorQueue.Sheets.AssignSheet"
                        x:DataType="sheets:AssignSheet">

    <Border VerticalOptions="End"
            Style="{StaticResource brd22_Sheet}" Padding="16,10,16,26">
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <Border Style="{StaticResource brd2_Grabber}"
                        WidthRequest="38" HeightRequest="4" Margin="0,0,0,16"
                        HorizontalOptions="Center"/>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,0,0,14">
                    <Border Grid.Column="0" WidthRequest="48" HeightRequest="48"
                            Style="{StaticResource brd_Avatar_Purple}">
                        <Label Text="{Binding Initials, Source={x:Reference Root}}"
                               Style="{StaticResource lbl12_Mono_Purple}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding CustomerName, Source={x:Reference Root}}"
                               Style="{StaticResource lbl16_Bold_TextDark}"/>
                        <Label Text="{Binding SubText, Source={x:Reference Root}}"
                               Style="{StaticResource lbl11_Regular_TextLight}"/>
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}" Margin="0,0,0,14"/>

                <Label Text="{Binding PromptText, Source={x:Reference Root}}"
                       Style="{StaticResource lbl9_Mono_TextMuted}"
                       Margin="0,0,0,10"/>

                <VerticalStackLayout Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Targets, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:AssignTargetItem">
                            <Border Style="{StaticResource brd13_Raised}"
                                    Padding="11" Margin="0,0,0,9"
                                    MinimumHeightRequest="66">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Grid Grid.Column="0" VerticalOptions="Center">
                                        <Border WidthRequest="40" HeightRequest="40"
                                                Style="{StaticResource brd_Avatar_Ellipse}">
                                            <Label Text="{Binding Initials}"
                                                   Style="{StaticResource lbl12_Mono_TextPrimary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Ellipse Style="{StaticResource ell_AccentDot_OnRaised}"
                                                 WidthRequest="11" HeightRequest="11"
                                                 IsVisible="{Binding ShowPresenceDot}"
                                                 HorizontalOptions="End" VerticalOptions="End"/>
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource lbl16_Bold_TextDark}"
                                               TextColor="{Binding NameColor}"/>
                                        <Label Text="{Binding SubLabel}" Style="{StaticResource lbl11_Regular_TextLight}"
                                               TextColor="{Binding SubLabelColor}"/>
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2" IsVisible="{Binding ShowSoonestTag}"
                                            Style="{StaticResource brd6_AccentTag}"
                                            Padding="8,5" VerticalOptions="Center">
                                        <Label Text="SOONEST" Style="{StaticResource lbl9_Mono_Green}"/>
                                    </Border>
                                </Grid>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding PickCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}" Margin="0,16,0,4"
                         IsVisible="{Binding ShowNoShow, Source={x:Reference Root}}"/>

                <Button Text="Mark no-show" Margin="0,9,0,0"
                        Style="{StaticResource btn15_Regular_SheetBad}"
                        IsVisible="{Binding ShowNoShow, Source={x:Reference Root}}"
                        Clicked="OnNoShowClicked"/>

            </VerticalStackLayout>
        </ScrollView>
    </Border>

</bottomsheet:BottomSheetPage>
