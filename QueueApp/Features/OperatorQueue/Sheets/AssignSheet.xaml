<?xml version="1.0" encoding="utf-8" ?>
<popups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:popups="clr-namespace:MPowerKit.Popups;assembly=MPowerKit.Popups"
                  xmlns:sheets="clr-namespace:QueueApp.Features.OperatorQueue.Sheets"
                  xmlns:models="clr-namespace:QueueApp.Features.OperatorQueue.Models"
                  x:Name="Root"
                  x:Class="QueueApp.Features.OperatorQueue.Sheets.AssignSheet"
                  x:DataType="sheets:AssignSheet"
                  CloseOnBackgroundClick="True"
                  BackgroundColor="#B80A0D12">

    <!--
        The sheet is capped at 88% of the screen and hugs its content below that, so a long list
        scrolls inside the sheet rather than pushing its own header off the top.
    -->
    <Grid RowDefinitions="0.12*,0.88*">
        <Border Grid.Row="1" VerticalOptions="End"
                Style="{StaticResource brd22_Sheet}" Padding="16,10,16,26">
            <ScrollView>
                <VerticalStackLayout Spacing="0">

                    <Border BackgroundColor="{StaticResource Line}" StrokeThickness="0"
                            WidthRequest="38" HeightRequest="4" Margin="0,0,0,16"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="2"/>
                        </Border.StrokeShape>
                    </Border>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,0,0,14">
                        <Border Grid.Column="0" WidthRequest="48" HeightRequest="48"
                                BackgroundColor="{StaticResource SurfaceRaised}"
                                Stroke="{StaticResource PurpleDim}" StrokeThickness="1"
                                StrokeShape="Ellipse">
                            <Label Text="{Binding Initials, Source={x:Reference Root}}"
                                   Style="{StaticResource lbl12_Mono_TextPrimary}"
                                   TextColor="{StaticResource Purple}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding CustomerName, Source={x:Reference Root}}"
                                   Style="{StaticResource lbl16_Bold_TextDark}"/>
                            <Label Text="{Binding SubText, Source={x:Reference Root}}"
                                   Style="{StaticResource lbl11_Regular_TextLight}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,0,0,14"/>

                    <!--
                        The sheet asks rather than offering "take it myself": with a shared counter
                        phone the app cannot know whose hands are on it. Assigning is also not
                        serving — it sets operator_id and stops there.
                    -->
                    <Label Text="{Binding PromptText, Source={x:Reference Root}}"
                           Style="{StaticResource lbl9_Mono_TextMuted}"
                           Margin="0,0,0,10"/>

                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding Targets, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AssignTargetItem">
                                <Border Style="{StaticResource brd13_Raised}"
                                        Padding="11" Margin="0,0,0,9"
                                        MinimumHeightRequest="66"
                                        Opacity="{Binding RowOpacity}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <!-- Dot outside the border: a Border clips to its shape. -->
                                        <Grid Grid.Column="0" VerticalOptions="Center">
                                            <Border WidthRequest="40" HeightRequest="40" Padding="0"
                                                    BackgroundColor="{StaticResource SurfaceRaised}"
                                                    Stroke="{StaticResource Line}" StrokeThickness="1"
                                                    StrokeShape="Ellipse">
                                                <Label Text="{Binding Initials}"
                                                       Style="{StaticResource lbl12_Mono_TextPrimary}"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <Ellipse Fill="{StaticResource Green}"
                                                     WidthRequest="11" HeightRequest="11"
                                                     Stroke="{StaticResource SurfaceRaised}"
                                                     StrokeThickness="2.5"
                                                     IsVisible="{Binding ShowPresenceDot}"
                                                     HorizontalOptions="End" VerticalOptions="End"/>
                                        </Grid>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource lbl16_Bold_TextDark}"/>
                                            <Label Text="{Binding SubLabel}" Style="{StaticResource lbl11_Regular_TextLight}"/>
                                        </VerticalStackLayout>

                                        <Border Grid.Column="2" IsVisible="{Binding ShowSoonestTag}"
                                                BackgroundColor="#2139FF7A" StrokeThickness="0"
                                                Padding="8,5" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="SOONEST" Style="{StaticResource lbl9_Mono_Green}"/>
                                        </Border>
                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding PickCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,16,0,4"
                             IsVisible="{Binding ShowNoShow, Source={x:Reference Root}}"/>

                    <Button Text="Mark no-show" Margin="0,9,0,0"
                            Style="{StaticResource btn15_Regular_SheetBad}"
                            IsVisible="{Binding ShowNoShow, Source={x:Reference Root}}"
                            Clicked="OnNoShowClicked"/>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

</popups:PopupPage>
