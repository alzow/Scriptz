<?xml version="1.0" encoding="utf-8" ?>
<bottomsheet:BottomSheetPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:sheets="clr-namespace:QueueApp.Features.OperatorQueue.Sheets"
                        xmlns:bottomsheet="clr-namespace:QueueApp.Shared.Templates.BottomSheet"
                        xmlns:models="clr-namespace:QueueApp.Features.OperatorQueue.Models"
                        xmlns:queueEntry="clr-namespace:QueueApp.Shared.Templates.QueueEntry"
                        x:Name="Root"
                        x:Class="QueueApp.Features.OperatorQueue.Sheets.AddWalkInSheet"
                        x:DataType="sheets:AddWalkInSheet">

    <Border VerticalOptions="End"
            Style="{StaticResource brd22_Sheet}" Padding="16,10,16,26">
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <Border Style="{StaticResource brd2_Grabber}"
                        WidthRequest="38" HeightRequest="4" Margin="0,0,0,16"
                        HorizontalOptions="Center"/>

                <Label Text="{Binding TitleText, Source={x:Reference Root}}"
                       Style="{StaticResource lbl18_Bold_TextDark}"/>

                <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}" Margin="0,14"/>

                <queueEntry:QueueEntry Text="{Binding CustomerName, Source={x:Reference Root}, Mode=TwoWay}"
                                       Placeholder="Name (optional)"
                                       MaxLength="60"/>

                <Label Text="What are they in for?"
                       Style="{StaticResource lbl15_Bold_TextDark}"
                       Margin="0,16,0,8"/>

                <Label Text="No active services to add. Add one under Settings first."
                       Style="{StaticResource lbl13_Regular_TextLight}"
                       IsVisible="{Binding IsEmpty, Source={x:Reference Root}}"/>

                <VerticalStackLayout Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Services, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ServiceChoiceRow">
                            <Border Padding="14" Margin="0,0,0,8"
                                    MinimumHeightRequest="56"
                                    BackgroundColor="{Binding FillColor}"
                                    Stroke="{Binding BorderBrush}"
                                    StrokeThickness="1.5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Name}"
                                           VerticalOptions="Center"
                                           TextColor="{Binding NameColor}"
                                           Style="{StaticResource lbl15_Bold_TextDark}"/>
                                    <Label Grid.Column="1" Text="{Binding MetaText}"
                                           VerticalOptions="Center"
                                           Style="{StaticResource lbl13_Regular_TextLight}"/>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource brd13_Raised}" Padding="13" Margin="0,8,0,0"
                        IsVisible="{Binding HasOutcome, Source={x:Reference Root}}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding OutcomePositionText, Source={x:Reference Root}}"
                               Style="{StaticResource lbl15_Bold_TextDark}"/>
                        <Label Text="{Binding OutcomeTurnText, Source={x:Reference Root}}"
                               Style="{StaticResource lbl11_Regular_TextLight}"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="They won't get a notification — give them a rough time out loud."
                       Style="{StaticResource lbl11_Regular_TextLight}"
                       Margin="2,12,2,0"/>

                <Button Text="Add to queue" Margin="0,16,0,0" HeightRequest="56"
                        Style="{StaticResource btn16_Bold_Green}"
                        IsEnabled="{Binding CanAdd, Source={x:Reference Root}}"
                        Clicked="OnAddClicked"/>

            </VerticalStackLayout>
        </ScrollView>
    </Border>

</bottomsheet:BottomSheetPage>
