<?xml version="1.0" encoding="utf-8" ?>
<popups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:popups="clr-namespace:MPowerKit.Popups;assembly=MPowerKit.Popups"
                  xmlns:sheets="clr-namespace:QueueApp.Features.OperatorQueue.Sheets"
                  xmlns:models="clr-namespace:QueueApp.Features.OperatorQueue.Models"
                  x:Name="Root"
                  x:Class="QueueApp.Features.OperatorQueue.Sheets.ChangeServiceSheet"
                  x:DataType="sheets:ChangeServiceSheet"
                  CloseOnBackgroundClick="True"
                  BackgroundColor="#B80A0D12">

    <!--
        The sheet is capped at 88% of the screen and hugs its content below that, so a long list
        scrolls inside the sheet rather than pushing its own header off the top.
    -->
    <Grid RowDefinitions="0.12*,0.88*">
        <Border Grid.Row="1" VerticalOptions="End"
                Style="{StaticResource brd22_Sheet}" Padding="16,10,16,26">
            <ScrollView>
                <VerticalStackLayout Spacing="0">

                    <Border BackgroundColor="{StaticResource Line}" StrokeThickness="0"
                            WidthRequest="38" HeightRequest="4" Margin="0,0,0,16"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="2"/>
                        </Border.StrokeShape>
                    </Border>

                    <Label Text="{Binding TitleText, Source={x:Reference Root}}"
                           Style="{StaticResource lbl18_Bold_TextDark}"/>

                    <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,14"/>

                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding Services, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ServiceChoiceRow">
                                <Border Padding="14" Margin="0,0,0,8"
                                        MinimumHeightRequest="56"
                                        BackgroundColor="{Binding FillColor}"
                                        Stroke="{Binding BorderBrush}"
                                        StrokeThickness="1.5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding Name}"
                                               VerticalOptions="Center"
                                               TextColor="{Binding NameColor}"
                                               Style="{StaticResource lbl15_Bold_TextDark}"/>
                                        <Label Grid.Column="1" Text="{Binding MetaText}"
                                               VerticalOptions="Center"
                                               Style="{StaticResource lbl13_Regular_TextLight}"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

</popups:PopupPage>
