<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.OperatorQueue.Helpers.AvatarView">

    <Grid HorizontalOptions="Start" VerticalOptions="Center">
        <Border BackgroundColor="{StaticResource SurfaceRaised}"
                Stroke="{StaticResource Line}"
                StrokeThickness="1"
                StrokeShape="Ellipse"
                Padding="0"
                WidthRequest="{Binding Size, Source={x:Reference Root}}"
                HeightRequest="{Binding Size, Source={x:Reference Root}}">
            <Label Text="{Binding Initials, Source={x:Reference Root}}"
                   Style="{StaticResource lbl12_Mono_TextPrimary}"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>
        <Ellipse Fill="{StaticResource Green}"
                 Stroke="{StaticResource Surface}"
                 StrokeThickness="2.5"
                 WidthRequest="11" HeightRequest="11"
                 IsVisible="{Binding ShowDot, Source={x:Reference Root}}"
                 HorizontalOptions="End" VerticalOptions="End"/>
    </Grid>

</ContentView>
