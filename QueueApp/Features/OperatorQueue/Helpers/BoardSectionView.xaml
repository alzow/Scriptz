<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             xmlns:models="clr-namespace:QueueApp.Features.OperatorQueue.Models"
             xmlns:helpers="clr-namespace:QueueApp.Features.OperatorQueue.Helpers"
             x:Name="Root"
             VerticalOptions="Start"
             x:DataType="models:BoardSection"
             x:Class="QueueApp.Features.OperatorQueue.Helpers.BoardSectionView">

    <Border Style="{StaticResource brd16_White}"
            Margin="18,12,18,0" Padding="0"
            VerticalOptions="Start">
        <Grid VerticalOptions="Start">

            <VerticalStackLayout Spacing="0" Padding="12" IsVisible="{Binding IsExpanded}">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11" Padding="0,0,0,11">
                    <helpers:AvatarView Grid.Column="0"
                                        Initials="{Binding Initials}"
                                        ShowDot="{Binding IsOnShift}"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding Name}" Style="{StaticResource lbl16_Bold_TextDark}"
                               TextColor="{Binding NameColor}"/>
                        <Label Text="{Binding StatusText}"
                               TextColor="{Binding StatusColor}"
                               Style="{StaticResource lbl12_Regular_TextLight}"/>
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}" Margin="0,0,0,11"/>

                <!-- One tap target, not three nested ones: the card carries what the shop reads at
                     a glance, and everything it can do to the entry lives in the sheet the whole
                     card opens. -->
                <Border Style="{StaticResource brd14_Serving}" Padding="13"
                        IsVisible="{Binding HasServing}">
                    <ContentView BindingContext="{Binding Serving}">
                    <VerticalStackLayout Spacing="0" x:DataType="models:ServingCardItem">

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="0">
                                <Label Text="NOW SERVING" Style="{StaticResource lbl11_Mono_Green}"
                                       Margin="0,0,0,6"/>
                                <Label Text="{Binding CustomerName}" Style="{StaticResource lbl17_Bold_TextDark}"/>
                                <Label Text="{Binding ServiceText}" Style="{StaticResource lbl12_Regular_TextLight}"
                                       Margin="0,4,0,0"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="End">
                                <Label Text="{Binding ElapsedText}" Style="{StaticResource lbl20_Mono_Green}"
                                       HorizontalOptions="End"/>
                                <Label Text="{Binding EstimateText}" Style="{StaticResource lbl11_Mono_TextFaint}"
                                       IsVisible="{Binding HasEstimate}"
                                       HorizontalOptions="End"/>
                            </VerticalStackLayout>

                            <tpl:ThemedIcon Grid.Column="2" Icon="ic_chevron_right"
                                            WidthRequest="16" HeightRequest="16" Opacity="0.5"
                                            VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7"
                              Margin="0,11,0,0"
                              IsVisible="{Binding HasNote}">
                            <tpl:ThemedIcon Grid.Column="0" Icon="ic_edit"
                                            WidthRequest="12" HeightRequest="12"
                                            VerticalOptions="Start" Margin="0,2,0,0"/>
                            <Label Grid.Column="1" Text="{Binding NoteText}"
                                   Style="{StaticResource lbl12_Regular_TextLight}"/>
                        </Grid>

                        <Border Style="{StaticResource brd6_PurpleTag}"
                                Padding="8,4" Margin="0,11,0,0"
                                HorizontalOptions="Start"
                                IsVisible="{Binding HasIntakeAnswers}">
                            <Label Text="{Binding IntakeAnswerCountText}"
                                   Style="{StaticResource lbl11_Mono_Purple}"/>
                        </Border>

                    </VerticalStackLayout>
                    </ContentView>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding OpenServingSheetCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding Serving}"/>
                    </Border.GestureRecognizers>
                </Border>

                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Waiting}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:QueueRowItem">
                            <Border Style="{StaticResource brd13_Raised}"
                                    Padding="10" Margin="0,9,0,0" MinimumHeightRequest="66">
                                <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                    <Border Grid.Column="0" WidthRequest="26" HeightRequest="26"
                                            Style="{StaticResource brd_Surface_Flat}"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding ShowPosition}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding PositionText}"
                                               Style="{StaticResource lbl12_Bold_TextMid}"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding CustomerName}" Style="{StaticResource lbl15_Bold_TextDark}"/>
                                        <Label Text="{Binding SubText}" Style="{StaticResource lbl12_Regular_TextLight}"/>
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                        <Border Style="{StaticResource brd6_PurpleTag}"
                                                Padding="8,4" VerticalOptions="Center"
                                                IsVisible="{Binding HasIntakeAnswers}">
                                            <Label Text="{Binding IntakeAnswerCountText}"
                                                   Style="{StaticResource lbl11_Mono_Purple}"/>
                                        </Border>
                                        <tpl:ThemedIcon Icon="ic_chevron_right"
                                                        WidthRequest="16" HeightRequest="16" Opacity="0.5"
                                                        VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Only there once someone has left word. An empty note line on every
                                     waiting row would cost the board a row's worth of height each. -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7"
                                      Margin="0,9,0,0"
                                      IsVisible="{Binding HasNote}">
                                    <tpl:ThemedIcon Grid.Column="0" Icon="ic_edit"
                                                    WidthRequest="12" HeightRequest="12"
                                                    VerticalOptions="Start" Margin="0,2,0,0"/>
                                    <Label Grid.Column="1" Text="{Binding NoteText}"
                                           Style="{StaticResource lbl12_Regular_TextLight}"/>
                                </Grid>
                                </VerticalStackLayout>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenRowSheetCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource brd13_Ghost}" Padding="14" Margin="0,9,0,0">
                    <Label Text="+ Add walk-in" Style="{StaticResource lbl13_Bold_Green}"
                           HorizontalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding AddToQueueCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11"
                  Padding="12,11" MinimumHeightRequest="62"
                  IsVisible="{Binding IsCollapsed}">
                <helpers:AvatarView Grid.Column="0"
                                    Initials="{Binding Initials}"
                                    ShowDot="{Binding IsOnShift}"/>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="{Binding Name}" Style="{StaticResource lbl16_Bold_TextDark}"/>
                    <Label Text="{Binding StatusText}"
                           TextColor="{Binding StatusColor}"
                           Style="{StaticResource lbl12_Regular_TextLight}"/>
                </VerticalStackLayout>
                <Border Grid.Column="2" WidthRequest="44" HeightRequest="44"
                        Style="{StaticResource brd13_Ghost}" VerticalOptions="Center">
                    <tpl:ThemedIcon Icon="ic_plus" WidthRequest="18" HeightRequest="18"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding AddToQueueCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11"
                  Padding="12,11" MinimumHeightRequest="62"
                  IsVisible="{Binding IsOffShift}">
                <helpers:AvatarView Grid.Column="0"
                                    Initials="{Binding Initials}"/>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="{Binding Name}" Style="{StaticResource lbl16_Bold_TextDark}"/>
                    <Label Text="{Binding StatusText}" Style="{StaticResource lbl12_Regular_TextLight}"/>
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="On shift" HeightRequest="44"
                        Style="{StaticResource btn12_Bold_Neutral}"
                        VerticalOptions="Center"
                        IsEnabled="{Binding IsShiftToggleEnabled}"
                        Command="{Binding ToggleShiftCommand, Source={x:Reference Root}}"
                        CommandParameter="{Binding .}"/>
            </Grid>

        </Grid>
    </Border>

</ContentView>
