<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QueueApp.Features.OperatorQueue.Models"
             x:Name="Root"
             VerticalOptions="Start"
             x:Class="QueueApp.Features.OperatorQueue.Helpers.AwaitingCollectionSectionView">

    <Border Style="{StaticResource brd16_Pool}"
            Margin="18,13,18,0"
            IsVisible="{Binding HasAwaitingCollection, Source={x:Reference Root}}">
        <VerticalStackLayout Spacing="0" Padding="14,13,14,4">

            <Label Text="AWAITING COLLECTION" Style="{StaticResource lbl15_Bold_Purple}"/>

            <VerticalStackLayout Spacing="0" Margin="0,10,0,0"
                                 BindableLayout.ItemsSource="{Binding AwaitingCollectionRows, Source={x:Reference Root}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:QueueRowItem">
                        <Border Style="{StaticResource brd_Surface_Flat}"
                                Padding="12,10" Margin="0,0,0,8" MinimumHeightRequest="62">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="11">
                                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding CustomerName}" Style="{StaticResource lbl14_Bold_TextDark}"/>
                                    <Label Text="{Binding SubText}" Style="{StaticResource lbl12_Regular_TextLight}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Collected" HeightRequest="46"
                                        Style="{StaticResource btn14_Bold_PurpleOutline}"
                                        VerticalOptions="Center"
                                        IsEnabled="{Binding IsEnabled}"
                                        Command="{Binding MarkCollectedCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Border>

</ContentView>
