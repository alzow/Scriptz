<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QueueApp.Features.OperatorQueue.Models"
             x:Name="Root"
             VerticalOptions="Start"
             x:Class="QueueApp.Features.OperatorQueue.Helpers.PoolBannerView">

    <Border Style="{StaticResource brd16_Pool}"
            Stroke="{Binding PoolStroke, Source={x:Reference Root}}"
            StrokeThickness="{Binding PoolStrokeThickness, Source={x:Reference Root}}"
            Margin="18,13,18,0"
            IsVisible="{Binding HasPool, Source={x:Reference Root}}">
        <VerticalStackLayout Spacing="0">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11"
                  Padding="14,13" MinimumHeightRequest="60"
                  BackgroundColor="Transparent">
                <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                        Style="{StaticResource brd8_PurpleTag}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Image Source="ic_users" WidthRequest="18" HeightRequest="18"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="{Binding PoolCountText, Source={x:Reference Root}}" Style="{StaticResource lbl15_Bold_Purple}"/>
                    <Label Text="{Binding PoolAgeText, Source={x:Reference Root}}" Style="{StaticResource lbl11_Regular_TextLight}"/>
                </VerticalStackLayout>

                <Image Grid.Column="2" Source="{Binding PoolChevron, Source={x:Reference Root}}"
                       WidthRequest="18" HeightRequest="18" Opacity="0.65"
                       VerticalOptions="Center"/>

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TogglePoolCommand, Source={x:Reference Root}}"/>
                </Grid.GestureRecognizers>
            </Grid>

            <VerticalStackLayout Spacing="0" Padding="12,0,12,12"
                                 IsVisible="{Binding IsPoolExpanded, Source={x:Reference Root}}"
                                 BindableLayout.ItemsSource="{Binding PoolRows, Source={x:Reference Root}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:QueueRowItem">
                        <Border Style="{StaticResource brd_Surface_Flat}"
                                Padding="12,10" Margin="0,8,0,0" MinimumHeightRequest="62">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="11">
                                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding CustomerName}" Style="{StaticResource lbl14_Bold_TextDark}"/>
                                    <Label Text="{Binding SubText}" Style="{StaticResource lbl11_Regular_TextLight}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Assign" HeightRequest="46"
                                        Style="{StaticResource btn14_Bold_PurpleOutline}"
                                        VerticalOptions="Center"
                                        IsEnabled="{Binding IsEnabled}"
                                        Command="{Binding AssignCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenRowActionsCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Border>

</ContentView>
