<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.OperatorQueue"
             xmlns:responses="clr-namespace:QueueApp.Services.Api.Queue.Models"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             x:Name="Root"
             NavigationPage.HasNavigationBar="False"
             x:Class="QueueApp.Features.OperatorQueue.OperatorQueuePage"
             x:DataType="vm:OperatorQueuePageViewModel"
             Title="{Binding BusinessName}"
             BackgroundColor="{StaticResource Cream}">

    <Grid RowDefinitions="Auto,*">
        <Label Grid.Row="0"
               Text="{Binding BusinessName}"
               FontSize="24" FontAttributes="Bold"
               TextColor="{StaticResource TextDark}"
               Margin="16,16,16,0"/>

        <ScrollView Grid.Row="1" Orientation="Horizontal" Padding="16">
            <CollectionView ItemsSource="{Binding Columns}"
                             ItemsLayout="HorizontalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OperatorColumn">
                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5"
                                Margin="8" Padding="16" WidthRequest="300"
                                HeightRequest="600">
                            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">

                                <Label Grid.Row="0"
                                       Text="{Binding Operator.DisplayName}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource TextDark}"/>
                                <Label Grid.Row="1"
                                       Text="{Binding Waiting.Count, StringFormat='{0} waiting'}"
                                       FontSize="13" TextColor="{StaticResource Orange}"/>

                                <controls:AlzowLoadingButton Grid.Row="2"
                                        Text="+ Add walk-in"
                                        Margin="0" HeightRequest="56"
                                        Command="{Binding BindingContext.AddWalkInCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding Operator}"
                                        IsLoading="{Binding IsAddingWalkIn}">
                                    <controls:AlzowLoadingButton.ButtonStyle>
                                        <Style TargetType="Button">
                                            <Setter Property="FontSize" Value="17"/>
                                            <Setter Property="FontAttributes" Value="Bold"/>
                                            <Setter Property="CornerRadius" Value="14"/>
                                            <Setter Property="BackgroundColor" Value="{StaticResource Orange}"/>
                                            <Setter Property="TextColor" Value="{StaticResource White}"/>
                                        </Style>
                                    </controls:AlzowLoadingButton.ButtonStyle>
                                </controls:AlzowLoadingButton>

                                <CollectionView Grid.Row="3" ItemsSource="{Binding Waiting}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="responses:QueueEntryResponse">
                                            <Border StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{StaticResource Cream}"
                                                    Padding="12" Margin="0,4">
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding CustomerName}"
                                                           VerticalOptions="Center" FontSize="16"
                                                           TextColor="{StaticResource TextDark}"/>
                                                    <controls:AlzowLoadingButton Grid.Column="1" Text="Serve"
                                                            Margin="0" HeightRequest="44"
                                                            Command="{Binding BindingContext.ServeCommand, Source={x:Reference Root}}"
                                                            CommandParameter="{Binding .}"
                                                            IsLoading="{Binding IsServing}">
                                                        <controls:AlzowLoadingButton.ButtonStyle>
                                                            <Style TargetType="Button">
                                                                <Setter Property="FontSize" Value="14"/>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource Green}"/>
                                                                <Setter Property="TextColor" Value="{StaticResource White}"/>
                                                            </Style>
                                                        </controls:AlzowLoadingButton.ButtonStyle>
                                                    </controls:AlzowLoadingButton>
                                                    <controls:AlzowLoadingButton Grid.Column="2" Text="Done"
                                                            Margin="0" HeightRequest="44"
                                                            Command="{Binding BindingContext.DoneCommand, Source={x:Reference Root}}"
                                                            CommandParameter="{Binding .}"
                                                            IsLoading="{Binding IsCompleting}">
                                                        <controls:AlzowLoadingButton.ButtonStyle>
                                                            <Style TargetType="Button">
                                                                <Setter Property="FontSize" Value="14"/>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource Brown}"/>
                                                                <Setter Property="TextColor" Value="{StaticResource White}"/>
                                                            </Style>
                                                        </controls:AlzowLoadingButton.ButtonStyle>
                                                    </controls:AlzowLoadingButton>
                                                    <controls:AlzowLoadingButton Grid.Column="3" Text="✕"
                                                            Margin="0" HeightRequest="44"
                                                            Command="{Binding BindingContext.NoShowCommand, Source={x:Reference Root}}"
                                                            CommandParameter="{Binding .}"
                                                            IsLoading="{Binding IsMarkingNoShow}">
                                                        <controls:AlzowLoadingButton.ButtonStyle>
                                                            <Style TargetType="Button">
                                                                <Setter Property="FontSize" Value="14"/>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource Red}"/>
                                                                <Setter Property="TextColor" Value="{StaticResource White}"/>
                                                            </Style>
                                                        </controls:AlzowLoadingButton.ButtonStyle>
                                                    </controls:AlzowLoadingButton>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- TODO USE SKELETONS INSTEAD -->
        <!-- <Grid Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsLoading}" BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="{StaticResource Orange}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Scale="1.5"/>
        </Grid> -->

        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsEmpty}"
                StrokeThickness="0"
                BackgroundColor="Transparent"
                Padding="24"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Label Text="No customers waiting"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextDark}"/>
        </Border>
    </Grid>

</ContentPage>
