<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="QueueApp.Features.QueueSplash.QueueSplashPage"
             NavigationPage.HasNavigationBar="False"
             Title="QueueSplashPage">
    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">

        <skia:SKLottieView Source="queue_splash.json"
                            RepeatCount="-1"
                            HeightRequest="350"
                            WidthRequest="350"
                            Margin="0,0,0,-130"
                            HorizontalOptions="Center" />
        <Label Text="queue"
               Style="{StaticResource lbl32_Bold_TextDark}"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>