<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QueueApp.Features.Flow.Visit.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.Flow.Visit.Helpers.VisitQueueStripView">

    <Border Style="{StaticResource brd13_Raised}" Padding="16,13">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <HorizontalStackLayout Grid.Column="0" Spacing="7" VerticalOptions="Center"
                                   BindableLayout.ItemsSource="{Binding Dots, Source={x:Reference Root}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:VisitQueueDot">
                        <Ellipse Style="{StaticResource ell_QueueDot}"
                                 WidthRequest="9" HeightRequest="9"
                                 VerticalOptions="Center"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <Label Grid.Column="1"
                   Text="{Binding PositionText, Source={x:Reference Root}}"
                   Style="{StaticResource lbl13_Mono_TextPrimary}"
                   VerticalOptions="Center"/>
        </Grid>
    </Border>

</ContentView>
