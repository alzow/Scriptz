<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QueueApp.Features.Flow.Visit.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.Flow.Visit.Helpers.VisitTimelineView">

    <VerticalStackLayout Spacing="8">
        <Label Text="TIMELINE" Style="{StaticResource lbl11_Mono_TextMuted}"/>

        <Border Style="{StaticResource brd13_Raised}" Padding="14,14">
            <VerticalStackLayout Spacing="0"
                                 BindableLayout.ItemsSource="{Binding Steps, Source={x:Reference Root}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:VisitTimelineStep">
                        <Grid ColumnDefinitions="46,16,*" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding TimeText}"
                                   Style="{StaticResource lbl11_Mono_Step}"
                                   VerticalOptions="Center"/>

                            <Ellipse Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource ell_StepDot}"
                                     WidthRequest="9" HeightRequest="9"
                                     HorizontalOptions="Start" VerticalOptions="Center"/>

                            <BoxView Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource bx_StepConnector}"
                                     WidthRequest="1" HeightRequest="14"
                                     Margin="4,0,0,0"
                                     HorizontalOptions="Start"
                                     IsVisible="{Binding IsLast, Converter={StaticResource InvertedBoolConverter}}"/>

                            <Label Grid.Row="0" Grid.Column="2"
                                   Text="{Binding Text}"
                                   Style="{StaticResource lbl13_Regular_Step}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>

</ContentView>
