<?xml version="1.0" encoding="utf-8" ?>
<bottomsheet:BottomSheetPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:bottomsheet="clr-namespace:QueueApp.Shared.Templates.BottomSheet"
                             xmlns:sheets="clr-namespace:QueueApp.Features.Flow.Visit.Sheets"
                             x:Name="Root"
                             x:Class="QueueApp.Features.Flow.Visit.Sheets.VisitOptionsSheet"
                             x:DataType="sheets:VisitOptionsSheet">

    <Border VerticalOptions="End"
            Style="{StaticResource brd22_Sheet}"
            Padding="16,10,16,26">
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <Border Style="{StaticResource brd2_Grabber}"
                        WidthRequest="38"
                        HeightRequest="4"
                        Margin="0,0,0,16"
                        HorizontalOptions="Center"/>

                <Label Text="{Binding BusinessName, Source={x:Reference Root}}"
                       Style="{StaticResource lbl16_Bold_TextDark}"/>
                <Label Text="{Binding SummaryText, Source={x:Reference Root}}"
                       Style="{StaticResource lbl12_Regular_TextLight}"
                       Margin="0,3,0,14"/>

                <Button Text="Call the shop"
                        Margin="0,9,0,0"
                        HeightRequest="56"
                        Style="{StaticResource btn15_Regular_SheetRow}"
                        IsVisible="{Binding HasPhone, Source={x:Reference Root}}"
                        Clicked="OnCallClicked"/>

                <Button Text="Directions"
                        Margin="0,9,0,0"
                        HeightRequest="56"
                        Style="{StaticResource btn15_Regular_SheetRow}"
                        Clicked="OnDirectionsClicked"/>

                <Button Text="Share"
                        Margin="0,9,0,0"
                        HeightRequest="56"
                        Style="{StaticResource btn15_Regular_SheetRow}"
                        IsVisible="{Binding CanShare, Source={x:Reference Root}}"
                        Clicked="OnShareClicked"/>

                <Button Text="Add to calendar"
                        Margin="0,9,0,0"
                        HeightRequest="56"
                        Style="{StaticResource btn15_Regular_SheetRow}"
                        IsVisible="{Binding CanAddToCalendar, Source={x:Reference Root}}"
                        Clicked="OnCalendarClicked"/>

                <Button Text="Go again"
                        Margin="0,9,0,0"
                        HeightRequest="56"
                        Style="{StaticResource btn15_Regular_SheetRow}"
                        IsVisible="{Binding CanGoAgain, Source={x:Reference Root}}"
                        Clicked="OnGoAgainClicked"/>

                <BoxView HeightRequest="1"
                         Style="{StaticResource bx_Divider}"
                         Margin="0,16,0,4"
                         IsVisible="{Binding HasDestructiveAction, Source={x:Reference Root}}"/>

                <Label Text="{Binding LeavingCostText, Source={x:Reference Root}}"
                       Style="{StaticResource lbl12_Regular_TextMuted}"
                       Margin="0,10,0,0"
                       IsVisible="{Binding LeavingCostText, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>

                <Button Text="Leave the queue"
                        Margin="0,9,0,0"
                        HeightRequest="56"
                        Style="{StaticResource btn15_Regular_SheetBad}"
                        IsVisible="{Binding CanLeaveQueue, Source={x:Reference Root}}"
                        Clicked="OnLeaveClicked"/>

                <Button Text="Cancel booking"
                        Margin="0,9,0,0"
                        HeightRequest="56"
                        Style="{StaticResource btn15_Regular_SheetBad}"
                        IsVisible="{Binding CanCancelBooking, Source={x:Reference Root}}"
                        Clicked="OnCancelBookingClicked"/>

            </VerticalStackLayout>
        </ScrollView>
    </Border>

</bottomsheet:BottomSheetPage>
