<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.Flow.Helpers.ReviewStepView">

    <ScrollView IsVisible="{Binding ShowReviewStep, Source={x:Reference Root}}">
        <VerticalStackLayout Spacing="0">

            <!-- Shop-side only: an operator-created booking has no account behind it, so the name
                 and number are the only way to know whose slot this is or to reach them. -->
            <VerticalStackLayout Spacing="0" Margin="0,0,0,18"
                                 IsVisible="{Binding ShowCustomerCapture, Source={x:Reference Root}}">
                <Label Text="NAME" Style="{StaticResource lbl9_Mono_TextMuted}" Margin="20,0,20,8"/>
                <Border Margin="20,0" Padding="4,0" Style="{StaticResource brd12_Cream}">
                    <Entry Text="{Binding CustomerName, Source={x:Reference Root}}"
                           Placeholder="Who's coming in?"
                           Style="{StaticResource entry14_Sheet}"/>
                </Border>

                <Label Text="PHONE — OPTIONAL" Style="{StaticResource lbl9_Mono_TextMuted}" Margin="20,14,20,8"/>
                <Border Margin="20,0" Padding="4,0" Style="{StaticResource brd12_Cream}">
                    <Entry Text="{Binding CustomerPhone, Source={x:Reference Root}}"
                           Placeholder="082 000 0000"
                           Keyboard="Telephone"
                           Style="{StaticResource entry13_SheetMono}"/>
                </Border>
            </VerticalStackLayout>

            <Border Margin="20,0" Padding="15,6"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Line}" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="17"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11">
                        <Label Grid.Column="0" Text="{Binding ReviewOperatorLabel, Source={x:Reference Root}}" Style="{StaticResource lbl13_Regular_TextMid}"/>
                        <Label Grid.Column="1" Text="{Binding ReviewOperatorText, Source={x:Reference Root}}" Style="{StaticResource lbl14_Bold_TextDark}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11">
                        <Label Grid.Column="0" Text="Service" Style="{StaticResource lbl13_Regular_TextMid}"/>
                        <Label Grid.Column="1" Text="{Binding ReviewServiceText, Source={x:Reference Root}}" Style="{StaticResource lbl14_Bold_TextDark}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11">
                        <Label Grid.Column="0" Text="Price" Style="{StaticResource lbl13_Regular_TextMid}"/>
                        <Label Grid.Column="1" Text="{Binding ReviewPriceText, Source={x:Reference Root}}" Style="{StaticResource lbl14_Bold_TextDark}"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" Margin="0,4"/>

                    <!-- The part the customer hasn't seen yet — shown before committing -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11"
                          IsVisible="{Binding ShowReviewWhen, Source={x:Reference Root}}">
                        <Label Grid.Column="0" Text="When" Style="{StaticResource lbl13_Regular_TextMid}"/>
                        <Label Grid.Column="1" Text="{Binding ReviewWhenText, Source={x:Reference Root}}" Style="{StaticResource lbl13_Mono_Green}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11"
                          IsVisible="{Binding ShowReviewQueueLines, Source={x:Reference Root}}">
                        <Label Grid.Column="0" Text="You'll be" Style="{StaticResource lbl13_Regular_TextMid}"/>
                        <Label Grid.Column="1" Text="{Binding ReviewPositionText, Source={x:Reference Root}}" Style="{StaticResource lbl13_Mono_Green}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11"
                          IsVisible="{Binding ShowReviewQueueLines, Source={x:Reference Root}}">
                        <Label Grid.Column="0" Text="Your turn about" Style="{StaticResource lbl13_Regular_TextMid}"/>
                        <Label Grid.Column="1" Text="{Binding ReviewTurnText, Source={x:Reference Root}}" Style="{StaticResource lbl13_Mono_Green}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding NoteLabelText, Source={x:Reference Root}}"
                   Style="{StaticResource lbl9_Mono_TextMuted}"
                   Margin="20,18,20,8"/>
            <Border Margin="20,0" Padding="10,4" Style="{StaticResource brd12_Cream}">
                <Editor Text="{Binding BookingNote, Source={x:Reference Root}}"
                        Placeholder="Registration, what's wrong, anything worth mentioning"
                        Style="{StaticResource editor14_Sheet}"/>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentView>
