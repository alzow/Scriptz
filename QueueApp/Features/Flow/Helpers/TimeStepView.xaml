<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:QueueApp.Features.Flow.Helpers"
             x:Name="Root"
             x:Class="QueueApp.Features.Flow.Helpers.TimeStepView">

    <ScrollView IsVisible="{Binding ShowTimeStep, Source={x:Reference Root}}">
        <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

            <ActivityIndicator IsRunning="{Binding IsLoadingSlots, Source={x:Reference Root}}"
                               IsVisible="{Binding IsLoadingSlots, Source={x:Reference Root}}"
                               Style="{StaticResource ai_Accent}"/>

            <helpers:SlotPeriodView Period="{Binding Morning, Source={x:Reference Root}}"
                                    SelectSlotCommand="{Binding SelectSlotCommand, Source={x:Reference Root}}"/>

            <helpers:SlotPeriodView Period="{Binding Afternoon, Source={x:Reference Root}}"
                                    SelectSlotCommand="{Binding SelectSlotCommand, Source={x:Reference Root}}"/>

            <helpers:SlotPeriodView Period="{Binding Evening, Source={x:Reference Root}}"
                                    SelectSlotCommand="{Binding SelectSlotCommand, Source={x:Reference Root}}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
