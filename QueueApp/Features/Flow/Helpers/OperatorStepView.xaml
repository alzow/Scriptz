<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             xmlns:models="clr-namespace:QueueApp.Shared.Domain.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.Flow.Helpers.OperatorStepView">

    <CollectionView ItemsSource="{Binding OperatorChoices, Source={x:Reference Root}}"
                    IsVisible="{Binding ShowOperatorStep, Source={x:Reference Root}}"
                    Margin="20,0,20,0">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:OperatorChoiceItem">
                <VerticalStackLayout Spacing="0">
                    <Border Padding="12" Margin="0,0,0,8"
                            Style="{StaticResource brd15_Row_Selectable}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectOperatorCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                    Style="{StaticResource brd21_Avatar_Available}">
                                <Label Text="{Binding Initials}"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       Style="{StaticResource lbl13_Mono_Available}"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="7">
                                    <Label Text="{Binding Name}" Style="{StaticResource lbl14_Bold_TextDark}"
                                           VerticalOptions="Center"/>
                                    <Border Padding="6,3" IsVisible="{Binding ShowFastestTag}"
                                            Style="{StaticResource brd6_AccentTag}"
                                            VerticalOptions="Center">
                                        <Label Text="FASTEST" Style="{StaticResource lbl9_Mono_Green}"/>
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{Binding SubLabel}" Style="{StaticResource lbl12_Regular_TextLight}"/>
                            </VerticalStackLayout>

                            <Border Grid.Column="2" WidthRequest="22" HeightRequest="22"
                                    Style="{StaticResource brd11_Radio_Selectable}"
                                    VerticalOptions="Center">
                                <tpl:ThemedIcon Icon="ic_check" WidthRequest="12" HeightRequest="12"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       IsVisible="{Binding IsSelected}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- "or choose" separates the pinned any-available row from named operators -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,4,0,12"
                          IsVisible="{Binding IsAnyAvailable}">
                        <Label Grid.Column="0" Text="OR CHOOSE" Style="{StaticResource lbl9_Mono_TextFaint}"
                               VerticalOptions="Center"/>
                        <BoxView Grid.Column="1" HeightRequest="1" VerticalOptions="Center"
                                 Style="{StaticResource bx_Divider}"/>
                    </Grid>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentView>
