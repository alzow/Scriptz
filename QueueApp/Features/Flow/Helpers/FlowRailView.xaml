<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QueueApp.Shared.Domain.Models"
             x:Name="Root"
             VerticalOptions="Start"
             x:Class="QueueApp.Features.Flow.Helpers.FlowRailView">

    <VerticalStackLayout Spacing="0">

        <!-- Rail: one equal segment per step that will actually happen, so a two-step flow
             looks like a two-step flow. FlexLayout because the segment count is dynamic and
             the widths have to divide the row. -->
        <FlexLayout Direction="Row" JustifyContent="SpaceBetween" HeightRequest="3"
                    Margin="20,16,20,0"
                    BindableLayout.ItemsSource="{Binding RailSegments, Source={x:Reference Root}}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:RailSegment">
                    <BoxView HeightRequest="3" CornerRadius="2" Margin="2,0"
                             FlexLayout.Grow="1" FlexLayout.Basis="0"
                             BackgroundColor="{StaticResource Line}">
                        <BoxView.Triggers>
                            <DataTrigger TargetType="BoxView" Binding="{Binding IsDone}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource GreenDim}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="BoxView" Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Green}"/>
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <Grid ColumnDefinitions="*,Auto" Padding="20,9,20,0">
            <Label Grid.Column="0" Text="{Binding RailStepLabel, Source={x:Reference Root}}" Style="{StaticResource lbl10_Mono_Green}"/>
            <Label Grid.Column="1" Text="{Binding RailCountText, Source={x:Reference Root}}" Style="{StaticResource lbl10_Mono_TextFaint}"/>
        </Grid>

        <!-- Crumbs: completed steps, tappable to jump back -->
        <CollectionView ItemsSource="{Binding Crumbs, Source={x:Reference Root}}" HeightRequest="40"
                        IsVisible="{Binding HasCrumbs, Source={x:Reference Root}}" Margin="20,10,20,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="7"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CrumbChip">
                    <Border Padding="9,5" VerticalOptions="Center"
                            BackgroundColor="{StaticResource SurfaceRaised}"
                            Stroke="{StaticResource Line}" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="9"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding JumpToCrumbCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding Text}" Style="{StaticResource lbl12_Regular_Cream}"
                                   VerticalOptions="Center"/>
                            <Image Source="ic_close" WidthRequest="10" HeightRequest="10"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Spacing="7" Padding="20,20,20,14">
            <Label Text="{Binding StepHeading, Source={x:Reference Root}}" Style="{StaticResource lbl22_Bold_Cream}"/>
            <Label Text="{Binding StepSubheading, Source={x:Reference Root}}" Style="{StaticResource lbl12_Regular_TextLight}"/>
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentView>
