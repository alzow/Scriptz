<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             xmlns:models="clr-namespace:QueueApp.Shared.Domain.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.Flow.Helpers.ServiceStepView">

    <CollectionView ItemsSource="{Binding ServiceRows, Source={x:Reference Root}}"
                    IsVisible="{Binding ShowServiceStep, Source={x:Reference Root}}"
                    Margin="20,0,20,0">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:ServiceChoiceItem">
                <Border Padding="12" Margin="0,0,0,8"
                        Style="{StaticResource brd15_Row_Selectable}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectServiceCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding Name}" Style="{StaticResource lbl14_Bold_TextDark}"/>
                            <Label Text="{Binding DurationText}" Style="{StaticResource lbl12_Regular_TextLight}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding PriceText}" VerticalOptions="Center"
                               Style="{StaticResource lbl13_Mono_TextPrimary}"/>
                        <Border Grid.Column="2" WidthRequest="22" HeightRequest="22"
                                Style="{StaticResource brd11_Radio_Selectable}"
                                VerticalOptions="Center">
                            <tpl:ThemedIcon Icon="ic_check" WidthRequest="12" HeightRequest="12"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding IsSelected}"/>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentView>
