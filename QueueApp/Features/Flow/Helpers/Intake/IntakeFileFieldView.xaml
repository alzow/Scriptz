<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             x:Name="Root"
             x:Class="QueueApp.Features.Flow.Helpers.Intake.IntakeFileFieldView">

    <VerticalStackLayout Spacing="8">

        <!-- What's attached, once something is. Named and sized, because "a file is attached" is
             not enough to tell a photo of the right script from a photo of the wrong one. -->
        <Border Padding="12" Style="{StaticResource brd13_Raised_Lined}"
                IsVisible="{Binding HasFile, Source={x:Reference Root}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                    <Label Text="{Binding FileName, Source={x:Reference Root}}"
                           LineBreakMode="MiddleTruncation"
                           Style="{StaticResource lbl13_Regular_TextMid}"/>
                    <Label Text="{Binding FileSizeText, Source={x:Reference Root}}"
                           IsVisible="{Binding FileSizeText, Source={x:Reference Root},
                                       Converter={StaticResource IsNotNullOrEmptyConverter}}"
                           Style="{StaticResource lbl11_Mono_TextMuted}"/>
                </VerticalStackLayout>

                <Border Grid.Column="1" WidthRequest="30" HeightRequest="30"
                        Style="{StaticResource brd26_GhostCircle}"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding ClearCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}"/>
                    </Border.GestureRecognizers>
                    <tpl:ThemedIcon Icon="ic_close" WidthRequest="12" HeightRequest="12"
                                    HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border Padding="14,12" Style="{StaticResource brd_Ghost_Dashed}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding PickCommand, Source={x:Reference Root}}"
                    CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}"/>
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" VerticalOptions="Center"
                       Text="{Binding PickText, Source={x:Reference Root}}"
                       Style="{StaticResource lbl13_Bold_Action}"/>
                <ActivityIndicator Grid.Column="1" WidthRequest="18" HeightRequest="18"
                                   Style="{StaticResource ai_Accent}"
                                   IsRunning="{Binding IsPicking, Source={x:Reference Root}}"
                                   IsVisible="{Binding IsPicking, Source={x:Reference Root}}"/>
            </Grid>
        </Border>

        <Label Text="Images and PDFs" Style="{StaticResource lbl11_Mono_TextFaint}"/>

    </VerticalStackLayout>

</ContentView>
