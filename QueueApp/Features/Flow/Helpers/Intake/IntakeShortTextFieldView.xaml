<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.Flow.Helpers.Intake.IntakeShortTextFieldView">

    <Border Padding="4,0" Style="{StaticResource brd12_Cream}">
        <Entry Text="{Binding Text, Source={x:Reference Root}}"
               Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
               Style="{StaticResource entry14_Sheet}"/>
    </Border>

</ContentView>
