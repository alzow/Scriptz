<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:entry="clr-namespace:QueueApp.Shared.Templates.QueueEntry"
             x:Name="Root"
             x:Class="QueueApp.Features.Flow.Helpers.Intake.IntakeShortTextFieldView">

    <entry:QueueEntry Text="{Binding Text, Source={x:Reference Root}}"
                      Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                      ShowClearTextButton="True"/>

</ContentView>
