<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.Profile.Helpers.LeaveAtChipView">

    <Border Style="{StaticResource brd16_Chip}"
            MinimumHeightRequest="46"
            MinimumWidthRequest="52">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource ItemEqualsSelectedConverter}">
                        <Binding Path="Minutes" Source="{x:Reference Root}"/>
                        <Binding Path="SelectedMinutes" Source="{x:Reference Root}"/>
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Style" Value="{StaticResource brd16_Chip_Selected}"/>
            </DataTrigger>
        </Border.Triggers>

        <Label Text="{Binding Minutes, Source={x:Reference Root}}"
               Style="{StaticResource lbl13_Chip}"
               HorizontalOptions="Center"
               VerticalOptions="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ItemEqualsSelectedConverter}">
                            <Binding Path="Minutes" Source="{x:Reference Root}"/>
                            <Binding Path="SelectedMinutes" Source="{x:Reference Root}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Style" Value="{StaticResource lbl13_Chip_Selected}"/>
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}"
                                  CommandParameter="{Binding Minutes, Source={x:Reference Root}}"/>
        </Border.GestureRecognizers>
    </Border>

</ContentView>
