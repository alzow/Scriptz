<?xml version="1.0" encoding="utf-8" ?>
<bottomsheet:BottomSheetPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:sheets="clr-namespace:QueueApp.Features.Profile.Sheets"
                             xmlns:bottomsheet="clr-namespace:QueueApp.Shared.Templates.BottomSheet"
                             xmlns:helpers="clr-namespace:QueueApp.Features.Profile.Helpers"
                             x:Name="Root"
                             x:Class="QueueApp.Features.Profile.Sheets.AppearanceSheet"
                             x:DataType="sheets:AppearanceSheet">

    <Border VerticalOptions="End"
            Style="{StaticResource brd22_Sheet}" Padding="16,10,16,26">
        <VerticalStackLayout Spacing="0">

            <Border Style="{StaticResource brd2_Grabber}"
                    WidthRequest="38" HeightRequest="4" Margin="0,0,0,16"
                    HorizontalOptions="Center"/>

            <Label Text="Appearance" Style="{StaticResource lbl18_Bold_TextDark}"/>
            <Label Text="{Binding VersionText, Source={x:Reference Root}}"
                   Style="{StaticResource lbl13_Regular_TextLight}" Margin="0,3,0,0"/>

            <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}" Margin="0,14"/>

            <VerticalStackLayout Spacing="10">
                <helpers:AppearanceRowView Title="Follow my phone"
                                           Detail="Changes with your system setting"
                                           IsSelected="{Binding IsSystemTheme, Source={x:Reference Root}}"
                                           Command="{Binding SetThemeCommand, Source={x:Reference Root}}"
                                           CommandParameter="System"/>

                <helpers:AppearanceRowView Title="Always light"
                                           Detail="Easier in a shop window at midday"
                                           IsSelected="{Binding IsLightTheme, Source={x:Reference Root}}"
                                           Command="{Binding SetThemeCommand, Source={x:Reference Root}}"
                                           CommandParameter="Light"/>

                <helpers:AppearanceRowView Title="Always dark"
                                           Detail="Easier at night"
                                           IsSelected="{Binding IsDarkTheme, Source={x:Reference Root}}"
                                           Command="{Binding SetThemeCommand, Source={x:Reference Root}}"
                                           CommandParameter="Dark"/>
            </VerticalStackLayout>

            <Label Text="Shops set their own screens separately. This only changes yours."
                   Style="{StaticResource lbl11_Regular_TextFaint}" Margin="2,16,2,0"/>

            <Button Text="Done" HeightRequest="56" Margin="0,18,0,0"
                    Style="{StaticResource TertiaryButtonStyle}"
                    Clicked="OnCloseClicked"/>

        </VerticalStackLayout>
    </Border>

</bottomsheet:BottomSheetPage>
