<?xml version="1.0" encoding="utf-8" ?>
<bottomsheet:BottomSheetPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:sheets="clr-namespace:QueueApp.Features.Profile.Sheets"
                             xmlns:bottomsheet="clr-namespace:QueueApp.Shared.Templates.BottomSheet"
                             xmlns:entry="clr-namespace:QueueApp.Shared.Templates.QueueEntry"
                             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
                             x:Name="Root"
                             x:Class="QueueApp.Features.Profile.Sheets.YourDetailsSheet"
                             x:DataType="sheets:YourDetailsSheet">

    <Border VerticalOptions="End"
            Style="{StaticResource brd22_Sheet}" Padding="16,10,16,26">
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <Border Style="{StaticResource brd2_Grabber}"
                        WidthRequest="38" HeightRequest="4" Margin="0,0,0,16"
                        HorizontalOptions="Center"/>

                <Label Text="Your details" Style="{StaticResource lbl18_Bold_TextDark}"/>
                <Label Text="What shops see when you join"
                       Style="{StaticResource lbl13_Regular_TextLight}" Margin="0,3,0,0"/>

                <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}" Margin="0,14"/>

                <Label Text="NAME" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <entry:QueueEntry Placeholder="Your name"
                                  Text="{Binding Name, Source={x:Reference Root}}"
                                  Validator="{Binding NameValidator, Source={x:Reference Root}}"
                                  ValidateOnTextChanged="True"/>
                <Label Text="Barbers see this on their board. A first name and initial is plenty."
                       Style="{StaticResource lbl11_Regular_TextFaint}" Margin="2,6,2,0"/>

                <Label Text="PHONE" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                <entry:QueueEntry Placeholder="082 555 0148"
                                  Text="{Binding Phone, Source={x:Reference Root}}"
                                  Validator="{Binding PhoneValidator, Source={x:Reference Root}}"
                                  InputType="Telephone"/>
                <Label Text="How a shop reaches you if something changes. Only shared with shops you join."
                       Style="{StaticResource lbl11_Regular_TextFaint}" Margin="2,6,2,0"/>

                <Label Text="EMAIL" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                <Border Style="{StaticResource brd16_Entry_Locked}" Padding="14,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="{Binding Email, Source={x:Reference Root}}"
                               Style="{StaticResource lbl14_Regular_TextLight}"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center"/>
                        <tpl:ThemedIcon Grid.Column="1" Icon="ic_lock"
                                        WidthRequest="16" HeightRequest="16"
                                        Opacity="0.65" VerticalOptions="Center"/>
                    </Grid>
                </Border>
                <Label Text="You sign in with this. Contact us to change it."
                       Style="{StaticResource lbl11_Regular_TextFaint}" Margin="2,6,2,0"/>

                <Label Text="{Binding ErrorMessage, Source={x:Reference Root}}"
                       Style="{StaticResource lbl12_Regular_Danger}"
                       Margin="2,14,2,0"
                       IsVisible="{Binding ErrorMessage, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>

                <Button Text="Save" HeightRequest="56" Margin="0,20,0,0"
                        Style="{StaticResource btn16_Bold_Green}"
                        IsEnabled="{Binding IsSaving, Source={x:Reference Root}, Converter={StaticResource InvertedBoolConverter}}"
                        Clicked="OnSaveClicked"/>

                <ActivityIndicator IsRunning="{Binding IsSaving, Source={x:Reference Root}}"
                                   IsVisible="{Binding IsSaving, Source={x:Reference Root}}"
                                   Style="{StaticResource ai_Accent}" Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </ScrollView>
    </Border>

</bottomsheet:BottomSheetPage>
