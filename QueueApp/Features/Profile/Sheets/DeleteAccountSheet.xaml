<?xml version="1.0" encoding="utf-8" ?>
<bottomsheet:BottomSheetPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:sheets="clr-namespace:QueueApp.Features.Profile.Sheets"
                             xmlns:models="clr-namespace:QueueApp.Features.Profile.Models"
                             xmlns:bottomsheet="clr-namespace:QueueApp.Shared.Templates.BottomSheet"
                             xmlns:entry="clr-namespace:QueueApp.Shared.Templates.QueueEntry"
                             x:Name="Root"
                             x:Class="QueueApp.Features.Profile.Sheets.DeleteAccountSheet"
                             x:DataType="sheets:DeleteAccountSheet">

    <Border VerticalOptions="End"
            Style="{StaticResource brd22_Sheet}" Padding="16,10,16,26">
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <Border Style="{StaticResource brd2_Grabber}"
                        WidthRequest="38" HeightRequest="4" Margin="0,0,0,16"
                        HorizontalOptions="Center"/>

                <Label Text="Delete your account" Style="{StaticResource lbl18_Bold_TextDark}"/>
                <Label Text="This can't be undone"
                       Style="{StaticResource lbl13_Regular_Danger}" Margin="0,3,0,0"/>

                <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}" Margin="0,14"/>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasCommitments, Source={x:Reference Root}}">

                    <Border Style="{StaticResource brd13_Danger}">
                        <Label Text="You have things booked right now. Deleting cancels all of them and the shops will be told."
                               Style="{StaticResource lbl12_Regular_Danger}"/>
                    </Border>

                    <VerticalStackLayout Spacing="10"
                                         BindableLayout.ItemsSource="{Binding Consequences, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:DeleteConsequenceItem">
                                <Border Style="{StaticResource brd16_White}" Padding="16,13">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Title}" Style="{StaticResource lbl15_Bold_TextDark}"/>
                                        <Label Text="{Binding Detail}" Style="{StaticResource lbl12_Regular_TextMuted}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <Label Text="TYPE DELETE TO CONFIRM" Style="{StaticResource SectionTitle}" Margin="0,20,0,6"/>
                <entry:QueueEntry Placeholder="DELETE"
                                  Text="{Binding ConfirmText, Source={x:Reference Root}}"/>

                <Label Text="{Binding ErrorMessage, Source={x:Reference Root}}"
                       Style="{StaticResource lbl12_Regular_Danger}"
                       Margin="2,12,2,0"
                       IsVisible="{Binding ErrorMessage, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>

                <Button Text="Delete my account" HeightRequest="56" Margin="0,18,0,0"
                        Style="{StaticResource DangerButtonStyle}"
                        IsEnabled="{Binding CanDelete, Source={x:Reference Root}}"
                        Clicked="OnDeleteClicked"/>

                <Button Text="Keep my account" HeightRequest="56" Margin="0,10,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Clicked="OnKeepClicked"/>

                <ActivityIndicator IsRunning="{Binding IsDeleting, Source={x:Reference Root}}"
                                   IsVisible="{Binding IsDeleting, Source={x:Reference Root}}"
                                   Style="{StaticResource ai_Accent}" Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </ScrollView>
    </Border>

</bottomsheet:BottomSheetPage>
