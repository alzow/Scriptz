<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="QueueApp.Features.Profile.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Profile"
             x:Name="Root"
             x:DataType="vm:ProfilePageViewModel"
             IconImageSource="icon_profile"
             Title="Profile"
             Style="{StaticResource NavigationPageStyle}">
    <VerticalStackLayout Spacing="8" Padding="20,24">
        <Label Text="Profile" Style="{StaticResource lbl20_Bold_TextDark}"/>
        <Label Text="Account details, T&amp;Cs, and becoming an operator will live here."
               Style="{StaticResource lbl13_Regular_TextLight}"/>

        <Label Text="APPEARANCE" Style="{StaticResource SectionTitle}" Margin="0,24,0,0"/>

        <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
            <Border Style="{StaticResource brd16_Chip}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSystemTheme}" Value="True">
                        <Setter Property="Style" Value="{StaticResource brd16_Chip_Selected}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSystemTheme}" Value="False">
                        <Setter Property="Style" Value="{StaticResource brd16_Chip}"/>
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="System"/>
                </Border.GestureRecognizers>
                <Label Text="System" Style="{StaticResource lbl13_Chip}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsSystemTheme}" Value="True">
                            <Setter Property="Style" Value="{StaticResource lbl13_Chip_Selected}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsSystemTheme}" Value="False">
                            <Setter Property="Style" Value="{StaticResource lbl13_Chip}"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>

            <Border Style="{StaticResource brd16_Chip}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsLightTheme}" Value="True">
                        <Setter Property="Style" Value="{StaticResource brd16_Chip_Selected}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsLightTheme}" Value="False">
                        <Setter Property="Style" Value="{StaticResource brd16_Chip}"/>
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                </Border.GestureRecognizers>
                <Label Text="Light" Style="{StaticResource lbl13_Chip}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsLightTheme}" Value="True">
                            <Setter Property="Style" Value="{StaticResource lbl13_Chip_Selected}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsLightTheme}" Value="False">
                            <Setter Property="Style" Value="{StaticResource lbl13_Chip}"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>

            <Border Style="{StaticResource brd16_Chip}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsDarkTheme}" Value="True">
                        <Setter Property="Style" Value="{StaticResource brd16_Chip_Selected}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsDarkTheme}" Value="False">
                        <Setter Property="Style" Value="{StaticResource brd16_Chip}"/>
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                </Border.GestureRecognizers>
                <Label Text="Dark" Style="{StaticResource lbl13_Chip}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsDarkTheme}" Value="True">
                            <Setter Property="Style" Value="{StaticResource lbl13_Chip_Selected}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsDarkTheme}" Value="False">
                            <Setter Property="Style" Value="{StaticResource lbl13_Chip}"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </HorizontalStackLayout>

        <Label Text="Dark is the default. Light exists for a shop window at midday."
               Style="{StaticResource lbl11_Regular_TextFaint}" Margin="0,10,0,0"/>
    </VerticalStackLayout>
</ContentPage>
