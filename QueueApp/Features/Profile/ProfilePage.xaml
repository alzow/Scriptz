<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="QueueApp.Features.Profile.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Profile"
             xmlns:helpers="clr-namespace:QueueApp.Features.Profile.Helpers"
             x:DataType="vm:ProfilePageViewModel"
             IconImageSource="icon_profile"
             Title="Profile"
             Style="{StaticResource NavigationPageStyle}">

    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="20,24,20,32">

            <Label Text="Profile" Style="{StaticResource lbl26_Bold_PageTitle}"/>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,14,0,4">
                <Border Grid.Column="0"
                        Style="{StaticResource brd_Avatar_Ellipse}"
                        WidthRequest="52" HeightRequest="52">
                    <Label Text="{Binding Initials}"
                           Style="{StaticResource lbl16_Mono_TextPrimary}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="{Binding DisplayName}" Style="{StaticResource lbl18_Bold_TextDark}"/>
                    <Label Text="{Binding Email}"
                           Style="{StaticResource lbl13_Regular_TextLight}"
                           IsVisible="{Binding HasEmail}"/>
                </VerticalStackLayout>
            </Grid>

            <helpers:ProfileStatusView IsAllowed="{Binding NotificationsAllowed}"
                                       Headline="{Binding StatusHeadline}"
                                       Detail="{Binding StatusDetail}"
                                       ActionText="{Binding StatusActionText}"
                                       ActionCommand="{Binding TurnOnNotificationsCommand}"
                                       Margin="0,4,0,10"/>

            <Label Text="YOU" Style="{StaticResource SectionTitle}" Margin="2,6,0,2"/>

            <helpers:ProfileRowView Title="Your details"
                                    Detail="{Binding DetailsRowDetail}"
                                    Command="{Binding OpenDetailsCommand}"/>

            <helpers:ProfileRowView Title="Notifications"
                                    Detail="{Binding NotificationsRowDetail}"
                                    Command="{Binding OpenNotificationsCommand}"/>

            <Label Text="YOUR BUSINESS" Style="{StaticResource SectionTitle}" Margin="2,16,0,2"
                   IsVisible="{Binding OwnsBusiness}"/>

            <helpers:ProfileRowView Title="{Binding BusinessName}"
                                    Detail="{Binding BusinessDetail}"
                                    Command="{Binding OpenBusinessCommand}"
                                    IsVisible="{Binding OwnsBusiness}"/>

            <Label Text="APP" Style="{StaticResource SectionTitle}" Margin="2,16,0,2"/>

            <helpers:ProfileRowView Title="Appearance"
                                    Detail="{Binding AppearanceRowDetail}"
                                    Command="{Binding OpenAppearanceCommand}"/>

            <helpers:ProfileRowView Title="Account and privacy"
                                    Detail="Your data, delete account"
                                    Command="{Binding OpenAccountCommand}"/>

            <Button Text="Sign out"
                    Command="{Binding SignOutCommand}"
                    Style="{StaticResource GhostButtonStyle}"
                    HeightRequest="56"
                    Margin="0,22,0,0"/>

            <Label Text="{Binding VersionText}"
                   Style="{StaticResource lbl11_Regular_TextFaint}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
