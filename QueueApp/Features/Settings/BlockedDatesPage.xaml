<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Settings"
             xmlns:skeleton="clr-namespace:QueueApp.Shared.Templates.Skeleton"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             xmlns:models="clr-namespace:QueueApp.Services.Api.Operator.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.Settings.BlockedDatesPage"
             x:DataType="vm:BlockedDatesPageViewModel"
             Title="{Binding Title}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                       Title="{Binding Title}"
                                       BackCommand="{Binding GoBackCommand}"/>

        <controls:AlzowLoadingButton Grid.Row="1" Text="+ Block a date"
                Margin="16" HeightRequest="56"
                Command="{Binding AddBlockCommand}"
                ButtonStyle="{StaticResource PrimaryButtonStyle}"/>

        <Grid Grid.Row="2">
            <ScrollView IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="4"
                                      BindableLayout.ItemsSource="{Binding Blocks}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:AvailabilityBlockResponse">
                            <!-- ListRow geometry, shared with SkeletonListRowView. -->
                            <Border Style="{StaticResource brd16_ListRow}">
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource grid_ListRow}">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding RangeDisplay}" Style="{StaticResource lbl15_Bold_TextDark}"/>
                                        <Label Text="{Binding Reason}"
                                               Style="{StaticResource lbl13_Regular_TextLight}"
                                               IsVisible="{Binding HasReason}"/>
                                    </VerticalStackLayout>
                                    <controls:AlzowLoadingButton Grid.Column="1" Text="Remove"
                                            LoadingText="Removing…"
                                            Command="{Binding BindingContext.DeleteBlockCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"
                                            IsLoading="{Binding IsDeleting}"
                                            ButtonStyle="{StaticResource TertiaryButtonStyle}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <Label Text="No blocked dates — fully available per weekly hours." IsVisible="{Binding IsEmpty}"
                   Style="{StaticResource lbl18_Bold_TextDark}"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   Padding="30,0" HorizontalTextAlignment="Center"/>

            <Border Style="{StaticResource brd13_Ghost}" Padding="18,20" Margin="20,0"
                    VerticalOptions="Center"
                    IsVisible="{Binding HasLoadFailed}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding LoadFailureText}"
                           Style="{StaticResource lbl12_Regular_TextMuted}"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"/>
                    <Label Text="Try again"
                           Style="{StaticResource lbl13_Bold_Action}"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RetryLoadCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <skeleton:SkeletonList Kind="ListRowPlain"
                                   Count="{x:Static vm:BlockedDatesPageViewModel.SkeletonRowCount}"
                                   VerticalOptions="Start"
                                   IsVisible="{Binding IsFirstLoading}"/>
        </Grid>
    </Grid>
</ContentPage>
