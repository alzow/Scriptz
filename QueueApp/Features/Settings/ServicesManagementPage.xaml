<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Settings"
             xmlns:responses="clr-namespace:QueueApp.Services.Api.ServiceOfferings.Models"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             xmlns:helpers="clr-namespace:QueueApp.Features.Settings.Helpers"
             x:Name="Root"
             x:Class="QueueApp.Features.Settings.ServicesManagementPage"
             x:DataType="vm:ServicesManagementPageViewModel"
             Title="{Binding Title}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,*">
        <helpers:SettingsHeaderView Grid.Row="0" Title="{Binding Title}" Command="{Binding GoBackCommand}"/>

        <Grid Grid.Row="1">
            <ScrollView IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Padding="16,0,16,24" Spacing="0">

                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding ActiveServices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="responses:ServiceResponse">
                                <Border Style="{StaticResource brd16_White}" Padding="14" Margin="0,6"
                                        MinimumHeightRequest="62">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource lbl15_Bold_TextDark}"/>
                                            <Label FontSize="13" Style="{StaticResource lbl13_Regular_TextLight}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding EstMinutes}"/>
                                                        <Span Text=" min · "/>
                                                        <Span Text="{Binding PriceDisplay}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <tpl:ThemedIcon Grid.Column="1" Icon="ic_chevron_right"
                                               WidthRequest="16" HeightRequest="16" Opacity="0.65"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.EditServiceCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource brd13_Ghost}" Padding="14" Margin="0,10,0,0">
                        <Label Text="+ Add a service" Style="{StaticResource lbl13_Bold_Green}"
                               HorizontalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddServiceCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <VerticalStackLayout Spacing="0" Margin="0,22,0,0" IsVisible="{Binding HasInactive}">
                        <Grid ColumnDefinitions="*,Auto" Padding="4,10" MinimumHeightRequest="44">
                            <Label Grid.Column="0" Text="{Binding InactiveHeaderText}"
                                   Style="{StaticResource lbl13_Regular_TextLight}" VerticalOptions="Center"/>
                            <tpl:ThemedIcon Grid.Column="1" Icon="{Binding InactiveChevron}"
                                   WidthRequest="16" HeightRequest="16" Opacity="0.65" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleInactiveExpandedCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                        <VerticalStackLayout Spacing="0" IsVisible="{Binding IsInactiveExpanded}"
                                             BindableLayout.ItemsSource="{Binding InactiveServices}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="responses:ServiceResponse">
                                    <Border Style="{StaticResource brd16_White}" Padding="14" Margin="0,6"
                                            MinimumHeightRequest="62" Opacity="0.7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" Style="{StaticResource lbl15_Bold_TextDark}"/>
                                                <Label FontSize="13" Style="{StaticResource lbl13_Regular_TextLight}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding EstMinutes}"/>
                                                            <Span Text=" min · "/>
                                                            <Span Text="{Binding PriceDisplay}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                            <controls:AlzowLoadingButton Grid.Column="1" Text="Reactivate"
                                                    LoadingText="Reactivating…"
                                                    Margin="0" HeightRequest="44"
                                                    Command="{Binding BindingContext.ReactivateCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding .}"
                                                    IsLoading="{Binding IsToggling}"
                                                    ButtonStyle="{StaticResource btn14_Bold_GreenOutline}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="16" Padding="20">
                <Label Text="No services yet — add your first one below." Style="{StaticResource lbl18_Bold_TextDark}"
                       HorizontalTextAlignment="Center"/>
                <Border Style="{StaticResource brd13_Ghost}" Padding="14" WidthRequest="220">
                    <Label Text="+ Add a service" Style="{StaticResource lbl13_Bold_Green}"
                           HorizontalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddServiceCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               Style="{StaticResource ai_Purple}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
