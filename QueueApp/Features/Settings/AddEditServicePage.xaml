<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Settings"
             xmlns:models="clr-namespace:QueueApp.Features.Settings.Models"
             xmlns:entry="clr-namespace:QueueApp.Shared.Templates.QueueEntry"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             xmlns:helpers="clr-namespace:QueueApp.Features.Settings.Helpers"
             x:Name="Root"
             x:Class="QueueApp.Features.Settings.AddEditServicePage"
             x:DataType="vm:AddEditServicePageViewModel"
             Title="{Binding PageTitle}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,*">
        <helpers:SettingsHeaderView Grid.Row="0" Title="{Binding PageTitle}" Command="{Binding GoBackCommand}"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <VerticalStackLayout Spacing="8">
                    <Label Text="Service name" Style="{StaticResource lbl13_Bold_FieldLabel}"/>
                    <entry:QueueEntry Placeholder="e.g. Haircut"
                            Text="{Binding Name}"
                            Validator="{Binding NameValidator}"
                            ValidateOnTextChanged="True"/>
                    <Label Text="Already used by another service." Style="{StaticResource lbl13_Regular_Danger}"
                           IsVisible="{Binding HasNameError}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Duration" Style="{StaticResource lbl13_Bold_FieldLabel}"/>
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding DurationChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:DurationChipOption">
                                <Border Style="{StaticResource brd11_Chip_Selectable}" Padding="16,10" Margin="0,0,8,8">
                                    <Label Text="{Binding Label}" Style="{StaticResource lbl13_Regular_TextMid_Selectable}"/>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.SelectDurationChipCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <entry:QueueEntry Placeholder="Minutes"
                            Text="{Binding CustomDurationText}"
                            InputType="Numeric"
                            IsVisible="{Binding IsCustomDurationSelected}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Price" Style="{StaticResource lbl13_Bold_FieldLabel}"/>
                    <entry:QueueEntry Prefix="R" Placeholder="Optional"
                            Text="{Binding PriceRandText}"
                            InputType="Numeric"/>
                    <Label Text="{Binding PriceHelperText}" Style="{StaticResource lbl12_Regular_TextMuted}"/>
                </VerticalStackLayout>

                <Border Style="{StaticResource brd16_Surface}" Padding="14">
                    <Label Text="{Binding PreviewText}" Style="{StaticResource lbl14_Bold_TextDark}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </Border>

                <controls:AlzowLoadingButton
                        Text="Save"
                        LoadingText="Saving…"
                        Margin="0" HeightRequest="56"
                        Command="{Binding SaveCommand}"
                        IsLoading="{Binding IsSaving}"
                        IsEnabled="{Binding IsSaveEnabled}"
                        ButtonStyle="{StaticResource PrimaryButtonStyle}"/>

                <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}" Margin="0,4"
                         IsVisible="{Binding IsEditMode}"/>

                <controls:AlzowLoadingButton
                        Text="Deactivate"
                        LoadingText="Deactivating…"
                        Margin="0"
                        Command="{Binding DeactivateCommand}"
                        IsLoading="{Binding IsDeactivating}"
                        IsVisible="{Binding IsEditMode}"
                        ButtonStyle="{StaticResource btn15_Regular_SheetBad}"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
