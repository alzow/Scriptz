<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             x:Name="Root"
             VerticalOptions="Start"
             x:Class="QueueApp.Features.Settings.Helpers.SettingsHubRowView">

    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="14"
          Padding="4,0" MinimumHeightRequest="62">

        <tpl:ThemedIcon Grid.Column="0" Icon="{Binding Icon, Source={x:Reference Root}}"
               WidthRequest="20" HeightRequest="20"
               HorizontalOptions="Center" VerticalOptions="Center"/>

        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
            <Label Text="{Binding Label, Source={x:Reference Root}}" Style="{StaticResource lbl15_Bold_TextDark}"/>
            <Label Text="{Binding ValueText, Source={x:Reference Root}}"
                   Style="{StaticResource lbl13_Regular_TextLight}"
                   IsVisible="{Binding IsValueMissing, Source={x:Reference Root}, Converter={StaticResource InvertedBoolConverter}}"/>
            <Label Text="{Binding ValueText, Source={x:Reference Root}}"
                   Style="{StaticResource lbl13_Regular_Danger}"
                   IsVisible="{Binding IsValueMissing, Source={x:Reference Root}}"/>
        </VerticalStackLayout>

        <tpl:ThemedIcon Grid.Column="2" Icon="ic_chevron_right" WidthRequest="16" HeightRequest="16"
               Opacity="0.65" VerticalOptions="Center"/>

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}"/>
        </Grid.GestureRecognizers>
    </Grid>
</ContentView>
