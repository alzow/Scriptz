<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Settings"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             x:Class="QueueApp.Features.Settings.BusinessLocationPage"
             x:DataType="vm:BusinessLocationPageViewModel"
             Title="{Binding Title}"
             Style="{StaticResource NavigationPageStyle}">

    <Grid RowDefinitions="Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                       Title="{Binding Title}"
                                       BackCommand="{Binding GoBackCommand}"/>

        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="16">

            <Border Style="{StaticResource brd16_White}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding HasLocation, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Location set|Not set yet'}"
                           Style="{StaticResource lbl15_Bold_TextDark}"/>
                    <Label Text="{Binding CoordinatesText}"
                           Style="{StaticResource lbl13_Regular_TextLight}"
                           IsVisible="{Binding HasLocation}"/>
                    <Label Text="Customers browsing nearby see how far they are from you and can get directions once this is set."
                           Style="{StaticResource lbl13_Regular_TextLight}"
                           IsVisible="{Binding HasLocation, Converter={StaticResource InvertedBoolConverter}}"/>
                </VerticalStackLayout>
            </Border>

            <controls:AlzowLoadingButton
                    Text="{Binding HasLocation, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Update my current location|Use my current location'}"
                    LoadingText="Capturing location…"
                    Command="{Binding CaptureLocationCommand}"
                    IsLoading="{Binding IsCapturing}"
                    ButtonStyle="{StaticResource PrimaryButtonStyle}"/>

            <Label Text="Stand at your business when you tap this — it captures your device's GPS position, not a typed address."
                   Style="{StaticResource lbl12_Regular_TextLight}"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Green}" HorizontalOptions="Center" Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>
