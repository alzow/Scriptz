<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Settings"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             x:Class="QueueApp.Features.Settings.BusinessSettingsPage"
             x:DataType="vm:BusinessSettingsPageViewModel"
             Title="{Binding Title}"
             Style="{StaticResource NavigationPageStyle}">

    <Grid RowDefinitions="Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                       Title="{Binding Title}"
                                       BackCommand="{Binding GoBackCommand}"/>

        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="12">

            <Border Style="{StaticResource brd16_White}" Padding="16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenServicesCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="Services" Style="{StaticResource lbl15_Bold_TextDark}"/>
            </Border>

            <Border Style="{StaticResource brd16_White}" Padding="16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenStaffCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="Staff" Style="{StaticResource lbl15_Bold_TextDark}"/>
            </Border>

            <Border Style="{StaticResource brd16_White}" Padding="16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenHoursCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="Hours" Style="{StaticResource lbl15_Bold_TextDark}"/>
            </Border>

            <Border Style="{StaticResource brd16_White}" Padding="16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenLocationCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="Location" Style="{StaticResource lbl15_Bold_TextDark}"/>
            </Border>

        </VerticalStackLayout>
    </Grid>
</ContentPage>
