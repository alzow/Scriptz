<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Settings"
             xmlns:skeleton="clr-namespace:QueueApp.Shared.Templates.Skeleton"
             xmlns:responses="clr-namespace:QueueApp.Services.Api.Operator.Models"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             x:Name="Root"
             x:Class="QueueApp.Features.Settings.StaffManagementPage"
             x:DataType="vm:StaffManagementPageViewModel"
             Title="{Binding Title}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                       Title="{Binding Title}"
                                       BackCommand="{Binding GoBackCommand}"/>

        <controls:AlzowLoadingButton Grid.Row="1" Text="+ Add staff member"
                LoadingText="Adding…"
                Margin="16" HeightRequest="56"
                Command="{Binding AddOperatorCommand}"
                IsLoading="{Binding IsAddingOperator}">
            <controls:AlzowLoadingButton.ButtonStyle>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                    <Setter Property="Padding" Value="0,16"/>
                </Style>
            </controls:AlzowLoadingButton.ButtonStyle>
        </controls:AlzowLoadingButton>

        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Operators}"
                             IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="responses:OperatorResponse">
                        <!-- ListRow geometry, shared with SkeletonListRowView. -->
                        <Border Style="{StaticResource brd16_ListRow}"
                                Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacityConverter}}">
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource grid_ListRow}">
                                <VerticalStackLayout Grid.Column="0">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.EditOperatorCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding DisplayName}" Style="{StaticResource lbl15_Bold_TextDark}"/>
                                </VerticalStackLayout>
                                <controls:AlzowLoadingButton Grid.Column="1"
                                        Text="{Binding IsActive, Converter={StaticResource ActiveToLabelConverter}}"
                                        LoadingText="Updating…"
                                        Margin="0" HeightRequest="44"
                                        Command="{Binding BindingContext.ToggleActiveCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}"
                                        IsLoading="{Binding IsToggling}">
                                    <controls:AlzowLoadingButton.ButtonStyle>
                                        <Style TargetType="Button" BasedOn="{StaticResource ToggleButtonStyle}">
                                            <Setter Property="Padding" Value="12,12"/>
                                        </Style>
                                    </controls:AlzowLoadingButton.ButtonStyle>
                                </controls:AlzowLoadingButton>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Text="No staff yet — add your first team member above." IsVisible="{Binding IsEmpty}"
                   Style="{StaticResource lbl18_Bold_TextDark}"
                   HorizontalOptions="Center" VerticalOptions="Center"/>

            <Border Style="{StaticResource brd13_Ghost}" Padding="18,20" Margin="20,0"
                    VerticalOptions="Center"
                    IsVisible="{Binding HasLoadFailed}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding LoadFailureText}"
                           Style="{StaticResource lbl12_Regular_TextMuted}"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"/>
                    <Label Text="Try again"
                           Style="{StaticResource lbl13_Bold_Action}"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RetryLoadCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <skeleton:SkeletonList Kind="ListRowPlain"
                                   Count="{x:Static vm:StaffManagementPageViewModel.SkeletonRowCount}"
                                   VerticalOptions="Start"
                                   IsVisible="{Binding IsFirstLoading}"/>
        </Grid>
    </Grid>
</ContentPage>
