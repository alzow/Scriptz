<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Settings"
             xmlns:models="clr-namespace:QueueApp.Features.Settings.Models"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             xmlns:helpers="clr-namespace:QueueApp.Features.Settings.Helpers"
             xmlns:opHelpers="clr-namespace:QueueApp.Features.OperatorQueue.Helpers"
             x:Name="Root"
             x:Class="QueueApp.Features.Settings.StaffManagementPage"
             x:DataType="vm:StaffManagementPageViewModel"
             Title="{Binding Title}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,*">
        <helpers:SettingsHeaderView Grid.Row="0" Title="{Binding Title}" Command="{Binding GoBackCommand}"/>

        <Grid Grid.Row="1">
            <ScrollView IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Padding="16,0,16,24" Spacing="0">

                    <Label Text="Drag the handle to set the order staff appear on the queue board."
                           Style="{StaticResource lbl12_Regular_TextLight}" Margin="4,10,4,4"/>

                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding ActiveStaff}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StaffRow">
                                <Border Style="{StaticResource brd16_White}" Padding="10,14" Margin="0,6"
                                        MinimumHeightRequest="62">
                                    <Grid ColumnDefinitions="44,Auto,*,Auto,Auto" ColumnSpacing="4">

                                        <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44">
                                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                                <BoxView HeightRequest="2" WidthRequest="16" Style="{StaticResource bx_Divider}"/>
                                                <BoxView HeightRequest="2" WidthRequest="16" Style="{StaticResource bx_Divider}"/>
                                                <BoxView HeightRequest="2" WidthRequest="16" Style="{StaticResource bx_Divider}"/>
                                            </VerticalStackLayout>
                                            <Grid.GestureRecognizers>
                                                <DragGestureRecognizer CanDrag="True" DragStarting="OnStaffRowDragStarting"/>
                                            </Grid.GestureRecognizers>
                                        </Grid>

                                        <opHelpers:AvatarView Grid.Column="1" Initials="{Binding Initials}"/>

                                        <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center" Margin="10,0">
                                            <Label Text="{Binding DisplayName}" Style="{StaticResource lbl15_Bold_TextDark}"/>
                                        </VerticalStackLayout>

                                        <Border Grid.Column="3" Style="{StaticResource brd6_Outline}" Padding="8,4" VerticalOptions="Center">
                                            <Label Text="{Binding ShiftText}" Style="{StaticResource lbl11_Regular_TextLight}"/>
                                        </Border>

                                        <tpl:ThemedIcon Grid.Column="4" Icon="ic_chevron_right"
                                               WidthRequest="16" HeightRequest="16" Opacity="0.65"
                                               VerticalOptions="Center" Margin="8,0,0,0"/>
                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <DropGestureRecognizer Drop="OnStaffRowDrop"/>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.EditOperatorCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource brd13_Ghost}" Padding="14" Margin="0,10,0,0">
                        <Label Text="+ Add a staff member" Style="{StaticResource lbl13_Bold_Green}"
                               HorizontalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddOperatorCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <VerticalStackLayout Spacing="0" Margin="0,22,0,0" IsVisible="{Binding HasInactive}">
                        <Grid ColumnDefinitions="*,Auto" Padding="4,10" MinimumHeightRequest="44">
                            <Label Grid.Column="0" Text="{Binding InactiveHeaderText}"
                                   Style="{StaticResource lbl13_Regular_TextLight}" VerticalOptions="Center"/>
                            <tpl:ThemedIcon Grid.Column="1" Icon="{Binding InactiveChevron}"
                                   WidthRequest="16" HeightRequest="16" Opacity="0.65" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleInactiveExpandedCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                        <VerticalStackLayout Spacing="0" IsVisible="{Binding IsInactiveExpanded}"
                                             BindableLayout.ItemsSource="{Binding InactiveStaff}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:StaffRow">
                                    <Border Style="{StaticResource brd16_White}" Padding="14" Margin="0,6"
                                            MinimumHeightRequest="62" Opacity="0.7">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <opHelpers:AvatarView Grid.Column="0" Initials="{Binding Initials}"/>
                                            <Label Grid.Column="1" Text="{Binding DisplayName}"
                                                   Style="{StaticResource lbl15_Bold_TextDark}" VerticalOptions="Center"/>
                                            <controls:AlzowLoadingButton Grid.Column="2" Text="Reactivate"
                                                    LoadingText="Reactivating…"
                                                    Margin="0" HeightRequest="44"
                                                    Command="{Binding BindingContext.ReactivateCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding .}"
                                                    IsLoading="{Binding IsReactivating}"
                                                    ButtonStyle="{StaticResource btn14_Bold_GreenOutline}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="16" Padding="20">
                <Label Text="No staff yet — add your first team member below." Style="{StaticResource lbl18_Bold_TextDark}"
                       HorizontalTextAlignment="Center"/>
                <Border Style="{StaticResource brd13_Ghost}" Padding="14" WidthRequest="220">
                    <Label Text="+ Add a staff member" Style="{StaticResource lbl13_Bold_Green}"
                           HorizontalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddOperatorCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               Style="{StaticResource ai_Purple}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
