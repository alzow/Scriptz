<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Settings"
             xmlns:entry="clr-namespace:QueueApp.Shared.Templates.AlzowEntry"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             x:Class="QueueApp.Features.Settings.AddEditOperatorPage"
             x:DataType="vm:AddEditOperatorPageViewModel"
             Title="{Binding PageTitle}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                       Title="{Binding PageTitle}"
                                       BackCommand="{Binding GoBackCommand}"/>

        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="16">

            <entry:AlzowEntry
                PlaceholderText="Staff member's name"
                EntryText="{Binding DisplayName}"
                Validator="{Binding NameValidator}"
                ValidateOnTextChanged="True"
                SharedStateManager="{Binding FormStateManager}" />

            <entry:AlzowEntry
                PlaceholderText="Display order (0 = first)"
                EntryText="{Binding SortOrderText}"
                InputType="Numeric" />

            <controls:AlzowLoadingButton
                Text="Save"
                Margin="0" HeightRequest="54"
                Command="{Binding SaveCommand}"
                IsLoading="{Binding IsSaving}"
                IsEnabled="{Binding IsFormValid}"
                ButtonStyle="{StaticResource PrimaryButtonStyle}" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>
