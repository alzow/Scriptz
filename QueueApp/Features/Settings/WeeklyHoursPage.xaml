<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Settings"
             xmlns:skeleton="clr-namespace:QueueApp.Shared.Templates.Skeleton"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             xmlns:models="clr-namespace:QueueApp.Services.Api.Operator.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.Settings.WeeklyHoursPage"
             x:DataType="vm:WeeklyHoursPageViewModel"
             Title="{Binding OperatorName}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                       Title="{Binding OperatorName}"
                                       BackCommand="{Binding GoBackCommand}"/>

        <controls:AlzowLoadingButton Grid.Row="1" Text="Blocked dates"
                Margin="16,0,16,8" HeightRequest="48"
                Command="{Binding GoToBlockedDatesCommand}"
                ButtonStyle="{StaticResource TertiaryButtonStyle}"/>

        <Grid Grid.Row="2">
            <ScrollView>
                <VerticalStackLayout Spacing="4"
                                      BindableLayout.ItemsSource="{Binding Days}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DayGroup">
                            <VerticalStackLayout Padding="16,12" Spacing="8">
                                <Label Text="{Binding Label}" Style="{StaticResource lbl15_Bold_TextDark}"/>

                                <VerticalStackLayout Spacing="4"
                                                      BindableLayout.ItemsSource="{Binding Windows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:OperatorAvailabilityResponse">
                                            <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                                <Label Grid.Column="0" Text="{Binding RangeDisplay}"
                                                       Style="{StaticResource lbl14_Regular_TextDark}"
                                                       VerticalOptions="Center"/>
                                                <controls:AlzowLoadingButton Grid.Column="1" Text="Remove"
                                                        LoadingText="Removing…"
                                                        Command="{Binding BindingContext.DeleteWindowCommand, Source={x:Reference Root}}"
                                                        CommandParameter="{Binding .}"
                                                        IsLoading="{Binding IsDeleting}"
                                                        ButtonStyle="{StaticResource TertiaryButtonStyle}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <controls:AlzowLoadingButton Text="+ Add window"
                                        Command="{Binding BindingContext.AddWindowCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding DayOfWeek}"
                                        ButtonStyle="{StaticResource TertiaryButtonStyle}"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <Border Style="{StaticResource brd13_Ghost}" Padding="18,20" Margin="20,0"
                    VerticalOptions="Center"
                    IsVisible="{Binding HasLoadFailed}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding LoadFailureText}"
                           Style="{StaticResource lbl12_Regular_TextMuted}"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"/>
                    <Label Text="Try again"
                           Style="{StaticResource lbl13_Bold_Action}"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RetryLoadCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <skeleton:SkeletonList Kind="ListRowPlain"
                                   Count="{x:Static vm:WeeklyHoursPageViewModel.SkeletonRowCount}"
                                   VerticalOptions="Start"
                                   IsVisible="{Binding IsFirstLoading}"/>
        </Grid>
    </Grid>
</ContentPage>
