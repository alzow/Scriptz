<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Settings"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             xmlns:models="clr-namespace:QueueApp.Services.Api.Operator.Models"
             xmlns:helpers="clr-namespace:QueueApp.Features.Settings.Helpers"
             x:Name="Root"
             x:Class="QueueApp.Features.Settings.WeeklyHoursPage"
             x:DataType="vm:WeeklyHoursPageViewModel"
             Title="{Binding OperatorName}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <helpers:SettingsHeaderView Grid.Row="0" Title="{Binding OperatorName}" Command="{Binding GoBackCommand}"/>

        <Label Grid.Row="1" Text="{Binding SummaryText}" Style="{StaticResource lbl13_Regular_TextLight}"
               Margin="20,0,20,10"/>

        <controls:AlzowLoadingButton Grid.Row="2" Text="Blocked dates"
                Margin="16,0,16,8" HeightRequest="48"
                Command="{Binding GoToBlockedDatesCommand}"
                ButtonStyle="{StaticResource TertiaryButtonStyle}"/>

        <Grid Grid.Row="3">
            <ScrollView>
                <VerticalStackLayout Spacing="4"
                                      BindableLayout.ItemsSource="{Binding Days}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DayGroup">
                            <VerticalStackLayout Padding="16,12" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                                    <Label Grid.Column="0" Text="{Binding Label}" Style="{StaticResource lbl15_Bold_TextDark}"
                                           VerticalOptions="Center"/>
                                    <Switch Grid.Column="1" IsToggled="{Binding IsOpen, Mode=OneWay}"
                                            Toggled="OnDayToggled"/>
                                </Grid>

                                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsOpen}"
                                                      BindableLayout.ItemsSource="{Binding Windows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:OperatorAvailabilityResponse">
                                            <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                                <Label Grid.Column="0" Text="{Binding RangeDisplay}"
                                                       Style="{StaticResource lbl14_Regular_TextDark}"
                                                       VerticalOptions="Center"/>
                                                <controls:AlzowLoadingButton Grid.Column="1" Text="Remove"
                                                        LoadingText="Removing…"
                                                        Command="{Binding BindingContext.DeleteWindowCommand, Source={x:Reference Root}}"
                                                        CommandParameter="{Binding .}"
                                                        IsLoading="{Binding IsDeleting}"
                                                        ButtonStyle="{StaticResource TertiaryButtonStyle}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <HorizontalStackLayout Spacing="16" IsVisible="{Binding IsOpen}">
                                    <controls:AlzowLoadingButton Text="+ add another time"
                                            Command="{Binding BindingContext.AddWindowCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding DayOfWeek}"
                                            ButtonStyle="{StaticResource TertiaryButtonStyle}"/>
                                    <controls:AlzowLoadingButton Text="Copy to all days"
                                            Command="{Binding BindingContext.CopyToAllDaysCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"
                                            ButtonStyle="{StaticResource TertiaryButtonStyle}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
