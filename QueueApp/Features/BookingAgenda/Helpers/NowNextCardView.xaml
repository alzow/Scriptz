<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             VerticalOptions="Start"
             x:Class="QueueApp.Features.BookingAgenda.Helpers.NowNextCardView">

    <Border Style="{StaticResource brd14_Serving}" Margin="18,14,18,0" Padding="13"
            IsVisible="{Binding HasCard, Source={x:Reference Root}}">
        <VerticalStackLayout Spacing="0">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="0">
                    <Label Text="{Binding CardKicker, Source={x:Reference Root}}"
                           Style="{StaticResource lbl9_Mono_Green}" Margin="0,0,0,6"/>
                    <Label Text="{Binding CardName, Source={x:Reference Root}}"
                           Style="{StaticResource lbl17_Bold_TextDark}"/>
                    <Label Text="{Binding CardSubtitle, Source={x:Reference Root}}"
                           Style="{StaticResource lbl12_Regular_TextLight}" Margin="0,4,0,0"/>
                    <Label Text="{Binding CardMeta, Source={x:Reference Root}}"
                           Style="{StaticResource lbl10_Mono_TextFaint}" Margin="0,5,0,0"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="End">
                    <Label Text="{Binding CardTimerText, Source={x:Reference Root}}"
                           Style="{StaticResource lbl20_Mono_Green}" HorizontalOptions="End"/>
                    <Label Text="{Binding CardTimerCaption, Source={x:Reference Root}}"
                           Style="{StaticResource lbl9_Mono_TextFaint}" HorizontalOptions="End"/>
                </VerticalStackLayout>
            </Grid>

            <Button Text="{Binding CardActionText, Source={x:Reference Root}}"
                    Margin="0,12,0,0" HeightRequest="56"
                    HorizontalOptions="Fill"
                    Style="{StaticResource btn16_Bold_Green}"
                    IsEnabled="{Binding IsCardEnabled, Source={x:Reference Root}}"
                    Command="{Binding CardActionCommand, Source={x:Reference Root}}"/>

        </VerticalStackLayout>
    </Border>

</ContentView>
