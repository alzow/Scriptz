<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.BookingAgenda"
             xmlns:models="clr-namespace:QueueApp.Features.BookingAgenda.Models"
             xmlns:helpers="clr-namespace:QueueApp.Features.BookingAgenda.Helpers"
             x:Name="Root"
             Title="Manage"
             IconImageSource="icon_manage_business"
             x:Class="QueueApp.Features.BookingAgenda.BookingAgendaPage"
             x:DataType="vm:BookingAgendaPageViewModel"
             Style="{StaticResource NavigationPageStyle}">

    <Grid Style="{StaticResource grid_Page}"
            RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0" ZIndex="1">

            <helpers:AgendaHeaderView BusinessName="{Binding BusinessName}"
                                      IsOpenNow="{Binding IsOpenNow}"
                                      OpenLabel="{Binding OpenLabel}"
                                      OpenSettingsCommand="{Binding OpenSettingsCommand}"/>

            <helpers:DayStripView Days="{Binding DateOptions}"
                                  SelectDayCommand="{Binding SelectDateCommand}"/>

            <helpers:AgendaStatsBarView BookedCountText="{Binding BookedCountText}"
                                        FreeText="{Binding FreeText}"
                                        RevenueText="{Binding RevenueText}"
                                        RevenueLabel="{Binding RevenueLabel}"
                                        ResourceCountText="{Binding ResourceCountText}"
                                        ResourceCountLabel="{Binding ResourceCountLabel}"/>

            <helpers:RequestsBannerView HasRequests="{Binding HasRequests}"
                                        IsVisible="{Binding HasRequests}"
                                        IsRequestsExpanded="{Binding IsRequestsExpanded}"
                                        RequestsCountText="{Binding RequestsCountText}"
                                        RequestsAgeText="{Binding RequestsAgeText}"
                                        RequestsChevron="{Binding RequestsChevron}"
                                        RequestsStroke="{Binding RequestsStroke}"
                                        RequestsStrokeThickness="{Binding RequestsStrokeThickness}"
                                        Requests="{Binding Requests}"
                                        ToggleRequestsCommand="{Binding ToggleRequestsCommand}"
                                        OpenRequestCommand="{Binding OpenRequestCommand}"
                                        ConfirmRequestCommand="{Binding ConfirmRequestCommand}"
                                        DeclineRequestCommand="{Binding DeclineRequestCommand}"/>

            <helpers:BayFilterBarView HeightRequest="54"
                                      Filters="{Binding BayFilters}"
                                      SelectFilterCommand="{Binding SelectBayCommand}"/>

          
            <Label Text="{Binding AgendaHeaderText}" Margin="18,22,18,6"
                   Style="{StaticResource lbl11_Mono_TextFaint}"/>

        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}"
                VerticalOptions="Fill" ZIndex="0">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AgendaRow">
                    <helpers:AgendaRowView
                        RowTappedCommand="{Binding BindingContext.RowTappedCommand, Source={x:Reference Root}}"
                        FillGapCommand="{Binding BindingContext.FillGapCommand, Source={x:Reference Root}}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Switching day or bay keeps the header and stats in place and only replaces the list, so
             the spinner sits over the list rather than the page. -->
        <ActivityIndicator Grid.Row="1" ZIndex="1"
                           IsRunning="{Binding IsSwitchingDay}"
                           IsVisible="{Binding IsSwitchingDay}"
                           Style="{StaticResource ai_Accent}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>

        <Label Grid.Row="1" ZIndex="1" Margin="40,0"
               IsVisible="{Binding ShowEmptyState}"
               Text="Nothing on the books for this day yet."
               Style="{StaticResource lbl12_Regular_TextMuted}"
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center" VerticalOptions="Center"/>

        <helpers:AgendaFooterView Grid.Row="2"
                                  IsClosedDay="{Binding IsClosedDay}"
                                  ClosedDayText="{Binding ClosedDayText}"
                                  IsQuietDay="{Binding IsQuietDay}"
                                  QuietDayText="{Binding QuietDayText}"
                                  AddBookingCommand="{Binding AddBookingCommand}"
                                  BlockTimeCommand="{Binding BlockTimeCommand}"
                                  ZIndex="2"/>

        <!-- Cold open: there is no header, no stats and no rows behind this yet, so it covers the
             whole page rather than letting empty chrome flash first. -->
        <Grid Grid.Row="0" Grid.RowSpan="3" ZIndex="3"
              IsVisible="{Binding IsInitialLoading}"
              Style="{StaticResource grid_Page}">
            <VerticalStackLayout Spacing="14" HorizontalOptions="Center" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsInitialLoading}"
                                   Style="{StaticResource ai_Accent}"
                                   HorizontalOptions="Center"/>
                <Label Text="LOADING THE DIARY"
                       Style="{StaticResource lbl11_Mono_TextFaint}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
