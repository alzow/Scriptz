<?xml version="1.0" encoding="utf-8" ?>
<popups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:popups="clr-namespace:MPowerKit.Popups;assembly=MPowerKit.Popups"
                  xmlns:sheets="clr-namespace:QueueApp.Features.BookingAgenda.Sheets"
                  xmlns:vm="clr-namespace:QueueApp.Features.BookingAgenda"
                  xmlns:models="clr-namespace:QueueApp.Features.BusinessDetail.Models"
                  xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
                  x:Name="SheetRoot"
                  x:Class="QueueApp.Features.BookingAgenda.Sheets.MoveBookingSheet"
                  x:DataType="sheets:MoveBookingSheetViewModel"
                  BackgroundColor="#B80A0D12"
                  CloseOnBackgroundClick="False"
                  BackgroundClickedCommand="{Binding DismissCommand}">

    <Border VerticalOptions="End" Padding="16,10,16,26"
            BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource Line}" StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="22,22,0,0"/>
        </Border.StrokeShape>

        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <BoxView WidthRequest="38" HeightRequest="4" CornerRadius="2"
                         Color="{StaticResource Line}" HorizontalOptions="Center" Margin="0,0,0,16"/>

                <VerticalStackLayout Spacing="3">
                    <Label Text="{Binding CustomerName, StringFormat='Move {0}'}"
                           FontFamily="RobotoBlack" FontSize="16.5"
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label Text="{Binding CurrentText}"
                           Style="{StaticResource lbl13_Regular_TextMid}" FontSize="11.5"/>
                    <Label Text="{Binding ServiceText}"
                           Style="{StaticResource lbl10_Mono_TextFaint}" Margin="0,3,0,0"/>
                </VerticalStackLayout>

                <Label Text="DAY" Style="{StaticResource lbl9_Mono_TextMuted}" Margin="0,16,0,8"/>
                <Border Style="{StaticResource brd12_Cream}" Padding="10,4">
                    <DatePicker Date="{Binding Date}" MinimumDate="{Binding MinimumDate}"
                                Format="ddd d MMM" FontSize="14.5"
                                TextColor="{StaticResource TextPrimary}"
                                BackgroundColor="Transparent"/>
                </Border>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,16,0,0">
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Resources}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:BayFilterOption">
                                <Border MinimumHeightRequest="42" Padding="14,0"
                                        BackgroundColor="{StaticResource SurfaceRaised}"
                                        Stroke="Transparent" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11"/>
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Green}"/>
                                            <Setter Property="BackgroundColor" Value="{StaticResource GreenSelectedFill}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Label}" VerticalOptions="Center" FontSize="13"
                                           TextColor="{StaticResource TextMuted}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Green}"/>
                                                <Setter Property="FontFamily" Value="RobotoBold"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.SelectResourceCommand, Source={x:Reference SheetRoot}}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- The same slots the customer would be offered, from the same engine. -->
                <Label Text="WHEN" Style="{StaticResource lbl9_Mono_TextMuted}" Margin="0,16,0,9"/>

                <ActivityIndicator IsRunning="{Binding IsLoadingSlots}" IsVisible="{Binding IsLoadingSlots}"
                                   Color="{StaticResource Green}" HorizontalOptions="Center"/>

                <Label Text="Nothing free that day. Try another."
                       IsVisible="{Binding IsEmpty}"
                       Style="{StaticResource lbl13_Regular_TextMid}" FontSize="12.5"/>

                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start"
                            IsVisible="{Binding HasSlots}"
                            BindableLayout.ItemsSource="{Binding Slots}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:SlotChoiceItem">
                            <Border MinimumHeightRequest="42" Padding="14,0" Margin="0,0,8,8"
                                    BackgroundColor="{StaticResource SurfaceRaised}"
                                    Stroke="Transparent" StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Green}"/>
                                        <Setter Property="BackgroundColor" Value="{StaticResource GreenSelectedFill}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding TimeText}" VerticalOptions="Center"
                                       FontSize="13" FontFamily="RobotoMedium"
                                       TextColor="{StaticResource TextMuted}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Green}"/>
                                            <Setter Property="FontFamily" Value="RobotoBold"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectSlotCommand, Source={x:Reference SheetRoot}}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <controls:AlzowLoadingButton
                        Text="Move booking" LoadingText="Moving…"
                        Margin="0,10,0,0" HeightRequest="56"
                        Command="{Binding SubmitCommand}"
                        IsLoading="{Binding IsSaving}"
                        IsEnabled="{Binding CanSubmit}"
                        ButtonStyle="{StaticResource PrimaryButtonStyle}"/>
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</popups:PopupPage>
