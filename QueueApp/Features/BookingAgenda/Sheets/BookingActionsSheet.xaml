<?xml version="1.0" encoding="utf-8" ?>
<popups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:popups="clr-namespace:MPowerKit.Popups;assembly=MPowerKit.Popups"
                  xmlns:sheets="clr-namespace:QueueApp.Features.BookingAgenda.Sheets"
                  xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
                  x:Name="SheetRoot"
                  x:Class="QueueApp.Features.BookingAgenda.Sheets.BookingActionsSheet"
                  x:DataType="sheets:BookingActionsSheetViewModel"
                  BackgroundColor="#B80A0D12"
                  CloseOnBackgroundClick="False"
                  BackgroundClickedCommand="{Binding DismissCommand}">

    <Border VerticalOptions="End" Padding="16,10,16,26"
            BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource Line}" StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="22,22,0,0"/>
        </Border.StrokeShape>

        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <BoxView WidthRequest="38" HeightRequest="4" CornerRadius="2"
                         Color="{StaticResource Line}" HorizontalOptions="Center" Margin="0,0,0,16"/>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" Padding="0"
                            StrokeShape="Ellipse"
                            BackgroundColor="{StaticResource SurfaceRaised}"
                            Stroke="{StaticResource Line}" StrokeThickness="1">
                        <Label Text="{Binding Initials}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               FontFamily="RobotoBold" FontSize="14"
                               TextColor="{StaticResource TextPrimary}"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding CustomerName}"
                               FontFamily="RobotoBlack" FontSize="16.5"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="{Binding WhenText}"
                               Style="{StaticResource lbl13_Regular_TextMid}" FontSize="11.5"/>
                    </VerticalStackLayout>

                    <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" Padding="0"
                            IsVisible="{Binding HasPhone}"
                            BackgroundColor="{StaticResource SurfaceRaised}"
                            Stroke="{StaticResource Line}" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13"/>
                        </Border.StrokeShape>
                        <Image Source="ic_phone" WidthRequest="18" HeightRequest="18"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CallCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,14"/>

                <Border Padding="13,4" Style="{StaticResource brd12_Cream}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,9">
                            <Label Grid.Column="0" Text="Service"
                                   Style="{StaticResource lbl13_Regular_TextMid}" FontSize="12.5"/>
                            <Label Grid.Column="1" Text="{Binding ServiceName}"
                                   FontFamily="RobotoBold" FontSize="12.5"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,9">
                            <Label Grid.Column="0" Text="Price"
                                   Style="{StaticResource lbl13_Regular_TextMid}" FontSize="12.5"/>
                            <Label Grid.Column="1" Text="{Binding PriceText}"
                                   FontFamily="RobotoBold" FontSize="12.5"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,9">
                            <Label Grid.Column="0" Text="Booked"
                                   Style="{StaticResource lbl13_Regular_TextMid}" FontSize="12.5"/>
                            <Label Grid.Column="1" Text="{Binding BookedAgoText}"
                                   FontFamily="RobotoBold" FontSize="12.5"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Optional, quiet — never blocks anything below it. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
                    <Border Grid.Column="0" Style="{StaticResource brd12_Cream}" Padding="4,0">
                        <Entry Text="{Binding ProgressStatus}"
                               Placeholder="What's happening? (optional)"
                               HeightRequest="52" FontSize="13.5"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextFaint}"
                               BackgroundColor="Transparent"/>
                    </Border>
                    <controls:AlzowLoadingButton Grid.Column="1"
                            Text="Save" LoadingText="Saving…"
                            Margin="0" HeightRequest="52"
                            Command="{Binding SaveProgressCommand}"
                            IsLoading="{Binding IsSavingProgress}"
                            ButtonStyle="{StaticResource TertiaryButtonStyle}"/>
                </Grid>

                <!--
                    Plain copy on purpose: "They've arrived — start", not "Check in". This is read at
                    arm's length by someone holding a spanner.
                -->
                <Button Text="{Binding PrimaryActionText}"
                        IsVisible="{Binding HasPrimary}"
                        Margin="0,14,0,0" HeightRequest="56"
                        HorizontalOptions="Fill"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding PrimaryCommand}"/>

                <Button Text="Move to another time"
                        Margin="0,9,0,0" HeightRequest="56"
                        HorizontalOptions="Fill"
                        Style="{StaticResource TertiaryButtonStyle}"
                        Command="{Binding MoveTimeCommand}"/>

                <VerticalStackLayout IsVisible="{Binding HasMoveTargets}" Spacing="0"
                                     BindableLayout.ItemsSource="{Binding MoveTargets}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="sheets:MoveTargetOption">
                            <Button Text="{Binding Label}"
                                    Margin="0,9,0,0" HeightRequest="56"
                                    HorizontalOptions="Fill"
                                    Style="{StaticResource TertiaryButtonStyle}"
                                    Command="{Binding BindingContext.MoveResourceCommand, Source={x:Reference SheetRoot}}"
                                    CommandParameter="{Binding .}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!--
                    The separator is the point: nothing that costs a customer their slot sits
                    adjacent to a constructive action.
                -->
                <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,16,0,4"/>

                <Button Text="Didn't show up"
                        IsVisible="{Binding CanMarkNoShow}"
                        Margin="0,9,0,0" HeightRequest="56"
                        HorizontalOptions="Fill"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Danger}"
                        FontFamily="RobotoBold" FontSize="15" CornerRadius="13"
                        Command="{Binding NoShowCommand}"/>

                <Button Text="Cancel booking"
                        IsVisible="{Binding CanCancel}"
                        Margin="0,4,0,0" HeightRequest="56"
                        HorizontalOptions="Fill"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Danger}"
                        FontFamily="RobotoBold" FontSize="15" CornerRadius="13"
                        Command="{Binding CancelBookingCommand}"/>
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</popups:PopupPage>
