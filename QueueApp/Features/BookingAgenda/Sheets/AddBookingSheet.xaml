<?xml version="1.0" encoding="utf-8" ?>
<bottomsheet:BottomSheetPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:bottomsheet="clr-namespace:QueueApp.Shared.Templates.BottomSheet"
                             xmlns:sheets="clr-namespace:QueueApp.Features.BookingAgenda.Sheets"
                             xmlns:models="clr-namespace:QueueApp.Features.BookingAgenda.Models"
                             x:Name="Root"
                             x:Class="QueueApp.Features.BookingAgenda.Sheets.AddBookingSheet"
                             x:DataType="sheets:AddBookingSheet">

    <Border VerticalOptions="End" Style="{StaticResource brd22_Sheet}" Padding="16,10,16,26">
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <Border Style="{StaticResource brd6_Tag}"
                        BackgroundColor="{StaticResource Line}"
                        WidthRequest="38" HeightRequest="4" Margin="0,0,0,16"
                        HorizontalOptions="Center"/>

                <VerticalStackLayout Spacing="3">
                    <Label Text="Add a booking" Style="{StaticResource lbl16_Bold_TextDark}"/>
                    <Label Text="{Binding WindowText, Source={x:Reference Root}}"
                           Style="{StaticResource lbl11_Regular_TextLight}"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,14"/>

                <Label Text="NAME" Style="{StaticResource lbl9_Mono_TextMuted}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource brd12_Cream}" Padding="4,0">
                    <Entry Text="{Binding CustomerName, Source={x:Reference Root}}"
                           Placeholder="Who's coming in?"
                           Style="{StaticResource entry14_Sheet}"/>
                </Border>

                <Label Text="PHONE — OPTIONAL" Style="{StaticResource lbl9_Mono_TextMuted}" Margin="0,16,0,8"/>
                <Border Style="{StaticResource brd12_Cream}" Padding="4,0">
                    <Entry Text="{Binding Phone, Source={x:Reference Root}}"
                           Placeholder="082 000 0000"
                           Keyboard="Telephone"
                           Style="{StaticResource entry13_SheetMono}"/>
                </Border>

                <Label Text="SERVICE" Style="{StaticResource lbl9_Mono_TextMuted}" Margin="0,16,0,8"/>
                <VerticalStackLayout Spacing="7"
                                     BindableLayout.ItemsSource="{Binding Services, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:AddBookingServiceOption">
                            <Border Style="{StaticResource brd13_Raised}" Padding="14"
                                    MinimumHeightRequest="56"
                                    Opacity="{Binding Opacity}"
                                    Stroke="Transparent" StrokeThickness="1">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Green}"/>
                                        <Setter Property="BackgroundColor" Value="{StaticResource GreenSelectedFill}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center"
                                           Style="{StaticResource lbl14_Bold_TextDark}"/>
                                    <Label Grid.Column="1" Text="{Binding MetaText}" VerticalOptions="Center"
                                           Style="{StaticResource lbl11_Regular_TextLight}"/>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnServiceTapped"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding ResourceLabel, Source={x:Reference Root}}"
                       Style="{StaticResource lbl9_Mono_TextMuted}" Margin="0,16,0,8"/>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding Resources, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:BayFilterOption">
                                <Border Style="{StaticResource brd11_Chip}"
                                        MinimumHeightRequest="42" Padding="14,0">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Green}"/>
                                            <Setter Property="BackgroundColor" Value="{StaticResource GreenSelectedFill}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Label}" VerticalOptions="Center"
                                           Style="{StaticResource lbl13_Regular_TextMid}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Green}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnResourceTapped"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <Border Style="{StaticResource brd13_Raised}" Padding="13,4" Margin="0,16,0,0">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Grid.Column="0" Text="Slot" Style="{StaticResource lbl12_Regular_TextLight}"/>
                            <Label Grid.Column="1" Text="{Binding SlotText, Source={x:Reference Root}}"
                                   Style="{StaticResource lbl12_Bold_TextDark}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Grid.Column="0" Text="Status" Style="{StaticResource lbl12_Regular_TextLight}"/>
                            <Border Grid.Column="1" Style="{StaticResource brd6_Tag}"
                                    BackgroundColor="{StaticResource GreenSelectedFill}" Padding="8,4">
                                <Label Text="{Binding StatusText, Source={x:Reference Root}}"
                                       Style="{StaticResource lbl10_Mono_Green}"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Margin="0,14,0,0"
                       Style="{StaticResource lbl11_Regular_TextFaint}"
                       Text="Added by you, so it's confirmed straight away. No account means no reminder and no notification — take a number if you want to call them."/>

                <Button Text="Add booking" Margin="0,18,0,0"
                        Style="{StaticResource btn15_Bold_SheetGo}"
                        Clicked="OnSubmitClicked"/>

            </VerticalStackLayout>
        </ScrollView>
    </Border>

</bottomsheet:BottomSheetPage>
