<?xml version="1.0" encoding="utf-8" ?>
<popups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:popups="clr-namespace:MPowerKit.Popups;assembly=MPowerKit.Popups"
                  xmlns:sheets="clr-namespace:QueueApp.Features.BookingAgenda.Sheets"
                  xmlns:vm="clr-namespace:QueueApp.Features.BookingAgenda"
                  xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
                  x:Name="SheetRoot"
                  x:Class="QueueApp.Features.BookingAgenda.Sheets.AddBookingSheet"
                  x:DataType="sheets:AddBookingSheetViewModel"
                  BackgroundColor="#B80A0D12"
                  CloseOnBackgroundClick="False"
                  BackgroundClickedCommand="{Binding DismissCommand}">

    <Border VerticalOptions="End" Padding="16,10,16,26"
            BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource Line}" StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="22,22,0,0"/>
        </Border.StrokeShape>

        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <BoxView WidthRequest="38" HeightRequest="4" CornerRadius="2"
                         Color="{StaticResource Line}" HorizontalOptions="Center" Margin="0,0,0,16"/>

                <VerticalStackLayout Spacing="3">
                    <Label Text="Add a booking"
                           FontFamily="RobotoBlack" FontSize="16.5"
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label Text="{Binding WindowText}"
                           Style="{StaticResource lbl13_Regular_TextMid}" FontSize="11.5"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,14"/>

                <Label Text="NAME" Style="{StaticResource lbl9_Mono_TextMuted}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource brd12_Cream}" Padding="4,0">
                    <Entry Text="{Binding CustomerName}" Placeholder="Who's coming in?"
                           HeightRequest="52" FontSize="14.5"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextFaint}"
                           BackgroundColor="Transparent"/>
                </Border>

                <Label Text="PHONE — OPTIONAL" Style="{StaticResource lbl9_Mono_TextMuted}" Margin="0,16,0,8"/>
                <Border Style="{StaticResource brd12_Cream}" Padding="4,0">
                    <Entry Text="{Binding Phone}" Placeholder="082 000 0000"
                           Keyboard="Telephone"
                           HeightRequest="52" FontSize="13" FontFamily="RobotoMedium"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextFaint}"
                           BackgroundColor="Transparent"/>
                </Border>

                <Label Text="SERVICE" Style="{StaticResource lbl9_Mono_TextMuted}" Margin="0,16,0,8"/>
                <VerticalStackLayout Spacing="7" BindableLayout.ItemsSource="{Binding Services}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="sheets:AddBookingServiceOption">
                            <!--
                                A service that doesn't fit the window is dimmed and labelled "won't
                                fit", never hidden — hiding it makes the operator wonder whether the
                                service still exists at all.
                            -->
                            <Border Padding="14" MinimumHeightRequest="56"
                                    Opacity="{Binding Opacity}"
                                    BackgroundColor="{StaticResource SurfaceRaised}"
                                    Stroke="Transparent" StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Green}"/>
                                        <Setter Property="BackgroundColor" Value="{StaticResource GreenSelectedFill}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center"
                                           FontFamily="RobotoBold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Grid.Column="1" Text="{Binding MetaText}" VerticalOptions="Center"
                                           Style="{StaticResource lbl10_Mono_TextMuted}" FontSize="11.5"/>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectServiceCommand, Source={x:Reference SheetRoot}}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding ResourceLabel}" Style="{StaticResource lbl9_Mono_TextMuted}" Margin="0,16,0,8"/>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Resources}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:BayFilterOption">
                                <Border MinimumHeightRequest="42" Padding="14,0"
                                        BackgroundColor="{StaticResource SurfaceRaised}"
                                        Stroke="Transparent" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11"/>
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Green}"/>
                                            <Setter Property="BackgroundColor" Value="{StaticResource GreenSelectedFill}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Label}" VerticalOptions="Center" FontSize="13"
                                           TextColor="{StaticResource TextMuted}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Green}"/>
                                                <Setter Property="FontFamily" Value="RobotoBold"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.SelectResourceCommand, Source={x:Reference SheetRoot}}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- The slot and the end time it produces, before anything is committed. -->
                <Border Style="{StaticResource brd12_Cream}" Padding="13,4" Margin="0,16,0,0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Grid.Column="0" Text="Slot"
                                   Style="{StaticResource lbl13_Regular_TextMid}" FontSize="12.5"/>
                            <Label Grid.Column="1" Text="{Binding SlotText}"
                                   FontFamily="RobotoBold" FontSize="12.5"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Grid.Column="0" Text="Status"
                                   Style="{StaticResource lbl13_Regular_TextMid}" FontSize="12.5"/>
                            <Border Grid.Column="1" Padding="8,4" StrokeThickness="0"
                                    BackgroundColor="{StaticResource GreenSelectedFill}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding StatusText}" Style="{StaticResource lbl10_Mono_Green}"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Margin="0,14,0,0" FontSize="11.5" LineHeight="1.4"
                       TextColor="{StaticResource TextFaint}"
                       Text="Added by you, so it's confirmed straight away. No account means no reminder and no notification — take a number if you want to call them."/>

                <controls:AlzowLoadingButton
                        Text="Add booking" LoadingText="Adding…"
                        Margin="0,18,0,0" HeightRequest="56"
                        Command="{Binding SubmitCommand}"
                        IsLoading="{Binding IsSaving}"
                        IsEnabled="{Binding CanSubmit}"
                        ButtonStyle="{StaticResource PrimaryButtonStyle}"/>
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</popups:PopupPage>
