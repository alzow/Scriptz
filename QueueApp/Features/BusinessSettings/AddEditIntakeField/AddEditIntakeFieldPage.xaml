<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.BusinessSettings.AddEditIntakeField"
             xmlns:models="clr-namespace:QueueApp.Shared.Domain.Models"
             xmlns:entry="clr-namespace:QueueApp.Shared.Templates.QueueEntry"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.AlzowLoadingButton"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessSettings.AddEditIntakeField.AddEditIntakeFieldPage"
             x:DataType="vm:AddEditIntakeFieldPageViewModel"
             Title="{Binding PageTitle}"
             Style="{StaticResource NavigationPageStyle}">

    <Grid RowDefinitions="Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                      Title="{Binding PageTitle}"
                                      BackCommand="{Binding GoBackCommand}"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <Label Text="What kind of answer?" Style="{StaticResource lbl15_Bold_TextDark}"/>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding TypeOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:IntakeTypeOption">
                                <Border Style="{StaticResource brd11_Chip_Selectable}"
                                        MinimumHeightRequest="42" Padding="14,0">
                                    <Label Text="{Binding Name}" VerticalOptions="Center"
                                           Style="{StaticResource lbl13_Regular_TextMid_Selectable}"/>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.SelectTypeCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <entry:QueueEntry
                    Placeholder="The question, as the customer sees it"
                    Text="{Binding Label}"
                    Validator="{Binding LabelValidator}"
                    ValidateOnTextChanged="True"/>

                <HorizontalStackLayout Spacing="10">
                    <Switch IsToggled="{Binding IsRequired}"/>
                    <Label Text="Must be answered" Style="{StaticResource lbl15_Bold_TextDark}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Only the two select types have anything to choose from. -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowOptions}">

                    <Label Text="Choices" Style="{StaticResource lbl15_Bold_TextDark}"/>

                    <VerticalStackLayout Spacing="8"
                                         BindableLayout.ItemsSource="{Binding Options}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:IntakeOptionRow">
                                <Border Padding="12" Style="{StaticResource brd14_Row}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label Grid.Column="0" Text="{Binding Text}"
                                               VerticalOptions="Center"
                                               Style="{StaticResource lbl14_Regular_TextDark}"/>
                                        <Border Grid.Column="1" WidthRequest="30" HeightRequest="30"
                                                Style="{StaticResource brd26_GhostCircle}"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.RemoveOptionCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <tpl:ThemedIcon Icon="ic_close" WidthRequest="12" HeightRequest="12"
                                                            HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Add at least two choices." Style="{StaticResource lbl12_Regular_TextMuted}"
                           IsVisible="{Binding NeedsMoreOptions}"/>

                    <entry:QueueEntry
                        Placeholder="Add a choice"
                        Text="{Binding NewOptionText}"/>

                    <controls:AlzowLoadingButton
                        Text="+ Add choice"
                        Margin="0" HeightRequest="48"
                        Command="{Binding AddOptionCommand}"
                        ButtonStyle="{StaticResource SecondaryButtonStyle}"/>

                </VerticalStackLayout>

                <controls:AlzowLoadingButton
                    Text="Save"
                    LoadingText="Saving…"
                    Margin="0,8,0,0" HeightRequest="54"
                    Command="{Binding SaveCommand}"
                    IsLoading="{Binding IsSaving}"
                    ButtonStyle="{StaticResource PrimaryButtonStyle}"/>

                <!-- Deleting a question never touches answers already given to it: those carry the
                     question they were asked. -->
                <controls:AlzowLoadingButton
                    Text="Delete question"
                    LoadingText="Deleting…"
                    Margin="0" HeightRequest="48"
                    IsVisible="{Binding IsEditing}"
                    Command="{Binding DeleteCommand}"
                    IsLoading="{Binding IsDeleting}"
                    ButtonStyle="{StaticResource DangerButtonStyle}"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
