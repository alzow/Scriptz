<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.BusinessSettings.AddEditIntakeField"
             xmlns:models="clr-namespace:QueueApp.Shared.Domain.Models"
             xmlns:helpers="clr-namespace:QueueApp.Features.BusinessSettings.Helpers"
             xmlns:consts="clr-namespace:QueueApp.Features.BusinessSettings.Constants"
             xmlns:entry="clr-namespace:QueueApp.Shared.Templates.QueueEntry"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.AlzowLoadingButton"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessSettings.AddEditIntakeField.AddEditIntakeFieldPage"
             x:DataType="vm:AddEditIntakeFieldPageViewModel"
             Title="{Binding PageTitle}"
             Style="{StaticResource NavigationPageStyle}">

    <Grid RowDefinitions="Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                      Title="{Binding PageTitle}"
                                      BackCommand="{Binding GoBackCommand}"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,10,18,30" Spacing="18">

                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static consts:IntakeQuestionConstants.PromptLabel}"
                           Style="{StaticResource lbl11_Bold_GroupHeader}"/>
                    <entry:QueueEntry
                        Placeholder="{x:Static consts:IntakeQuestionConstants.PromptPlaceholder}"
                        Text="{Binding Label}"
                        Validator="{Binding LabelValidator}"
                        ValidateOnTextChanged="True"/>
                    <Label Text="{x:Static consts:IntakeQuestionConstants.PromptHint}"
                           Style="{StaticResource lbl11_Regular_TextMuted}"/>
                </VerticalStackLayout>

                <!-- An example under a registration field prevents most of the bad answers a shop
                     would otherwise have to phone about. -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static consts:IntakeQuestionConstants.HintLabel}"
                           Style="{StaticResource lbl11_Bold_GroupHeader}"/>
                    <entry:QueueEntry
                        Placeholder="{x:Static consts:IntakeQuestionConstants.HintPlaceholder}"
                        Text="{Binding Hint}"/>
                    <Label Text="{x:Static consts:IntakeQuestionConstants.HintExplainer}"
                           Style="{StaticResource lbl11_Regular_TextMuted}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="9">
                    <Label Text="{x:Static consts:IntakeQuestionConstants.KindLabel}"
                           Style="{StaticResource lbl11_Bold_GroupHeader}"/>
                    <helpers:IntakeKindChipsView
                        Options="{Binding TypeOptions}"
                        SelectCommand="{Binding SelectTypeCommand}"/>
                </VerticalStackLayout>

                <Border Style="{StaticResource brd14_PurpleTint}" Padding="13"
                        IsVisible="{Binding ShowFileWarning}">
                    <HorizontalStackLayout Spacing="10">
                        <tpl:ThemedIcon Icon="ic_lock" WidthRequest="16" HeightRequest="16"
                                        VerticalOptions="Start" Margin="0,2,0,0"/>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static consts:IntakeQuestionConstants.FileWarningTitle}"
                                   Style="{StaticResource lbl12_Bold_TextDark}"/>
                            <Label Text="{x:Static consts:IntakeQuestionConstants.FileWarningBody}"
                                   Style="{StaticResource lbl11_Regular_TextMuted}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <Border Style="{StaticResource brd16_Surface}" Padding="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="{x:Static consts:IntakeQuestionConstants.RequiredToggleTitle}"
                                   Style="{StaticResource lbl14_Bold_TextDark}"/>
                            <Label Text="{x:Static consts:IntakeQuestionConstants.RequiredToggleSubtitle}"
                                   Style="{StaticResource lbl12_Regular_TextMuted}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsRequired}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Only the select types have anything to choose from. -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowOptions}">

                    <Label Text="{x:Static consts:IntakeQuestionConstants.OptionsLabel}"
                           Style="{StaticResource lbl11_Bold_GroupHeader}"/>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:IntakeOptionRow">
                                <Border Style="{StaticResource brd13_Raised_Lined}" Padding="12,0"
                                        MinimumHeightRequest="54" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label Grid.Column="0" Text="{Binding Text}"
                                               VerticalOptions="Center"
                                               Style="{StaticResource lbl14_Regular_TextDark}"/>
                                        <Border Grid.Column="1" WidthRequest="32" HeightRequest="32"
                                                Style="{StaticResource brd26_GhostCircle}"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.RemoveOptionCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <tpl:ThemedIcon Icon="ic_close" WidthRequest="12" HeightRequest="12"
                                                            HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{x:Static consts:IntakeQuestionConstants.OptionsTooFew}"
                           Style="{StaticResource lbl12_Regular_TextMuted}"
                           IsVisible="{Binding NeedsMoreOptions}"/>

                    <entry:QueueEntry
                        Placeholder="{x:Static consts:IntakeQuestionConstants.NewOptionPlaceholder}"
                        Text="{Binding NewOptionText}"/>

                    <helpers:GhostAddRowView
                        Text="{x:Static consts:IntakeQuestionConstants.AddOptionText}"
                        Command="{Binding AddOptionCommand}"/>

                </VerticalStackLayout>

                <!-- Only offered once an earlier single/multi-select question exists to hang this
                     one off. -->
                <VerticalStackLayout Spacing="9" IsVisible="{Binding Rule.HasCandidates}">

                    <Label Text="{x:Static consts:IntakeQuestionConstants.WhenToAskLabel}"
                           Style="{StaticResource lbl11_Bold_GroupHeader}"/>

                    <helpers:ChoiceRowView
                        Text="{x:Static consts:IntakeQuestionConstants.AlwaysText}"
                        IsSelected="{Binding Rule.IsAlways}"
                        Command="{Binding ChooseAlwaysCommand}"/>

                    <helpers:ChoiceRowView
                        Text="{x:Static consts:IntakeQuestionConstants.ConditionalText}"
                        IsSelected="{Binding Rule.HasCondition}"
                        Command="{Binding ChooseConditionalCommand}"/>

                    <helpers:IntakeRuleBuilderView
                        IsVisible="{Binding Rule.HasCondition}"
                        QuestionText="{Binding Rule.QuestionText}"
                        ValueText="{Binding Rule.ValueText}"
                        PickQuestionCommand="{Binding PickRuleQuestionCommand}"
                        PickValueCommand="{Binding PickRuleValueCommand}"/>

                </VerticalStackLayout>

                <controls:AlzowLoadingButton
                    Text="{x:Static consts:IntakeQuestionConstants.SaveText}"
                    LoadingText="{x:Static consts:IntakeQuestionConstants.SavingText}"
                    BypassIsLoading="True"
                    Margin="0,4,0,0" HeightRequest="56"
                    Command="{Binding SaveCommand}"
                    IsLoading="{Binding IsSaving}"
                    ButtonStyle="{StaticResource PrimaryButtonStyle}"/>

                <!-- Everything destructive lives below this line. Deleting a question never touches
                     answers already given to it: those carry the question they were asked. -->
                <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}"
                         IsVisible="{Binding IsEditing}"/>

                <controls:AlzowLoadingButton
                    Text="{x:Static consts:IntakeQuestionConstants.DeleteText}"
                    LoadingText="{x:Static consts:IntakeQuestionConstants.DeletingText}"
                    BypassIsLoading="True"
                    Margin="0" HeightRequest="56"
                    IsVisible="{Binding IsEditing}"
                    Command="{Binding DeleteCommand}"
                    IsLoading="{Binding IsDeleting}"
                    ButtonStyle="{StaticResource DangerButtonStyle}"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
