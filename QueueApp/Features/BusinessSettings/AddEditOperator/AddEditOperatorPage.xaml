<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.BusinessSettings.AddEditOperator"
             xmlns:entry="clr-namespace:QueueApp.Shared.Templates.QueueEntry"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.AlzowLoadingButton"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             x:Class="QueueApp.Features.BusinessSettings.AddEditOperator.AddEditOperatorPage"
             x:DataType="vm:AddEditOperatorPageViewModel"
             Title="{Binding PageTitle}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                       Title="{Binding PageTitle}"
                                       BackCommand="{Binding GoBackCommand}"/>

        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="16">

            <entry:QueueEntry
                Placeholder="Staff member's name"
                Text="{Binding DisplayName}"
                Validator="{Binding NameValidator}"
                ValidateOnTextChanged="True" />

            <entry:QueueEntry
                Placeholder="Display order (0 = first)"
                Text="{Binding SortOrderText}"
                InputType="Numeric" />

            <controls:AlzowLoadingButton
                Text="Save"
                LoadingText="Saving…"
                Margin="0" HeightRequest="54"
                Command="{Binding SaveCommand}"
                IsLoading="{Binding IsSaving}"
                ButtonStyle="{StaticResource PrimaryButtonStyle}" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>
