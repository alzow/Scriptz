<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.BusinessSettings.AddEditService"
             xmlns:entry="clr-namespace:QueueApp.Shared.Templates.QueueEntry"
             xmlns:models="clr-namespace:QueueApp.Services.Api.Intake.Models"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.AlzowLoadingButton"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessSettings.AddEditService.AddEditServicePage"
             x:DataType="vm:AddEditServicePageViewModel"
             Title="{Binding PageTitle}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                       Title="{Binding PageTitle}"
                                       BackCommand="{Binding GoBackCommand}"/>

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="16">

            <entry:QueueEntry
                Placeholder="Service name"
                Text="{Binding Name}"
                Validator="{Binding NameValidator}"
                ValidateOnTextChanged="True" />

            <entry:QueueEntry
                Placeholder="Duration (minutes)"
                Text="{Binding DurationMinutesText}"
                InputType="Numeric"
                Validator="{Binding DurationValidator}"
                ValidateOnTextChanged="True" />

            <entry:QueueEntry
                Placeholder="Price in Rand (optional)"
                Text="{Binding PriceRandText}"
                InputType="Numeric" />

            <controls:AlzowLoadingButton
                Text="Save"
                BypassIsLoading="True"
                LoadingText="Saving…"
                Margin="0" HeightRequest="54"
                Command="{Binding SaveCommand}"
                IsLoading="{Binding IsSaving}"
                ButtonStyle="{StaticResource PrimaryButtonStyle}" />

            <!--
                What this service asks for before someone can join or book it. A service with none —
                which is most of them — shows an empty list and changes nothing about its flow.
            -->
            <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}" Margin="0,8"/>

            <Label Text="Before they join" Style="{StaticResource lbl15_Bold_TextDark}"/>
            <Label Text="Questions the customer answers on the way in, so you can have it ready."
                   Style="{StaticResource lbl12_Regular_TextMuted}"/>

            <!-- There is no service id to hang a question off until the service itself exists. -->
            <Label Text="Save this service first, then you can add questions to it."
                   IsVisible="{Binding IsNewService}"
                   Style="{StaticResource lbl12_Regular_TextMuted}"/>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEditingService}">

                <VerticalStackLayout Spacing="8"
                                     BindableLayout.ItemsSource="{Binding IntakeFields}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:IntakeFieldResponse">
                            <Border Padding="12" Style="{StaticResource brd14_Row}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.EditFieldCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding .}"/>
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding Label}" Style="{StaticResource lbl14_Bold_TextDark}"/>
                                        <Label Text="{Binding SummaryText}" Style="{StaticResource lbl12_Regular_TextLight}"/>
                                        <Label Text="{Binding OptionsText}"
                                               IsVisible="{Binding OptionsText, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                               Style="{StaticResource lbl11_Mono_TextMuted}"/>
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1" WidthRequest="30" HeightRequest="30"
                                            Style="{StaticResource brd26_GhostCircle}" VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.MoveFieldUpCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="↑" HorizontalOptions="Center" VerticalOptions="Center"
                                               Style="{StaticResource lbl13_Mono_TextMuted}"/>
                                    </Border>

                                    <Border Grid.Column="2" WidthRequest="30" HeightRequest="30"
                                            Style="{StaticResource brd26_GhostCircle}" VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.MoveFieldDownCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="↓" HorizontalOptions="Center" VerticalOptions="Center"
                                               Style="{StaticResource lbl13_Mono_TextMuted}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Nothing asked yet — this service joins straight away."
                       IsVisible="{Binding HasNoIntakeFields}"
                       Style="{StaticResource lbl12_Regular_TextMuted}"/>

                <controls:AlzowLoadingButton
                    Text="+ Add question"
                    Margin="0" HeightRequest="48"
                    Command="{Binding AddFieldCommand}"
                    BypassIsLoading="True"
                    ButtonStyle="{StaticResource SecondaryButtonStyle}"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
