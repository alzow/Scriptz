<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.BusinessSettings.AddEditService"
             xmlns:models="clr-namespace:QueueApp.Features.BusinessSettings.Models"
             xmlns:helpers="clr-namespace:QueueApp.Features.BusinessSettings.Helpers"
             xmlns:consts="clr-namespace:QueueApp.Features.BusinessSettings.Constants"
             xmlns:entry="clr-namespace:QueueApp.Shared.Templates.QueueEntry"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.AlzowLoadingButton"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessSettings.AddEditService.AddEditServicePage"
             x:DataType="vm:AddEditServicePageViewModel"
             Title="{Binding PageTitle}"
             Style="{StaticResource NavigationPageStyle}">

    <Grid RowDefinitions="Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                      Title="{Binding PageTitle}"
                                      BackCommand="{Binding GoBackCommand}"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,4,18,30" Spacing="0">

                <Label Text="{x:Static consts:BusinessSettingsConstants.DetailsPanelTitle}"
                       Style="{StaticResource lbl11_Bold_GroupHeader}" Margin="2,16,0,9"/>

                <Border Style="{StaticResource brd16_Surface}" Padding="14">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="9">
                            <Label Text="{x:Static consts:BusinessSettingsConstants.NameLabel}"
                                   Style="{StaticResource lbl13_Regular_TextMid}"/>

                            <entry:QueueEntry
                                Placeholder="{x:Static consts:BusinessSettingsConstants.NamePlaceholder}"
                                Text="{Binding Name}"
                                Validator="{Binding NameValidator}"
                                ValidateOnTextChanged="True"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="9">
                            <Label Text="{x:Static consts:BusinessSettingsConstants.DurationLabel}"
                                   Style="{StaticResource lbl13_Regular_TextMid}"/>

                            <helpers:DurationChipsView
                                Options="{Binding Duration.Choices}"
                                SelectCommand="{Binding SelectDurationCommand}"/>

                            <entry:QueueEntry
                                IsVisible="{Binding Duration.IsCustom}"
                                Placeholder="{x:Static consts:BusinessSettingsConstants.CustomDurationPlaceholder}"
                                Text="{Binding Duration.CustomMinutesText}"
                                InputType="Numeric"/>

                            <!-- Wait estimates are built on this number, so what it does and does
                                 not include has to be said here. -->
                            <Label Text="{x:Static consts:BusinessSettingsConstants.DurationHint}"
                                   Style="{StaticResource lbl11_Regular_TextMuted}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="9">
                            <Label Text="{x:Static consts:BusinessSettingsConstants.PriceLabel}"
                                   Style="{StaticResource lbl13_Regular_TextMid}"/>

                            <entry:QueueEntry
                                Placeholder="{x:Static consts:BusinessSettingsConstants.PricePlaceholder}"
                                Text="{Binding PriceRandText}"
                                InputType="Numeric"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Label Text="{x:Static consts:BusinessSettingsConstants.WorkflowPanelTitle}"
                       Style="{StaticResource lbl11_Bold_GroupHeader}" Margin="2,22,0,9"/>

                <Border Style="{StaticResource brd16_Surface}" Padding="14">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <Label Text="{x:Static consts:BusinessSettingsConstants.CollectionToggleTitle}"
                                       Style="{StaticResource lbl14_Bold_TextDark}"/>
                                <Label Text="{x:Static consts:BusinessSettingsConstants.CollectionToggleSubtitle}"
                                       Style="{StaticResource lbl12_Regular_TextMuted}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding RequiresCollection}"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <helpers:CollectionFlowView IsVisible="{Binding RequiresCollection}"/>

                    </VerticalStackLayout>
                </Border>

                <controls:AlzowLoadingButton
                    Text="{Binding SaveText}"
                    LoadingText="{x:Static consts:BusinessSettingsConstants.SavingText}"
                    BypassIsLoading="True"
                    Margin="0,20,0,0" HeightRequest="56"
                    Command="{Binding SaveCommand}"
                    IsLoading="{Binding IsSaving}"
                    ButtonStyle="{StaticResource PrimaryButtonStyle}"/>

                <Label Text="{x:Static consts:BusinessSettingsConstants.QuestionsPanelTitle}"
                       Style="{StaticResource lbl11_Bold_GroupHeader}" Margin="2,26,0,9"/>

                <HorizontalStackLayout Spacing="9" Margin="0,0,0,12">
                    <tpl:ThemedIcon Icon="ic_info" WidthRequest="14" HeightRequest="14"
                                    VerticalOptions="Start" Margin="0,2,0,0"/>
                    <Label Text="{x:Static consts:BusinessSettingsConstants.QuestionsHint}"
                           Style="{StaticResource lbl12_Regular_TextMuted}"/>
                </HorizontalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Questions.Rows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:IntakeQuestionRow">
                            <helpers:IntakeQuestionRowView
                                Prompt="{Binding Prompt}"
                                SummaryText="{Binding SummaryText}"
                                ConditionText="{Binding ConditionText}"
                                HasCondition="{Binding HasCondition}"
                                CommandParameter="{Binding .}"
                                EditCommand="{Binding BindingContext.EditQuestionCommand, Source={x:Reference Root}}"
                                MoveUpCommand="{Binding BindingContext.MoveQuestionUpCommand, Source={x:Reference Root}}"
                                MoveDownCommand="{Binding BindingContext.MoveQuestionDownCommand, Source={x:Reference Root}}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{x:Static consts:BusinessSettingsConstants.QuestionsEmpty}"
                       IsVisible="{Binding Questions.IsEmpty}"
                       Style="{StaticResource lbl12_Regular_TextMuted}"
                       Margin="2,0,0,10"/>

                <helpers:GhostAddRowView
                    Text="{x:Static consts:BusinessSettingsConstants.AddQuestionText}"
                    Command="{Binding AddQuestionCommand}"/>

                <!-- What the questions cost the one flow that has to stay easy. An owner adding a
                     seventh should be able to see what they are doing to the customer. -->
                <Border Style="{StaticResource brd14_PurpleTint}" Padding="14"
                        Margin="0,18,0,0"
                        IsVisible="{Binding Questions.HasQuestions}">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="{x:Static consts:BusinessSettingsConstants.PreviewHeader}"
                               Style="{StaticResource lbl10_Mono_PurpleTag}"/>
                        <Label Text="{Binding Questions.SummaryLine}"
                               Style="{StaticResource lbl15_Bold_TextDark}"/>
                        <Label Text="{Binding Questions.CostLine}"
                               Style="{StaticResource lbl12_Regular_TextMuted}"/>
                    </VerticalStackLayout>
                </Border>

                <controls:AlzowLoadingButton
                    Text="{x:Static consts:BusinessSettingsConstants.PreviewFormText}"
                    BypassIsLoading="True"
                    Margin="0,10,0,0" HeightRequest="52"
                    IsVisible="{Binding Questions.HasQuestions}"
                    Command="{Binding PreviewFormCommand}"
                    ButtonStyle="{StaticResource SecondaryButtonStyle}"/>

                <!-- Everything destructive lives below this line. -->
                <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}"
                         Margin="0,26,0,0"
                         IsVisible="{Binding IsExistingService}"/>

                <controls:AlzowLoadingButton
                    Text="{Binding DeactivateText}"
                    BypassIsLoading="True"
                    Margin="0,16,0,0" HeightRequest="56"
                    IsVisible="{Binding IsExistingService}"
                    Command="{Binding ToggleActiveCommand}"
                    IsLoading="{Binding IsDeactivating}"
                    ButtonStyle="{StaticResource DangerButtonStyle}"/>

                <Label Text="{x:Static consts:BusinessSettingsConstants.DeactivateFootnote}"
                       IsVisible="{Binding IsExistingService}"
                       Style="{StaticResource lbl11_Regular_TextMuted}"
                       HorizontalTextAlignment="Center"
                       Margin="12,10,12,0"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
