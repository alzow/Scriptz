<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.BusinessSettings.ServicesManagement"
             xmlns:responses="clr-namespace:QueueApp.Services.Api.ServiceOfferings.Models"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.AlzowLoadingButton"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessSettings.ServicesManagement.ServicesManagementPage"
             x:DataType="vm:ServicesManagementPageViewModel"
             Title="{Binding Title}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                       Title="{Binding Title}"
                                       BackCommand="{Binding GoBackCommand}"/>

        <controls:AlzowLoadingButton Grid.Row="1" Text="+ Add service"
                LoadingText="Adding…"
                Margin="16" HeightRequest="56"
                Command="{Binding AddServiceCommand}"
                IsLoading="{Binding IsAddingService}">
            <controls:AlzowLoadingButton.ButtonStyle>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                    <Setter Property="Padding" Value="0,16"/>
                </Style>
            </controls:AlzowLoadingButton.ButtonStyle>
        </controls:AlzowLoadingButton>

        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Services}"
                             IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="responses:ServiceResponse">
                        <Border Style="{StaticResource brd16_White}"
                                Padding="14" Margin="12,6"
                                Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacityConverter}}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.EditServiceCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding Name}" Style="{StaticResource lbl15_Bold_TextDark}"/>
                                    <Label FontSize="13" TextColor="Gray">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding EstMinutes}"/>
                                                <Span Text=" min · "/>
                                                <Span Text="{Binding PriceDisplay}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <controls:AlzowLoadingButton Grid.Column="1"
                                        Text="{Binding IsActive, Converter={StaticResource ActiveToLabelConverter}}"
                                        LoadingText="Updating…"
                                        Margin="0" HeightRequest="44"
                                        Command="{Binding BindingContext.ToggleActiveCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}"
                                        IsLoading="{Binding IsToggling}">
                                    <controls:AlzowLoadingButton.ButtonStyle>
                                        <Style TargetType="Button" BasedOn="{StaticResource ToggleButtonStyle}">
                                            <Setter Property="Padding" Value="12,12"/>
                                        </Style>
                                    </controls:AlzowLoadingButton.ButtonStyle>
                                </controls:AlzowLoadingButton>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Text="No services yet — add your first one above." IsVisible="{Binding IsEmpty}"
                   Style="{StaticResource lbl18_Bold_TextDark}"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               Style="{StaticResource ai_Purple}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
