<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.BusinessSettings.ServicesManagement"
             xmlns:models="clr-namespace:QueueApp.Features.BusinessSettings.Models"
             xmlns:helpers="clr-namespace:QueueApp.Features.BusinessSettings.Helpers"
             xmlns:consts="clr-namespace:QueueApp.Features.BusinessSettings.Constants"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessSettings.ServicesManagement.ServicesManagementPage"
             x:DataType="vm:ServicesManagementPageViewModel"
             Title="{Binding Title}"
             Style="{StaticResource NavigationPageStyle}">

    <Grid RowDefinitions="Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                      Title="{Binding Title}"
                                      BackCommand="{Binding GoBackCommand}"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,4,18,28" Spacing="0">

                <HorizontalStackLayout Spacing="9" Margin="0,10,0,14">
                    <tpl:ThemedIcon Icon="ic_info" WidthRequest="14" HeightRequest="14"
                                    VerticalOptions="Start" Margin="0,2,0,0"/>
                    <Label Text="{x:Static consts:BusinessSettingsConstants.ServicesHint}"
                           Style="{StaticResource lbl12_Regular_TextMuted}"/>
                </HorizontalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Services}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ServiceRow">
                            <helpers:ServiceRowView
                                ServiceName="{Binding Name}"
                                DetailText="{Binding DetailText}"
                                HasQuestions="{Binding HasQuestions}"
                                QuestionChipText="{Binding QuestionChipText}"
                                RequiresCollection="{Binding RequiresCollection}"
                                TapCommand="{Binding BindingContext.EditServiceCommand, Source={x:Reference Root}}"
                                TapCommandParameter="{Binding .}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{x:Static consts:BusinessSettingsConstants.ServicesEmpty}"
                       IsVisible="{Binding IsEmpty}"
                       Style="{StaticResource lbl14_Regular_TextLight}"
                       HorizontalOptions="Center" Margin="0,26"/>

                <!-- The rarest action is a dashed invitation at the end of the list, not a filled
                     bar above it. -->
                <helpers:GhostAddRowView
                    Text="{x:Static consts:BusinessSettingsConstants.AddServiceText}"
                    Command="{Binding AddServiceCommand}"
                    Margin="0,4,0,0"/>

                <VerticalStackLayout Spacing="8" Margin="0,16,0,0" IsVisible="{Binding HasInactive}">

                    <Border Style="{StaticResource brd14_Row}" Padding="14,0"
                            MinimumHeightRequest="56">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleInactiveCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <tpl:ThemedIcon Grid.Column="0" Icon="ic_chevron_down"
                                            WidthRequest="17" HeightRequest="17"
                                            Opacity="0.6" VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{x:Static consts:BusinessSettingsConstants.InactiveGroupTitle}"
                                   Style="{StaticResource lbl13_Regular_TextMid}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="{Binding InactiveCountText}"
                                   Style="{StaticResource lbl13_Mono_TextMuted}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding IsInactiveExpanded}"
                                         Opacity="0.55"
                                         BindableLayout.ItemsSource="{Binding InactiveServices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ServiceRow">
                                <helpers:ServiceRowView
                                    ServiceName="{Binding Name}"
                                    DetailText="{Binding DetailText}"
                                    HasQuestions="{Binding HasQuestions}"
                                    QuestionChipText="{Binding QuestionChipText}"
                                    RequiresCollection="{Binding RequiresCollection}"
                                    TapCommand="{Binding BindingContext.EditServiceCommand, Source={x:Reference Root}}"
                                    TapCommandParameter="{Binding .}"/>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Style="{StaticResource ai_Purple}"
                                   HorizontalOptions="Center" Margin="0,24"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
