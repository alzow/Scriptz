<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.BusinessSettings.AddAvailabilityWindow"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.AlzowLoadingButton"
             xmlns:templates="clr-namespace:QueueApp.Shared.Templates.AlzowSubPageHeader"
             x:Class="QueueApp.Features.BusinessSettings.AddAvailabilityWindow.AddAvailabilityWindowPage"
             x:DataType="vm:AddAvailabilityWindowPageViewModel"
             Title="{Binding Title}"
             Style="{StaticResource NavigationPageStyle}">
    <Grid RowDefinitions="Auto,*">
        <templates:AlzowSubPageHeader Grid.Row="0"
                                       Title="{Binding Title}"
                                       BackCommand="{Binding GoBackCommand}"/>

        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="16">

            <Label Text="Start time" Style="{StaticResource lbl15_Bold_TextDark}"/>
            <TimePicker Time="{Binding StartTime}"
                        Style="{StaticResource timepicker14_Inline}"
                        FontSize="16"/>

            <Label Text="End time" Style="{StaticResource lbl15_Bold_TextDark}"/>
            <TimePicker Time="{Binding EndTime}"
                        Style="{StaticResource timepicker14_Inline}"
                        FontSize="16"/>

            <controls:AlzowLoadingButton
                Text="Save"
                LoadingText="Saving…"
                Margin="0" HeightRequest="54"
                Command="{Binding SaveCommand}"
                IsLoading="{Binding IsSaving}"
                ButtonStyle="{StaticResource PrimaryButtonStyle}" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>
