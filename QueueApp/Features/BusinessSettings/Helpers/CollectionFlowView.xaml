<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             xmlns:consts="clr-namespace:QueueApp.Features.BusinessSettings.Constants"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessSettings.Helpers.CollectionFlowView">

    <VerticalStackLayout Spacing="10">

        <!-- The step the toggle adds is the one that is highlighted: the diagram is the
             explanation, so the difference has to be visible in it. -->
        <HorizontalStackLayout Spacing="6">
            <Border Style="{StaticResource brd6_FlowStep}" Padding="8,6">
                <Label Text="{x:Static consts:BusinessSettingsConstants.FlowWaiting}"
                       Style="{StaticResource lbl11_Mono_TextMuted}"/>
            </Border>
            <tpl:ThemedIcon Icon="ic_chevron_right" WidthRequest="13" HeightRequest="13"
                            Opacity="0.5" VerticalOptions="Center"/>
            <Border Style="{StaticResource brd6_FlowStep}" Padding="8,6">
                <Label Text="{x:Static consts:BusinessSettingsConstants.FlowBeingDone}"
                       Style="{StaticResource lbl11_Mono_TextMuted}"/>
            </Border>
            <tpl:ThemedIcon Icon="ic_chevron_right" WidthRequest="13" HeightRequest="13"
                            Opacity="0.5" VerticalOptions="Center"/>
            <Border Style="{StaticResource brd6_FlowStep_Added}" Padding="8,6">
                <Label Text="{x:Static consts:BusinessSettingsConstants.FlowReady}"
                       Style="{StaticResource lbl11_Mono_Green}"/>
            </Border>
            <tpl:ThemedIcon Icon="ic_chevron_right" WidthRequest="13" HeightRequest="13"
                            Opacity="0.5" VerticalOptions="Center"/>
            <Border Style="{StaticResource brd6_FlowStep}" Padding="8,6">
                <Label Text="{x:Static consts:BusinessSettingsConstants.FlowCollected}"
                       Style="{StaticResource lbl11_Mono_TextMuted}"/>
            </Border>
        </HorizontalStackLayout>

        <!-- <Label Text="{x:Static consts:BusinessSettingsConstants.CollectionConsequence}"
               Style="{StaticResource lbl12_Regular_TextMuted}"/> -->

    </VerticalStackLayout>

</ContentView>
