<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessSettings.Helpers.GhostAddRowView">

    <Border Style="{StaticResource brd14_Ghost_Dashed}" Padding="14"
            MinimumHeightRequest="56">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}"/>
        </Border.GestureRecognizers>

        <HorizontalStackLayout Spacing="9" HorizontalOptions="Center" VerticalOptions="Center">
            <tpl:ThemedIcon Icon="ic_plus" WidthRequest="17" HeightRequest="17"
                            VerticalOptions="Center"/>
            <Label Text="{Binding Text, Source={x:Reference Root}}"
                   Style="{StaticResource lbl15_Bold_AccentText}"
                   VerticalOptions="Center"/>
        </HorizontalStackLayout>
    </Border>

</ContentView>
