<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QueueApp.Features.BusinessSettings.Models"
             x:Name="Root"
             x:Class="QueueApp.Features.BusinessSettings.Helpers.DurationChipsView">

    <FlexLayout Wrap="Wrap" Direction="Row"
                BindableLayout.ItemsSource="{Binding Options, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:DurationChoice">
                <Border Style="{StaticResource brd11_Chip_Selectable}"
                        MinimumHeightRequest="44" MinimumWidthRequest="47"
                        Padding="11,0" Margin="0,0,7,7">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Label}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Style="{StaticResource lbl13_Regular_TextMid_Selectable}"/>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </FlexLayout>

</ContentView>
