<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScriptzApp.Features.Auth"
             x:Class="ScriptzApp.Features.Auth.RegisterPage"
             x:DataType="vm:RegisterPageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Cream}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- Brown Header -->
                <Grid BackgroundColor="{StaticResource Brown}"
                      Padding="24,52,24,36">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Border BackgroundColor="{StaticResource Orange}"
                                WidthRequest="44" HeightRequest="44"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Label Text="💊" FontSize="22"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="Create account"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource Cream}"/>
                            <Label Text="Join Scriptz today"
                                   FontSize="13" TextColor="{StaticResource BrownLight}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Form body -->
                <VerticalStackLayout Padding="24,32,24,24" Spacing="16">

                    <!-- First Name -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="FIRST NAME" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="Ahmed"
                                   Text="{Binding FirstName}"
                                   HeightRequest="52"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Last Name -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="LAST NAME" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="Cassim"
                                   Text="{Binding LastName}"
                                   HeightRequest="52"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Phone Number -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="PHONE NUMBER" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="072 000 0000"
                                   Text="{Binding PhoneNumber}"
                                   Keyboard="Telephone"
                                   HeightRequest="52"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="EMAIL" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="you@email.com"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   HeightRequest="52"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="PASSWORD" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="••••••••"
                                   Text="{Binding Password}"
                                   IsPassword="True"
                                   HeightRequest="52"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Confirm Password -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="CONFIRM PASSWORD" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="••••••••"
                                   Text="{Binding ConfirmPassword}"
                                   IsPassword="True"
                                   HeightRequest="52"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Create Account button -->
                    <Button Text="Create Account →"
                            Command="{Binding RegisterCommand}"
                            BackgroundColor="{StaticResource Brown}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="14"
                            HeightRequest="54"
                            Margin="0,8,0,0"/>

                    <Label Text="Pay on delivery · No upfront cost"
                           TextColor="{StaticResource TextLight}"
                           FontSize="12"
                           HorizontalOptions="Center"/>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource CreamBorder}" Margin="0,8,0,8"/>

                    <!-- Login link -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Already have an account?"
                               TextColor="{StaticResource TextMid}" FontSize="13"/>
                        <Label Text="Sign In"
                               TextColor="{StaticResource Orange}"
                               FontAttributes="Bold" FontSize="13">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource Orange}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Scale="1.5"/>
        </Grid>
    </Grid>

</ContentPage>
