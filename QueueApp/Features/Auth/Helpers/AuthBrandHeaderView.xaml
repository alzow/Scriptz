<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.Auth.Helpers.AuthBrandHeaderView">

    <Grid BackgroundColor="{StaticResource Brown}" Padding="24,52,24,36">
        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
            <Border Style="{StaticResource brd14_Orange}" WidthRequest="44" HeightRequest="44">
                <Image Source="logo_monogram_reversed"
                       WidthRequest="24" HeightRequest="24"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                <Label Text="{Binding HeadingText, Source={x:Reference Root}}"
                       Style="{StaticResource lbl22_Bold_Cream}"/>
                <Label Text="{Binding SubheadingText, Source={x:Reference Root}}"
                       Style="{StaticResource lbl13_Regular_BrownLight}"/>
            </VerticalStackLayout>
        </HorizontalStackLayout>
    </Grid>

</ContentView>
