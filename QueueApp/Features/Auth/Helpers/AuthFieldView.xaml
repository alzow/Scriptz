<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:entry="clr-namespace:QueueApp.Shared.Templates.QueueEntry"
             x:Name="Root"
             x:Class="QueueApp.Features.Auth.Helpers.AuthFieldView">

    <VerticalStackLayout Spacing="6">

        <Label Text="{Binding LabelText, Source={x:Reference Root}}"
               Style="{StaticResource SectionTitle}"
               Margin="2,0,0,0"/>

        <entry:QueueEntry Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                          Text="{Binding Text, Source={x:Reference Root}}"
                          InputType="{Binding InputType, Source={x:Reference Root}}"
                          IsPassword="{Binding IsPassword, Source={x:Reference Root}}"
                          ShowRevealButton="{Binding IsPassword, Source={x:Reference Root}}"
                          ReturnType="{Binding ReturnType, Source={x:Reference Root}}"
                          Validator="{Binding Validator, Source={x:Reference Root}}"
                          SharedStateManager="{Binding SharedStateManager, Source={x:Reference Root}}"
                          ValidateOnTextChanged="{Binding ValidateOnTextChanged, Source={x:Reference Root}}"/>

        <Label Text="{Binding HintText, Source={x:Reference Root}}"
               Style="{StaticResource lbl12_Regular_TextFaint}"
               Margin="2,0,2,0"
               IsVisible="{Binding HintText, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>

    </VerticalStackLayout>

</ContentView>
