<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QueueApp.Shared.Templates.QueueLoadingButton"
             xmlns:helpers="clr-namespace:QueueApp.Features.Auth.Helpers"
             x:Name="Root"
             x:Class="QueueApp.Features.Auth.Helpers.LoginFormView">

    <VerticalStackLayout Padding="24,24,24,8" Spacing="18">

        <helpers:AuthInlineErrorView Message="{Binding ErrorMessage, Source={x:Reference Root}}"/>

        <helpers:AuthFieldView LabelText="EMAIL"
                               Placeholder="you@example.co.za"
                               Text="{Binding EmailAddress, Source={x:Reference Root}}"
                               InputType="Email"
                               ReturnType="Next"
                               Validator="{Binding EmailValidator, Source={x:Reference Root}}"
                               SharedStateManager="{Binding FormStateManager, Source={x:Reference Root}}"/>

        <helpers:AuthFieldView LabelText="PASSWORD"
                               IsPassword="True"
                               Text="{Binding Password, Source={x:Reference Root}}"
                               Validator="{Binding PasswordValidator, Source={x:Reference Root}}"
                               SharedStateManager="{Binding FormStateManager, Source={x:Reference Root}}"/>

        <controls:AlzowLoadingButton
            Text="Sign in"
            LoadingText="Signing in…"
            Command="{Binding SignInCommand, Source={x:Reference Root}}"
            IsLoading="{Binding IsSigningIn, Source={x:Reference Root}}"
            IsEnabled="{Binding CanSubmit, Source={x:Reference Root}}"
            Margin="0,6,0,0"
            ButtonStyle="{StaticResource btn16_Bold_AuthSubmit}"/>

    </VerticalStackLayout>

</ContentView>
