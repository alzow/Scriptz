<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.Auth.Helpers.AuthFooterLinkView">

    <VerticalStackLayout Spacing="16">
        <BoxView HeightRequest="1"
                 Style="{StaticResource bx_Divider}"
                 Margin="0,8,0,0"/>
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
            <Label Text="{Binding PromptText, Source={x:Reference Root}}"
                   Style="{StaticResource lbl13_Regular_TextMid}"/>
            <Label Text="{Binding ActionText, Source={x:Reference Root}}"
                   Style="{StaticResource lbl13_Bold_Orange}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ActionCommand, Source={x:Reference Root}}"/>
                </Label.GestureRecognizers>
            </Label>
        </HorizontalStackLayout>
    </VerticalStackLayout>

</ContentView>
