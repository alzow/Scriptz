<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Features.Auth.Helpers.AuthPageHeaderView">

    <VerticalStackLayout Spacing="10" Padding="24,8,24,0">
        <Label Text="{Binding TitleText, Source={x:Reference Root}}"
               Style="{StaticResource lbl27_Bold_AuthTitle}"/>
        <Label Text="{Binding LeadText, Source={x:Reference Root}}"
               Style="{StaticResource lbl13_Regular_AuthLead}"
               IsVisible="{Binding LeadText, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
    </VerticalStackLayout>

</ContentView>
