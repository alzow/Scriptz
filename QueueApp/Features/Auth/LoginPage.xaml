<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Auth"
             x:Class="QueueApp.Features.Auth.LoginPage"
             x:DataType="vm:LoginPageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Cream}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- Brown Header -->
                <Grid BackgroundColor="{StaticResource Brown}"
                      Padding="24,52,24,36">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo row -->
                    <HorizontalStackLayout Grid.Row="1" Spacing="12" VerticalOptions="Center">
                        <Border BackgroundColor="{StaticResource Orange}"
                                WidthRequest="44" HeightRequest="44"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Label Text="💊" FontSize="22"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="Welcome back"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource Cream}"/>
                            <Label Text="Sign in to Queue"
                                   FontSize="13" TextColor="{StaticResource BrownLight}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Form body -->
                <VerticalStackLayout Padding="24,32,24,24" Spacing="16">

                    <!-- Email field -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="EMAIL / PHONE"
                               Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5"
                                Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="you@email.com"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   HeightRequest="52"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password field -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="PASSWORD"
                               Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5"
                                Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="••••••••"
                                   Text="{Binding Password}"
                                   IsPassword="True"
                                   HeightRequest="52"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Sign In button -->
                    <Button Text="Sign In →"
                            Command="{Binding LoginCommand}"
                            BackgroundColor="{StaticResource Orange}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="14"
                            HeightRequest="54"
                            Margin="0,8,0,0"/>

                    <!-- Forgot password -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Forgot password?"
                               TextColor="{StaticResource TextLight}" FontSize="13"/>
                        <Label Text="Reset it"
                               TextColor="{StaticResource Orange}"
                               FontAttributes="Bold" FontSize="13"/>
                    </HorizontalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource CreamBorder}" Margin="0,8,0,8"/>

                    <!-- Register link -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="New to Queue?"
                               TextColor="{StaticResource TextMid}" FontSize="13"/>
                        <Label Text="Create account"
                               TextColor="{StaticResource Orange}"
                               FontAttributes="Bold" FontSize="13">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource Orange}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Scale="1.5"/>
        </Grid>
    </Grid>

</ContentPage>
