<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueueApp.Features.Auth"
             xmlns:helpers="clr-namespace:QueueApp.Features.Auth.Helpers"
             x:Class="QueueApp.Features.Auth.LoginPage"
             x:DataType="vm:LoginPageViewModel"
             NavigationPage.HasNavigationBar="False"
             Style="{StaticResource NavigationPageStyle}">

    <Grid Style="{StaticResource grid_Page}">
        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="0,36,0,0">

                <helpers:AuthPageHeaderView TitleText="{Binding HeadingText}"
                                            LeadText="{Binding LeadText}"/>

                <helpers:LoginFormView
                    EmailAddress="{Binding Email}"
                    Password="{Binding Password}"
                    EmailValidator="{Binding EmailValidator}"
                    PasswordValidator="{Binding PasswordValidator}"
                    FormStateManager="{Binding FormStateManager}"
                    ErrorMessage="{Binding ErrorMessage}"
                    IsSigningIn="{Binding IsSigningIn}"
                    CanSubmit="{Binding CanSubmit}"
                    SignInCommand="{Binding LoginCommand}"/>

                <helpers:AuthFooterLinkView
                    Margin="24,0,24,28"
                    PromptText="New here?"
                    ActionText="Create an account"
                    ActionCommand="{Binding NavigateToRegisterCommand}"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
