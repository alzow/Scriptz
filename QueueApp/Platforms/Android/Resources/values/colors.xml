<?xml version="1.0" encoding="utf-8"?>
<!--
    Mirrors Resources/Styles/Colors.xaml. These three names are what the Android theme reads for
    the text cursor and selection handles, and the ripple — leave them stale and the OS chrome
    around the app is a different palette to the app itself.

    Android resources are picked at inflate time and cannot follow a runtime theme switch, so the
    system bars are no longer set from colorPrimaryDark here: PlatformChrome paints them from the
    live theme instead. The values below stay on the dark palette, which is the brand default and
    is what the splash shows.
-->
<resources>
    <color name="colorPrimary">#39FF7A</color>
    <color name="colorPrimaryDark">#141821</color>
    <color name="colorAccent">#A45EFF</color>
</resources>
