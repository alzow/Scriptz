<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Naming convention: brd{CornerRadius}_{BackgroundColor}
        e.g. brd14_White, brd20_Brown

        Every colour resolves through AppThemeBinding over the raw tokens in Colors.xaml. Where a
        style used a vivid accent as a thin stroke, it now takes the *Text variant: #39FF7A as a
        1px stroke on a light page is 1.22:1 and disappears. Fills keep the vivid brand colour.
    -->

    <Style x:Key="brd10_White" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd12_White" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd12_Cream" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd14_White" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd14_Orange" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightPurple}, Dark={StaticResource DarkPurple}}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd16_White" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd16_OrangePale" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd18_OrangePale" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd20_White" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd20_Brown" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Operator board -->
    <Style x:Key="brd13_Raised" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="13"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The now-serving card. Green edge, never a green fill — the fill belongs to Done. -->
    <Style x:Key="brd14_Serving" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentBorder}, Dark={StaticResource DarkAccentBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The shared pool. Purple here means awaiting resolution, which is exactly what an unassigned
        entry is, and this banner is the only place on the board that earns the colour. The stroke
        is overridden at the use site: it goes to full purple once the oldest entry has sat past
        BoardConstants.PoolStarvationMinutes.
    -->
    <Style x:Key="brd16_Pool" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightPurpleTint}, Dark={StaticResource DarkPurpleTint}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightPurpleBorder}, Dark={StaticResource DarkPurpleBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Add walk-in: a ghost, because it is the least frequent action in the section. -->
    <Style x:Key="brd13_Ghost" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeDashArray" Value="4,3"/>
        <Setter Property="StrokeDashOffset" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="13"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bottom sheet body: rounded at the top only, square where it meets the screen edge. -->
    <Style x:Key="brd22_Sheet" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="22,22,0,0"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd11_Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="11"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd6_Tag" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="6"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd14_Row" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd13_Warning" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightDangerTint}, Dark={StaticResource DarkDangerTint}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightDangerBorder}, Dark={StaticResource DarkDangerBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="13"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status pill on a list row. Green is the confirmed default; pending swaps it for purple. -->
    <Style x:Key="brd20_StatusPill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentTint}, Dark={StaticResource DarkAccentTint}}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="HorizontalOptions" Value="End"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Profile's status block. The readiness pair: green when the app can actually reach the
        customer, red when the phone has blocked it. Same 13px shape as brd13_Warning so the two
        states are the same box with a different meaning, never a different box.
    -->
    <Style x:Key="brd13_Success" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentTint}, Dark={StaticResource DarkAccentTint}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentBorder}, Dark={StaticResource DarkAccentBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="14,13"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="13"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd13_Danger" TargetType="Border" BasedOn="{StaticResource brd13_Warning}">
        <Setter Property="Padding" Value="14,13"/>
    </Style>

    <!-- The picked appearance row. Tint plus an accent stroke, the same "this is the one" language
         the selectable chips and day tiles already speak. -->
    <Style x:Key="brd16_Row_Selected" TargetType="Border" BasedOn="{StaticResource brd16_White}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentTint}, Dark={StaticResource DarkAccentTint}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>

    <Style x:Key="brd12_Danger" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightDangerTint}, Dark={StaticResource DarkDangerTint}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightDangerBorder}, Dark={StaticResource DarkDangerBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ================================================================================
        Selection states.

        The selected chip carries a tint fill and an accent stroke. On dark the stroke is the vivid
        #39FF7A it has always been; on light it deepens to AccentText, because a neon 1px stroke on
        a pale tint is invisible. The trigger lives in the style rather than at the use site so no
        page has to name a colour to describe "selected".
        ================================================================================
    -->

    <Style x:Key="brd11_Chip_Selectable" TargetType="Border" BasedOn="{StaticResource brd11_Chip}">
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentTint}, Dark={StaticResource DarkAccentTint}}"/>
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="brd14_Day_Selectable" TargetType="Border" BasedOn="{StaticResource brd14_White}">
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentTint}, Dark={StaticResource DarkAccentTint}}"/>
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Booking-flow day tile: 14px radius but a 1px stroke, so it is not brd14_White. -->
    <Style x:Key="brd14_DayTile_Selectable" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentTint}, Dark={StaticResource DarkAccentTint}}"/>
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
            </DataTrigger>
            <!--
                A full day is not selectable, and it has to say so without opacity. It drops to the
                page colour, so it reads as a hole in the strip rather than a card you can pick —
                which is the same direction in both themes, where a fade is not.
            -->
            <DataTrigger TargetType="Border" Binding="{Binding IsFull}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBg}, Dark={StaticResource DarkBg}}"/>
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Service and operator choice rows in the flow. -->
    <Style x:Key="brd15_Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="15"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd15_Row_Selectable" TargetType="Border" BasedOn="{StaticResource brd15_Card}">
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentTint}, Dark={StaticResource DarkAccentTint}}"/>
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A time slot is the one selection that fills rather than tints: picking a time is the commit
        in the booking flow. The fill stays the vivid brand green in both themes and the label goes
        to TextOnAccent, which is 14.08:1 on it.
    -->
    <Style x:Key="brd11_Slot_Selectable" TargetType="Border" BasedOn="{StaticResource brd11_Chip}">
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"/>
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The 22px check circle beside a choice row. -->
    <Style x:Key="brd11_Radio_Selectable" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="11"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Operator avatar in the flow: the ring goes green once that operator can take someone now. -->
    <Style x:Key="brd21_Avatar_Available" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="21"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsAnyAvailable}" Value="True">
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentBorder}, Dark={StaticResource DarkAccentBorder}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="brd26_Avatar" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="26"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd_Avatar_Ellipse" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="Ellipse"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!--
        ================================================================================
        Tints, pills and tags.
        ================================================================================
    -->

    <!-- FASTEST beside an operator's name, and the LIVE badge on the board header. -->
    <Style x:Key="brd6_AccentTag" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentTint}, Dark={StaticResource DarkAccentTint}}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="6"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd7_AccentTag" TargetType="Border" BasedOn="{StaticResource brd6_AccentTag}">
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="7"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd8_AccentTag" TargetType="Border" BasedOn="{StaticResource brd6_AccentTag}">
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The shared business header's pill. Muted drops the tint for a plain outline; bad goes red. -->
    <Style x:Key="brd8_OpenPill" TargetType="Border" BasedOn="{StaticResource brd8_AccentTag}"/>

    <Style x:Key="brd8_ClosedPill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd8_DangerPill" TargetType="Border" BasedOn="{StaticResource brd8_AccentTag}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightDangerTint}, Dark={StaticResource DarkDangerTint}}"/>
    </Style>

    <Style x:Key="brd8_PurpleTag" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightPurpleTint}, Dark={StaticResource DarkPurpleTint}}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd20_StatusPill_Purple" TargetType="Border" BasedOn="{StaticResource brd20_StatusPill}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightPurpleTint}, Dark={StaticResource DarkPurpleTint}}"/>
    </Style>

    <!-- Raised box with a purple edge: the pending-booking panel and the assign sheet's banner. -->
    <Style x:Key="brd13_Raised_Purple" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="13"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd14_PurpleTint" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightPurpleTint}, Dark={StaticResource DarkPurpleTint}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightPurpleBorder}, Dark={StaticResource DarkPurpleBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd16_Surface_Purple" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The live card on a business landing. Its edge turns purple in booking mode, because booking
        is the awaiting-resolution path — you ask for a slot and the shop confirms it.
    -->
    <Style x:Key="brd18_LiveCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd18_LiveCard_Booking" TargetType="Border" BasedOn="{StaticResource brd18_LiveCard}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>

    <!-- The hero ring around the queue position on the browse dashboard. -->
    <Style x:Key="brd_Hero_AccentRing" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
        <Setter Property="StrokeThickness" Value="6"/>
    </Style>

    <Style x:Key="brd_Hero_AccentRing_Purple" TargetType="Border" BasedOn="{StaticResource brd_Hero_AccentRing}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>

    <!--
        ================================================================================
        Sundries.
        ================================================================================
    -->

    <!-- The 38x4 grab handle at the top of a bottom sheet. -->
    <Style x:Key="brd2_Grabber" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dashed empty state, e.g. a period with no slot long enough left in it. -->
    <Style x:Key="brd12_Ghost" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeDashArray" Value="4,4"/>
        <Setter Property="StrokeDashOffset" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outlined action, square-ish: "Browse nearby" on the history empty state. -->
    <Style x:Key="brd_Outline_Action" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <Style x:Key="brd16_Surface" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain surface fill with no edge: board section wells and the pool's inner rows. -->
    <Style x:Key="brd_Surface_Flat" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>

    <Style x:Key="brd10_Surface_Flat" TargetType="Border" BasedOn="{StaticResource brd_Surface_Flat}">
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd_Raised_Flat" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>

    <Style x:Key="brd_Raised_Lined" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <!-- History filter chips. Root-sourced triggers can't live in a style, so the page swaps style. -->
    <Style x:Key="brd16_Chip" TargetType="Border" BasedOn="{StaticResource brd16_White}">
        <Setter Property="Padding" Value="15,7"/>
    </Style>

    <Style x:Key="brd16_Chip_Selected" TargetType="Border" BasedOn="{StaticResource brd16_Chip}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentTint}, Dark={StaticResource DarkAccentTint}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>

    <!-- History empty state: a dashed well where a list of past visits would be. -->
    <Style x:Key="brd26_GhostCircle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeDashArray" Value="4,3"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="26"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The entry being assigned: purple ring, because assignment is the unresolved thing here. -->
    <Style x:Key="brd_Avatar_Purple" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="Ellipse"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="brd6_PurpleTag" TargetType="Border" BasedOn="{StaticResource brd8_PurpleTag}">
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="6"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small outlined tag, e.g. the agenda header's open/closed capsule. -->
    <Style x:Key="brd6_Outline" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="6"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd13_Raised_Lined" TargetType="Border" BasedOn="{StaticResource brd13_Raised}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <Style x:Key="brd20_StatusPill_Selectable" TargetType="Border" BasedOn="{StaticResource brd20_StatusPill}">
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="pending">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightPurpleTint}, Dark={StaticResource DarkPurpleTint}}"/>
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="awaiting_collection">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightPurpleTint}, Dark={StaticResource DarkPurpleTint}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Idle discovery band: a dashed invitation, not a card. -->
    <Style x:Key="brd_Ghost_Dashed" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeDashArray" Value="4,3"/>
    </Style>

    <Style x:Key="brd7_Raised_Tag" TargetType="Border" BasedOn="{StaticResource brd6_Tag}">
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="7"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        QueueEntry's field. The code-behind swaps between these three as the entry gains focus and
        as validation passes or fails, so the state lives in styles rather than in raw colours.
    -->
    <Style x:Key="brd16_Entry" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <Style x:Key="brd16_Entry_Focused" TargetType="Border" BasedOn="{StaticResource brd16_Entry}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>

    <Style x:Key="brd16_Entry_Error" TargetType="Border" BasedOn="{StaticResource brd16_Entry}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightDangerText}, Dark={StaticResource DarkDangerText}}"/>
    </Style>

    <!--
        A locked field. Same 16px shape as brd16_Entry, dropped to the page colour so it reads as
        something the app is showing rather than something the customer can type into.

        Must stay *after* brd16_Entry: StaticResource in a ResourceDictionary only sees keys already
        parsed above it, so a BasedOn that points further down the file throws at load.
    -->
    <Style x:Key="brd16_Entry_Locked" TargetType="Border" BasedOn="{StaticResource brd16_Entry}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBg}, Dark={StaticResource DarkBg}}"/>
    </Style>

    <!--
        AlzowEditor's field. The entry shell without its fixed height, so multi-line input grows
        while still reading as the same control family.
    -->
    <Style x:Key="brd16_Editor" TargetType="Border" BasedOn="{StaticResource brd16_Entry}">
        <Setter Property="HeightRequest" Value="-1"/>
        <Setter Property="MinimumHeightRequest" Value="96"/>
    </Style>

    <Style x:Key="brd16_Editor_Focused" TargetType="Border" BasedOn="{StaticResource brd16_Editor}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>

    <!--
        ================================================================================
        VisitPage. Solid tint tokens throughout — the hero, the two note rules and the danger
        reason block are fills, never alpha over whatever happens to be underneath.
        ================================================================================
    -->

    <Style x:Key="brd18_VisitHero" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentTint}, Dark={StaticResource DarkAccentTint}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentBorder}, Dark={StaticResource DarkAccentBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="brd13_Raised_Note" TargetType="Border" BasedOn="{StaticResource brd13_Raised}">
        <Setter Property="Padding" Value="13,12"/>
    </Style>

    <!--
        WelcomePage. The illustration sits in the same Surface card with the same Border stroke as
        every other card in the app — it is not a floating hero with its own treatment.
    -->
    <Style x:Key="brd24_WelcomeArt" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="24"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Position dots. The active one is a 22px pill rather than a fatter circle, so the row reads
        as a progress bar at a glance instead of as four buttons.
    -->
    <Style x:Key="brd_WelcomeDot" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 4"/>
        <Setter Property="HeightRequest" Value="7"/>
        <Setter Property="WidthRequest" Value="7"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
                <Setter Property="WidthRequest" Value="22"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
