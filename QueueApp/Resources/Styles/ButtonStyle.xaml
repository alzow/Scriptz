<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Naming convention: btn{FontSize}_{FontAttributes}_{BackgroundColor}
        e.g. btn14_Bold_Orange, btn16_Bold_Green
    -->

    <Style x:Key="btn12_Bold_Orange" TargetType="Button">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Orange}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="btn13_Bold_Green" TargetType="Button">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Green}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style x:Key="btn14_Regular_Green" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Green}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
    </Style>

    <Style x:Key="btn14_Regular_Brown" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Brown}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
    </Style>

    <Style x:Key="btn14_Regular_Red" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Red}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
    </Style>

    <Style x:Key="btn16_Bold_Orange" TargetType="Button">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Orange}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>

    <Style x:Key="btn17_Bold_Orange" TargetType="Button">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Orange}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>

</ResourceDictionary>
