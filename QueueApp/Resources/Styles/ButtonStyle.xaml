<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Naming convention: btn{FontSize}_{FontAttributes}_{BackgroundColor}
        e.g. btn14_Bold_Orange, btn16_Bold_Green

        Filled buttons keep the vivid brand colour in both themes and carry TextOnAccent, which is
        near-black. On green that is 14.08:1. On the red and purple fills it is 5.39 and 5.02 —
        white on those was 3.48 and 3.73 and failed. Outlined buttons take the *Text variants,
        because a vivid stroke and vivid label are both unreadable on a light page.
    -->

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextOnAccent}, Dark={StaticResource DarkTextOnAccent}}"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!--
        Filled destructive. The fill stays #FF3B5C in both themes — the button does not change
        colour, only the words on it do.
    -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightDanger}, Dark={StaticResource DarkDanger}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextOnAccent}, Dark={StaticResource DarkTextOnAccent}}"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style x:Key="TertiaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!--
        Outlined, neutral. Decline sits beside Confirm at equal weight — a genuine binary, not a
        primary with an escape hatch — so it can't borrow Danger and can't be a second filled green.
    -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!-- Fill is an invitation, not the commit — outlined green so the now/next card keeps the one filled green. -->
    <Style x:Key="OutlineGreenButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
        <Setter Property="BorderWidth" Value="1.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>

    <Style x:Key="ToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Style.Triggers>
            <Trigger TargetType="Button"
                     Property="Text"
                     Value="Deactivate">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightDangerText}, Dark={StaticResource DarkDangerText}}"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightDangerText}, Dark={StaticResource DarkDangerText}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="btn12_Bold_Orange" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="btn13_Bold_Green" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style x:Key="btn14_Regular_Green" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="btn14_Regular_Brown" TargetType="Button" BasedOn="{StaticResource TertiaryButtonStyle}">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="btn14_Regular_Red" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="btn16_Bold_Orange" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>

    <Style x:Key="btn17_Bold_Orange" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>

    <!--
        Operator board. One filled green per section, and it is always whatever completes the
        customer in the chair — so Done is the only style here with a green fill. Serve and Assign
        are outlines, and Add walk-in is a ghost, because they are secondary to it.
    -->
    <Style x:Key="btn16_Bold_Green" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="16.5"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>

    <Style x:Key="btn14_Bold_GreenOutline" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
        <Setter Property="BorderWidth" Value="1.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20,0"/>
    </Style>

    <Style x:Key="btn14_Bold_PurpleOutline" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
        <Setter Property="BorderWidth" Value="1.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18,0"/>
    </Style>

    <Style x:Key="btn12_Bold_Neutral" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="14,0"/>
    </Style>

    <!--
        Sheet rows. 56px minimum and left-aligned, so the label reads as a list item rather than a
        control. The two red ones only ever appear below the sheet's separator.
    -->
    <Style x:Key="btn15_Regular_SheetRow" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
        <Setter Property="FontFamily" Value="RobotoMedium"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HeightRequest" Value="56"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="ContentLayout" Value="Left,12"/>
    </Style>

    <Style x:Key="btn15_Bold_SheetGo" TargetType="Button" BasedOn="{StaticResource btn15_Regular_SheetRow}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextOnAccent}, Dark={StaticResource DarkTextOnAccent}}"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
    </Style>

    <Style x:Key="btn15_Regular_SheetBad" TargetType="Button" BasedOn="{StaticResource btn15_Regular_SheetRow}">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightDangerText}, Dark={StaticResource DarkDangerText}}"/>
    </Style>

    <Style x:Key="btn14_Bold_Neutral" TargetType="Button" BasedOn="{StaticResource btn12_Bold_Neutral}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>

    <!--
        Row action. Sits inside a card next to its own content, so it is outlined rather than filled
        and carries its own height — the sheet buttons' 56px would dwarf a two-line list row.
    -->
    <Style x:Key="btn12_Bold_RowAction" TargetType="Button" BasedOn="{StaticResource btn12_Bold_Neutral}">
        <Setter Property="HeightRequest" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinimumWidthRequest" Value="76"/>
    </Style>

    <!--
        The welcome screen's pinned CTA pair. Both are full width and both carry their height here
        rather than at the use site, because "identical on every panel, to the pixel" is the whole
        point of the block and a per-panel HeightRequest is exactly how that drifts.
    -->
    <Style x:Key="btn17_Bold_WelcomePrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="HeightRequest" Value="58"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <Style x:Key="btn15_Bold_WelcomeSecondary" TargetType="Button" BasedOn="{StaticResource btn14_Bold_Neutral}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HeightRequest" Value="54"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <!-- Submit on the auth pages. Same 54px as the welcome screen's second button. -->
    <Style x:Key="btn16_Bold_AuthSubmit" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HeightRequest" Value="54"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

</ResourceDictionary>
