<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Raw theme values. Nothing semantic lives here and nothing outside Styles.xaml and its
        sibling dictionaries may reference these keys: pages reference styles, styles reference
        tokens through AppThemeBinding, tokens reference these raw values.

        Dark is the primary aesthetic. Light is the same product with the lights on — the same
        elevation model, the same borders, the same meanings, different values.
    -->

    <!--
        Neutrals. Elevation runs the same direction in both themes: higher is lighter.
        Page to card separation is 1.113 on dark and 1.137 on light, so light is marginally more
        separated and nothing flattens out.
    -->
    <Color x:Key="DarkBg">#141821</Color>
    <Color x:Key="LightBg">#E4E9F1</Color>
    <Color x:Key="DarkSurface">#1C222D</Color>
    <Color x:Key="LightSurface">#F5F7FB</Color>
    <Color x:Key="DarkRaised">#252C39</Color>
    <Color x:Key="LightRaised">#FFFFFF</Color>
    <Color x:Key="DarkBorder">#343D4D</Color>
    <Color x:Key="LightBorder">#BFCAD9</Color>

    <!--
        Text. TextDim sits deliberately below 4.5:1 in both themes — it is for decorative labels
        and timestamps only, never for anything the operator has to read.
    -->
    <Color x:Key="DarkTextInk">#E2E9F5</Color>
    <Color x:Key="LightTextInk">#161C27</Color>
    <Color x:Key="DarkTextMuted">#8A96A6</Color>
    <Color x:Key="LightTextMuted">#586376</Color>
    <Color x:Key="DarkTextDim">#5D6879</Color>
    <Color x:Key="LightTextDim">#788496</Color>
    <Color x:Key="DarkTextOnAccent">#0E1219</Color>
    <Color x:Key="LightTextOnAccent">#0E1219</Color>

    <!--
        Accent fills. Identical in both themes — these are the brand. Buttons, bars, dots.
        Green means active / commit / your turn, purple means awaiting resolution, red means
        destructive, and that holds in both themes.
    -->
    <Color x:Key="DarkAccent">#39FF7A</Color>
    <Color x:Key="LightAccent">#39FF7A</Color>
    <Color x:Key="DarkPurple">#A45EFF</Color>
    <Color x:Key="LightPurple">#A45EFF</Color>
    <Color x:Key="DarkDanger">#FF3B5C</Color>
    <Color x:Key="LightDanger">#FF3B5C</Color>

    <!--
        Accent text and thin strokes. The brand green as text on a light page is 1.22:1, so each
        accent splits into a fill and a legible text/stroke variant. On dark the text variant is
        the vivid colour for green and a lifted one for purple and red, which is the §4 correction:
        #A45EFF and #FF3B5C both fail as text on Raised.
    -->
    <Color x:Key="DarkAccentText">#39FF7A</Color>
    <Color x:Key="LightAccentText">#097430</Color>
    <Color x:Key="DarkPurpleText">#B47CFF</Color>
    <Color x:Key="LightPurpleText">#7A2FD6</Color>
    <Color x:Key="DarkDangerText">#FF5E78</Color>
    <Color x:Key="LightDangerText">#C81939</Color>

    <!--
        Tints and tint borders. Solid, never alpha: 7% neon green over #F5F7FB is invisible and
        slightly acid, and an alpha tint composites to two different colours depending on whether
        it lands on Bg or on Surface.
    -->
    <Color x:Key="DarkAccentTint">#15291E</Color>
    <Color x:Key="LightAccentTint">#DFF9E8</Color>
    <Color x:Key="DarkPurpleTint">#231B33</Color>
    <Color x:Key="LightPurpleTint">#F0E6FF</Color>
    <Color x:Key="DarkDangerTint">#2B161E</Color>
    <Color x:Key="LightDangerTint">#FFE4E9</Color>
    <Color x:Key="DarkAccentBorder">#2E5F42</Color>
    <Color x:Key="LightAccentBorder">#8ADCA8</Color>
    <Color x:Key="DarkPurpleBorder">#4A3670</Color>
    <Color x:Key="LightPurpleBorder">#C9A6F5</Color>
    <Color x:Key="DarkDangerBorder">#5E2E3C</Color>
    <Color x:Key="LightDangerBorder">#F5A8B7</Color>

    <!--
        Scrim behind a bottom sheet. The one place alpha is correct: it is an overlay dimming live
        content underneath, not a tint standing in for one.
    -->
    <Color x:Key="DarkScrim">#B80A0D12</Color>
    <Color x:Key="LightScrim">#8C2B3242</Color>

</ResourceDictionary>
