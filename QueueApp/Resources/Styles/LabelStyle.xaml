<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Naming convention: lbl{FontSize}_{FontAttributes}_{Color}
        e.g. lbl12_Regular_Gray100, lbl24_Bold_TextDark
        Only add a new key here when an existing one doesn't already cover the combination.

        Text never takes an accent *fill* token. Green, purple and red as text resolve to
        AccentText, PurpleText and DangerText, which are the vivid colours on dark and deepened
        ones on light — #39FF7A as text on a light page is 1.22:1.
    -->

    <!-- QueueEntry floating-label placeholder -->
    <Style x:Key="PlaceHolderLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>

    <!-- QueueEntry's currency prefix (e.g. "R" on a price field). Same size as the entry text itself. -->
    <Style x:Key="lbl16_Regular_EntryPrefix" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <!-- A field label above an entry — §7's fix for placeholder-as-label. -->
    <Style x:Key="lbl13_Bold_FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>

    <!--
        Tracked "mono" lines. There is no monospace family in Resources/Fonts, so the look comes
        from RobotoMedium plus letter spacing rather than a second typeface.
    -->
    <Style x:Key="lbl9_Mono_TextMuted" TargetType="Label">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontFamily" Value="RobotoMedium"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
        <Setter Property="CharacterSpacing" Value="1.6"/>
    </Style>
    <Style x:Key="lbl9_Mono_TextFaint" TargetType="Label" BasedOn="{StaticResource lbl9_Mono_TextMuted}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextDim}, Dark={StaticResource DarkTextDim}}"/>
    </Style>
    <Style x:Key="lbl9_Mono_Green" TargetType="Label" BasedOn="{StaticResource lbl9_Mono_TextMuted}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>
    <Style x:Key="lbl9_Mono_TextInk" TargetType="Label" BasedOn="{StaticResource lbl9_Mono_TextMuted}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl10_Mono_TextMuted" TargetType="Label">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontFamily" Value="RobotoMedium"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
        <Setter Property="CharacterSpacing" Value="1.6"/>
    </Style>
    <Style x:Key="lbl10_Mono_TextFaint" TargetType="Label" BasedOn="{StaticResource lbl10_Mono_TextMuted}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextDim}, Dark={StaticResource DarkTextDim}}"/>
    </Style>
    <Style x:Key="lbl10_Mono_Green" TargetType="Label" BasedOn="{StaticResource lbl10_Mono_TextMuted}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>
    <Style x:Key="lbl10_Mono_Purple" TargetType="Label" BasedOn="{StaticResource lbl10_Mono_TextMuted}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>
    <Style x:Key="lbl13_Mono_TextPrimary" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="RobotoMedium"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
        <Setter Property="CharacterSpacing" Value="0.6"/>
    </Style>
    <Style x:Key="lbl13_Mono_Green" TargetType="Label" BasedOn="{StaticResource lbl13_Mono_TextPrimary}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>
    <Style x:Key="lbl22_Mono_TextPrimary" TargetType="Label">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <!-- 11 -->
    <Style x:Key="lbl11_Bold_TextMid" TargetType="Label" BasedOn="{StaticResource SectionTitle}"/>
    <Style x:Key="lbl11_Bold_White" TargetType="Label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl11_Medium_White" TargetType="Label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="RobotoMedium"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <!-- 12 -->
    <Style x:Key="lbl12_Regular_TextLight" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>
    <Style x:Key="lbl12_Regular_Cream" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl12_Bold_Orange" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>

    <!-- 13 -->
    <Style x:Key="lbl13_Regular_TextLight" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>
    <Style x:Key="lbl13_Regular_TextMid" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>
    <Style x:Key="lbl13_Regular_BrownLight" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextDim}, Dark={StaticResource DarkTextDim}}"/>
    </Style>
    <Style x:Key="lbl13_Regular_Orange" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>
    <Style x:Key="lbl13_Bold_Orange" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>

    <!-- 14 -->
    <Style x:Key="lbl14_Regular_TextDark" TargetType="Label" BasedOn="{StaticResource Body}"/>
    <Style x:Key="lbl14_Bold_TextDark" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl14_Regular_TextLight" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>

    <!-- 15 -->
    <Style x:Key="lbl15_Bold_TextDark" TargetType="Label">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl15_Bold_Cream" TargetType="Label">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <!-- 16 -->
    <Style x:Key="lbl16_Regular_TextDark" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <!-- 18 -->
    <Style x:Key="lbl18_Bold_TextDark" TargetType="Label" BasedOn="{StaticResource H3}"/>

    <!-- 20 -->
    <Style x:Key="lbl20_Bold_TextDark" TargetType="Label">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl20_Bold_Cream" TargetType="Label">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <!-- 22 -->
    <Style x:Key="lbl22_Bold_Cream" TargetType="Label">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <!-- 24 -->
    <Style x:Key="lbl24_Bold_TextDark" TargetType="Label" BasedOn="{StaticResource H2}"/>

    <!-- 26 -->
    <Style x:Key="lbl26_Regular_Emoji" TargetType="Label">
        <Setter Property="FontSize" Value="26"/>
    </Style>

    <!-- 28 -->
    <Style x:Key="lbl28_Regular_Emoji" TargetType="Label">
        <Setter Property="FontSize" Value="28"/>
    </Style>

    <!-- 32 -->
    <Style x:Key="lbl32_Bold_TextDark" TargetType="Label" BasedOn="{StaticResource H1}"/>

    <!-- 40 -->
    <Style x:Key="lbl40_Regular_Emoji" TargetType="Label">
        <Setter Property="FontSize" Value="40"/>
    </Style>

    <!--
        Operator board. Sizes come off the board design's type scale, which runs half-steps
        (11.5, 13.5, 16.5) to keep body text legible at arm's length on a counter phone.
    -->
    <Style x:Key="lbl9_Regular_TextLight" TargetType="Label">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>
    <Style x:Key="lbl11_Regular_TextLight" TargetType="Label">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>
    <Style x:Key="lbl11_Regular_TextDark" TargetType="Label">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl12_Bold_TextDark" TargetType="Label">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl13_Bold_Green" TargetType="Label">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>
    <Style x:Key="lbl15_Bold_Purple" TargetType="Label">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontFamily" Value="RobotoBlack"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>
    <Style x:Key="lbl16_Bold_TextDark" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="RobotoBlack"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl16_Bold_Green" TargetType="Label" BasedOn="{StaticResource lbl16_Bold_TextDark}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>
    <Style x:Key="lbl16_Bold_TextMuted" TargetType="Label" BasedOn="{StaticResource lbl16_Bold_TextDark}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>
    <Style x:Key="lbl17_Bold_TextDark" TargetType="Label">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontFamily" Value="RobotoBlack"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl12_Mono_TextPrimary" TargetType="Label">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl16_Mono_TextPrimary" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>
    <Style x:Key="lbl16_Mono_TextMuted" TargetType="Label" BasedOn="{StaticResource lbl16_Mono_TextPrimary}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>
    <!-- The elapsed timer. Green and steady at every duration: it never escalates. -->
    <Style x:Key="lbl20_Mono_Green" TargetType="Label">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>

    <Style x:Key="lbl11_Regular_TextFaint" TargetType="Label">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextDim}, Dark={StaticResource DarkTextDim}}"/>
        <Setter Property="LineHeight" Value="1.45"/>
    </Style>

    <Style x:Key="lbl12_Regular_TextMuted" TargetType="Label">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
        <Setter Property="LineHeight" Value="1.45"/>
    </Style>

    <Style x:Key="lbl11_Mono_Tag" TargetType="Label">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="RobotoMedium"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <Style x:Key="lbl18_Mono_TextPrimary" TargetType="Label">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <Style x:Key="lbl18_Mono_Green" TargetType="Label" BasedOn="{StaticResource lbl18_Mono_TextPrimary}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>

    <Style x:Key="lbl14_Bold_Row" TargetType="Label">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <!-- Date rail on a booking row: the day number, then the month under it. -->
    <Style x:Key="lbl19_Bold_TextDark" TargetType="Label">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
        <Setter Property="LineBreakMode" Value="NoWrap"/>
    </Style>

    <Style x:Key="lbl11_Medium_Green" TargetType="Label">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="RobotoMedium"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>

    <!-- Status pill text. Green is the confirmed default; pending swaps it for purple. -->
    <Style x:Key="lbl10_Bold_Green" TargetType="Label">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
        <Setter Property="LineBreakMode" Value="NoWrap"/>
    </Style>

    <Style x:Key="lbl12_Regular_Danger" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightDangerText}, Dark={StaticResource DarkDangerText}}"/>
    </Style>

    <Style x:Key="lbl13_Regular_Danger" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightDangerText}, Dark={StaticResource DarkDangerText}}"/>
    </Style>

    <!--
        ================================================================================
        Selection states. The trigger lives here so no page has to name a colour to say
        "this row is the one you picked".
        ================================================================================
    -->

    <Style x:Key="lbl9_Mono_TextMuted_Selectable" TargetType="Label" BasedOn="{StaticResource lbl9_Mono_TextMuted}">
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="lbl13_Regular_TextMid_Selectable" TargetType="Label" BasedOn="{StaticResource lbl13_Regular_TextMid}">
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="lbl18_Mono_TextPrimary_Selectable" TargetType="Label" BasedOn="{StaticResource lbl18_Mono_TextPrimary}">
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A picked time slot sits on a filled green tile, so its label flips to the on-accent ink. -->
    <Style x:Key="lbl13_Mono_Slot_Selectable" TargetType="Label" BasedOn="{StaticResource lbl13_Mono_TextPrimary}">
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextOnAccent}, Dark={StaticResource DarkTextOnAccent}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Operator initials: green once that operator can take someone now. -->
    <Style x:Key="lbl13_Mono_Available" TargetType="Label" BasedOn="{StaticResource lbl13_Mono_TextPrimary}">
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsAnyAvailable}" Value="True">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- History filter chip labels. Root-sourced triggers swap the whole style from the page. -->
    <Style x:Key="lbl13_Chip" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>

    <Style x:Key="lbl13_Chip_Selected" TargetType="Label" BasedOn="{StaticResource lbl13_Chip}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>

    <!-- Open / closed pill text on a business landing header. -->
    <Style x:Key="lbl10_Mono_Open" TargetType="Label" BasedOn="{StaticResource lbl10_Mono_Green}"/>

    <Style x:Key="lbl10_Mono_Closed" TargetType="Label" BasedOn="{StaticResource lbl10_Mono_TextFaint}"/>

    <!-- The live card's status line: green when queueing, purple in booking mode, dim when shut. -->
    <Style x:Key="lbl10_Mono_LiveStatus" TargetType="Label" BasedOn="{StaticResource lbl10_Mono_Green}"/>

    <Style x:Key="lbl10_Mono_LiveStatus_Booking" TargetType="Label" BasedOn="{StaticResource lbl10_Mono_Purple}"/>

    <Style x:Key="lbl10_Mono_LiveStatus_Closed" TargetType="Label" BasedOn="{StaticResource lbl10_Mono_TextFaint}"/>

    <!-- Agenda header's open/closed line, and the history group header's "today". -->
    <Style x:Key="lbl9_Mono_OpenNow" TargetType="Label" BasedOn="{StaticResource lbl9_Mono_Green}"/>

    <Style x:Key="lbl9_Mono_ClosedNow" TargetType="Label" BasedOn="{StaticResource lbl9_Mono_TextFaint}"/>

    <!--
        ================================================================================
        History. These lines carry their own tracking and half-step sizes, so they get named
        styles rather than borrowing a near-match and drifting.
        ================================================================================
    -->

    <Style x:Key="lbl26_Bold_PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="CharacterSpacing" Value="-0.3"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <Style x:Key="lbl14_Bold_HistoryRow" TargetType="Label">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="-0.2"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <Style x:Key="lbl11_Regular_HistoryMeta" TargetType="Label">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>

    <!-- The pill's ink is data-bound from the row's status, so this style sets everything but colour. -->
    <Style x:Key="lbl9_Bold_StatusPill" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="CharacterSpacing" Value="0.8"/>
    </Style>

    <!-- A timestamp is decorative, which is exactly what TextDim is for. -->
    <Style x:Key="lbl10_Regular_Timestamp" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoRegular"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="CharacterSpacing" Value="0.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextDim}, Dark={StaticResource DarkTextDim}}"/>
    </Style>

    <!-- Group header: dim for past groups, green for the ones still ahead of you. -->
    <Style x:Key="lbl10_Bold_GroupHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="CharacterSpacing" Value="1.5"/>
        <Setter Property="LineBreakMode" Value="NoWrap"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextDim}, Dark={StaticResource DarkTextDim}}"/>
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsUpcoming}" Value="True">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="lbl13_Bold_Action" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <Style x:Key="lbl12_Mono_Purple" TargetType="Label" BasedOn="{StaticResource lbl12_Mono_TextPrimary}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>

    <Style x:Key="lbl11_Bold_TextMuted" TargetType="Label" BasedOn="{StaticResource lbl11_Bold_White}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>

    <!-- Browse dashboard. -->
    <Style x:Key="lbl10_Regular_TextMuted" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoRegular"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>

    <Style x:Key="lbl10_Bold_TextMuted" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>

    <Style x:Key="lbl18_Bold_Countdown" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoBold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextInk}, Dark={StaticResource DarkTextInk}}"/>
    </Style>

    <Style x:Key="lbl13_Regular_Accent" TargetType="Label" BasedOn="{StaticResource lbl13_Regular_TextLight}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>

    <!-- Upcoming booking status pill: confirmed is green, a pending request is purple. -->
    <Style x:Key="lbl10_Bold_StatusPill" TargetType="Label" BasedOn="{StaticResource lbl10_Bold_Green}">
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="pending">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Booking-flow day tile. A day with nothing free dims every line to TextDim, which is exactly
        what that token is for — nothing here is something the customer needs to read, because the
        day cannot be picked.
    -->
    <Style x:Key="lbl9_Mono_Day" TargetType="Label" BasedOn="{StaticResource lbl9_Mono_TextMuted}">
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsFull}" Value="True">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextDim}, Dark={StaticResource DarkTextDim}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="lbl18_Bold_Day" TargetType="Label" BasedOn="{StaticResource lbl18_Bold_TextDark}">
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsFull}" Value="True">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextDim}, Dark={StaticResource DarkTextDim}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="lbl9_Regular_Day" TargetType="Label" BasedOn="{StaticResource lbl9_Regular_TextLight}">
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsFull}" Value="True">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextDim}, Dark={StaticResource DarkTextDim}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
