<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Rules, dots, spinners and page grounds — the small painted things that are not a Border, a
        Label or a Button. Each style sets colour only; every size, margin and alignment stays at
        the use site, because those are layout and this pass does not touch layout.
    -->

    <!--
        Dividers. BoxView paints Color over BackgroundColor, so both are set: a divider that
        inherits the implicit BoxView style must not show a different colour underneath.
    -->
    <Style x:Key="bx_Divider" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
    </Style>

    <!--
        Booking-flow progress rail. A finished step sits at the dim green edge colour and the step
        you are on takes the full brand green, so "where am I" reads at a glance in both themes.
    -->
    <Style x:Key="bx3_Rail" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Style.Triggers>
            <DataTrigger TargetType="BoxView" Binding="{Binding IsDone}" Value="True">
                <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightAccentBorder}, Dark={StaticResource DarkAccentBorder}}"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentBorder}, Dark={StaticResource DarkAccentBorder}}"/>
            </DataTrigger>
            <DataTrigger TargetType="BoxView" Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Presence and status dots. These are fills, so they stay the vivid brand colour in both
        themes. The stroke is whatever surface the dot is punched out of, which is why there is one
        per elevation rather than one shared style.
    -->
    <Style x:Key="ell_AccentDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"/>
    </Style>

    <Style x:Key="ell_AccentDot_OnBg" TargetType="Ellipse" BasedOn="{StaticResource ell_AccentDot}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBg}, Dark={StaticResource DarkBg}}"/>
        <Setter Property="StrokeThickness" Value="2.5"/>
    </Style>

    <Style x:Key="ell_AccentDot_OnSurface" TargetType="Ellipse" BasedOn="{StaticResource ell_AccentDot}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
        <Setter Property="StrokeThickness" Value="2.5"/>
    </Style>

    <Style x:Key="ell_AccentDot_OnRaised" TargetType="Ellipse" BasedOn="{StaticResource ell_AccentDot}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
        <Setter Property="StrokeThickness" Value="2.5"/>
    </Style>

    <Style x:Key="ell_PurpleDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightPurple}, Dark={StaticResource DarkPurple}}"/>
    </Style>

    <!-- Open / closed dot on the agenda header. The page swaps the style, not the colour. -->
    <Style x:Key="ell_DimDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightTextDim}, Dark={StaticResource DarkTextDim}}"/>
    </Style>

    <!--
        Spinners. A spinner is a thin stroke, so it takes the text variant rather than the fill:
        neon green at 2px on a white sheet is not visible.
    -->
    <Style x:Key="ai_Accent" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>

    <Style x:Key="ai_Purple" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>

    <Style x:Key="ai_Muted" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
    </Style>

    <!--
        Page grounds. Several screens paint the root Grid rather than the Page, usually because a
        sheet or an overlay sits in the same Grid.
    -->
    <Style x:Key="grid_Page" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBg}, Dark={StaticResource DarkBg}}"/>
    </Style>

    <Style x:Key="grid_Surface" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
    </Style>

    <!--
        The "now" line across the agenda. It is a 1px rule, so it takes the text variant: the vivid
        green would vanish against a light page at that weight.
    -->
    <Style x:Key="bx_NowLine" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>

    <!-- The wait bar behind a browse row. Its progress colour is data-bound off the wait bucket. -->
    <Style x:Key="pb_WaitTrack" TargetType="ProgressBar">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRaised}, Dark={StaticResource DarkRaised}}"/>
    </Style>

    <!--
        ================================================================================
        VisitPage. The timeline rail, its dots, and the queue strip that stands in for a ticket
        sequence the schema does not have yet.
        ================================================================================
    -->

    <!-- Left rule on a note block: purple is information waiting on someone, green is the shop acting. -->
    <Style x:Key="bx3_RulePurple" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightPurpleText}, Dark={StaticResource DarkPurpleText}}"/>
    </Style>

    <Style x:Key="bx3_RuleGreen" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
    </Style>

    <!-- The connector between two timeline dots. A hairline, so it takes Border rather than a fill. -->
    <Style x:Key="bx_StepConnector" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
    </Style>

    <!-- Timeline dot. Done is filled, pending is hollow, failed is filled in the danger ink. -->
    <Style x:Key="ell_StepDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Style.Triggers>
            <DataTrigger TargetType="Ellipse" Binding="{Binding IsPending}" Value="True">
                <Setter Property="Fill" Value="Transparent"/>
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
            </DataTrigger>
            <DataTrigger TargetType="Ellipse" Binding="{Binding IsFailed}" Value="True">
                <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightDangerText}, Dark={StaticResource DarkDangerText}}"/>
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightDangerText}, Dark={StaticResource DarkDangerText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Queue strip. queue_entries has no per-day ticket sequence, so the strip degrades to the one
        fact that does exist: how many people are ahead of you, and which dot is yours.
    -->
    <Style x:Key="ell_QueueDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>
        <Style.Triggers>
            <DataTrigger TargetType="Ellipse" Binding="{Binding IsYou}" Value="True">
                <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightAccentText}, Dark={StaticResource DarkAccentText}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
