<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="QueueApp.Shared.Templates.AlzowEditor.AlzowEditor">

    <Border x:Name="EditorBorder" Padding="12,6" Style="{StaticResource brd16_Editor}">
        <Editor x:Name="EditorControl"
                Focused="OnEditorFocused"
                Unfocused="OnEditorUnfocused"
                Style="{StaticResource editor14_Alzow}"
                Text="{Binding Text, Source={x:Reference Root}}"
                Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                MaxLength="{Binding MaxLength, Source={x:Reference Root}}"
                IsEnabled="{Binding IsEditorEnabled, Source={x:Reference Root}}"/>
    </Border>

</ContentView>
