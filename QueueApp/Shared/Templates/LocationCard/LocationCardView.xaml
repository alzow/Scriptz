<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             x:Name="Root"
             VerticalOptions="Start"
             x:Class="QueueApp.Shared.Templates.LocationCard.LocationCardView">

    <!--
    Where the shop is and how far off, as one tappable card that opens the map. The landing and the
    visit page both end on it, so it carries no outer margin — the page places it.
    -->
    <VerticalStackLayout Spacing="10">

        <Label Text="{Binding SectionTitle, Source={x:Reference Root}}" Style="{StaticResource lbl15_Bold_TextDark}"/>

        <Border Padding="13" Style="{StaticResource brd16_Surface}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenDirectionsCommand, Source={x:Reference Root}}"/>
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" Padding="0"
                        Style="{StaticResource brd_Raised_Lined}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="13"/>
                    </Border.StrokeShape>
                    <tpl:ThemedIcon Icon="ic_pin" WidthRequest="19" HeightRequest="19"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="{Binding AddressLine, Source={x:Reference Root}}" Style="{StaticResource lbl14_Bold_TextDark}"/>
                    <Label Text="{Binding DistanceText, Source={x:Reference Root}}" Style="{StaticResource lbl12_Regular_TextLight}"
                           IsVisible="{Binding HasDistance, Source={x:Reference Root}}"/>
                </VerticalStackLayout>
                <tpl:ThemedIcon Grid.Column="2" Icon="ic_chevron_right" WidthRequest="16" HeightRequest="16"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

    </VerticalStackLayout>

</ContentView>
