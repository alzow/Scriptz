<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skeleton="clr-namespace:QueueApp.Shared.Templates.Skeleton"
             x:Class="QueueApp.Shared.Templates.Skeleton.Archetypes.SkeletonListRowView">

    <Border Style="{StaticResource brd16_ListRow}">
        <Grid ColumnDefinitions="Auto,*,Auto" Style="{StaticResource grid_ListRow}">

            <skeleton:SkeletonBar Grid.Column="0" Style="{StaticResource skl_Block_RowIcon}"/>

            <VerticalStackLayout Grid.Column="1" Style="{StaticResource vsl_RowText}">
                <Grid ColumnDefinitions="58*,42*">
                    <skeleton:SkeletonBar Grid.Column="0" Style="{StaticResource skl_Line_Title}"/>
                </Grid>
                <Grid ColumnDefinitions="36*,64*">
                    <skeleton:SkeletonBar Grid.Column="0" Style="{StaticResource skl_Line_Meta}"/>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Style="{StaticResource vsl_RowTrailing}">
                <skeleton:SkeletonBar Style="{StaticResource skl_Pill}"/>
                <skeleton:SkeletonBar Style="{StaticResource skl_Line_Timestamp}"/>
            </VerticalStackLayout>

        </Grid>
    </Border>

</ContentView>
