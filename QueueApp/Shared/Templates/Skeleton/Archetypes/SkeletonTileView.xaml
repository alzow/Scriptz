<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skeleton="clr-namespace:QueueApp.Shared.Templates.Skeleton"
             x:Class="QueueApp.Shared.Templates.Skeleton.Archetypes.SkeletonTileView">

    <VerticalStackLayout Style="{StaticResource vsl_Tile}">
        <skeleton:SkeletonBar Style="{StaticResource skl_Circle_52}"/>
        <Grid ColumnDefinitions="15*,70*,15*">
            <skeleton:SkeletonBar Grid.Column="1" Style="{StaticResource skl_Line_Caption}"/>
        </Grid>
    </VerticalStackLayout>

</ContentView>
