<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skeleton="clr-namespace:QueueApp.Shared.Templates.Skeleton"
             x:Class="QueueApp.Shared.Templates.Skeleton.Archetypes.SkeletonStatsBarView">

    <Border Style="{StaticResource brd14_StatsBar}">
        <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*">

            <VerticalStackLayout Grid.Column="0" Style="{StaticResource vsl_StatCell}">
                <Grid ColumnDefinitions="27*,46*,27*">
                    <skeleton:SkeletonBar Grid.Column="1" Style="{StaticResource skl_Line_Stat}"/>
                </Grid>
                <Grid ColumnDefinitions="19*,62*,19*">
                    <skeleton:SkeletonBar Grid.Column="1" Style="{StaticResource skl_Line_Caption}"/>
                </Grid>
            </VerticalStackLayout>

            <BoxView Grid.Column="1" WidthRequest="1" HeightRequest="22"
                     Style="{StaticResource bx_Divider}" VerticalOptions="Center"/>

            <VerticalStackLayout Grid.Column="2" Style="{StaticResource vsl_StatCell}">
                <Grid ColumnDefinitions="27*,46*,27*">
                    <skeleton:SkeletonBar Grid.Column="1" Style="{StaticResource skl_Line_Stat}"/>
                </Grid>
                <Grid ColumnDefinitions="19*,62*,19*">
                    <skeleton:SkeletonBar Grid.Column="1" Style="{StaticResource skl_Line_Caption}"/>
                </Grid>
            </VerticalStackLayout>

            <BoxView Grid.Column="3" WidthRequest="1" HeightRequest="22"
                     Style="{StaticResource bx_Divider}" VerticalOptions="Center"/>

            <VerticalStackLayout Grid.Column="4" Style="{StaticResource vsl_StatCell}">
                <Grid ColumnDefinitions="27*,46*,27*">
                    <skeleton:SkeletonBar Grid.Column="1" Style="{StaticResource skl_Line_Stat}"/>
                </Grid>
                <Grid ColumnDefinitions="19*,62*,19*">
                    <skeleton:SkeletonBar Grid.Column="1" Style="{StaticResource skl_Line_Caption}"/>
                </Grid>
            </VerticalStackLayout>

            <BoxView Grid.Column="5" WidthRequest="1" HeightRequest="22"
                     Style="{StaticResource bx_Divider}" VerticalOptions="Center"/>

            <VerticalStackLayout Grid.Column="6" Style="{StaticResource vsl_StatCell}">
                <Grid ColumnDefinitions="27*,46*,27*">
                    <skeleton:SkeletonBar Grid.Column="1" Style="{StaticResource skl_Line_Stat}"/>
                </Grid>
                <Grid ColumnDefinitions="19*,62*,19*">
                    <skeleton:SkeletonBar Grid.Column="1" Style="{StaticResource skl_Line_Caption}"/>
                </Grid>
            </VerticalStackLayout>

        </Grid>
    </Border>

</ContentView>
