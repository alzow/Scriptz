<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skeleton="clr-namespace:QueueApp.Shared.Templates.Skeleton"
             x:Class="QueueApp.Shared.Templates.Skeleton.Archetypes.SkeletonTimeRowView">

    <Border Style="{StaticResource brd14_TimeRow}">
        <Grid ColumnDefinitions="46,3,*,Auto" Style="{StaticResource grid_TimeRow}">

            <VerticalStackLayout Grid.Column="0" Style="{StaticResource vsl_RowText}">
                <skeleton:SkeletonBar Style="{StaticResource skl_Line_Time}"/>
                <skeleton:SkeletonBar Style="{StaticResource skl_Line_Caption}" WidthRequest="26" HorizontalOptions="Start"/>
            </VerticalStackLayout>

            <skeleton:SkeletonBar Grid.Column="1" Style="{StaticResource skl_Block_TimeRail}"/>

            <VerticalStackLayout Grid.Column="2" Style="{StaticResource vsl_RowText}">
                <Grid ColumnDefinitions="56*,44*">
                    <skeleton:SkeletonBar Grid.Column="0" Style="{StaticResource skl_Line_Title}"/>
                </Grid>
                <Grid ColumnDefinitions="40*,60*">
                    <skeleton:SkeletonBar Grid.Column="0" Style="{StaticResource skl_Line_Meta}"/>
                </Grid>
            </VerticalStackLayout>

            <skeleton:SkeletonBar Grid.Column="3" Style="{StaticResource skl_Pill}"/>

        </Grid>
    </Border>

</ContentView>
