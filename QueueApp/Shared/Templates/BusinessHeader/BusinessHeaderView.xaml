<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tpl="clr-namespace:QueueApp.Shared.Templates"
             x:Name="Root"
             VerticalOptions="Start"
             x:Class="QueueApp.Shared.Templates.BusinessHeader.BusinessHeaderView">

    <!--
    The header every page that sits on one business wears: a text back link, the name with a pill
    beside it, the address, an optional meta line, and a rule. The landing and the visit page share
    it so the two read as the same shop seen twice, not two screens.
    -->
    <VerticalStackLayout Spacing="0">

        <Grid ColumnDefinitions="Auto,*,Auto" Padding="20,12,20,16">

            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand, Source={x:Reference Root}}"/>
                </HorizontalStackLayout.GestureRecognizers>
                <tpl:ThemedIcon Icon="ic_chevron_left" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                <Label Text="Back" Style="{StaticResource lbl13_Regular_TextMid}" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!--
            The trailing action mirrors the back link rather than sitting in a tile: two text links
            on one line read as a pair, where a floating button read as something bolted on.
            -->
            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center"
                                   IsVisible="{Binding HasAction, Source={x:Reference Root}}">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ActionCommand, Source={x:Reference Root}}"/>
                </HorizontalStackLayout.GestureRecognizers>
                <tpl:ThemedIcon Icon="{Binding ActionIcon, Source={x:Reference Root}}"
                                WidthRequest="15" HeightRequest="15" VerticalOptions="Center"/>
                <Label Text="{Binding ActionText, Source={x:Reference Root}}"
                       Style="{StaticResource lbl13_Regular_TextMid}" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="20,0">
            <Label Grid.Column="0" Text="{Binding BusinessName, Source={x:Reference Root}}"
                   Style="{StaticResource lbl24_Bold_TextDark}"/>
            <Border Grid.Column="1" Padding="9,5" VerticalOptions="Start"
                    Style="{StaticResource brd8_OpenPill}"
                    IsVisible="{Binding PillText, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding PillTone, Source={x:Reference Root}}" Value="Good">
                        <Setter Property="Style" Value="{StaticResource brd8_OpenPill}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding PillTone, Source={x:Reference Root}}" Value="Muted">
                        <Setter Property="Style" Value="{StaticResource brd8_ClosedPill}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding PillTone, Source={x:Reference Root}}" Value="Bad">
                        <Setter Property="Style" Value="{StaticResource brd8_DangerPill}"/>
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding PillText, Source={x:Reference Root}}"
                       Style="{StaticResource lbl11_Mono_Open}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding PillTone, Source={x:Reference Root}}" Value="Good">
                            <Setter Property="Style" Value="{StaticResource lbl11_Mono_Open}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding PillTone, Source={x:Reference Root}}" Value="Muted">
                            <Setter Property="Style" Value="{StaticResource lbl11_Mono_Closed}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding PillTone, Source={x:Reference Root}}" Value="Bad">
                            <Setter Property="Style" Value="{StaticResource lbl11_Mono_Danger}"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </Grid>

        <!-- The two sub-lines share one block so the gap above the rule holds when only one shows. -->
        <VerticalStackLayout Spacing="12" Padding="20,7,20,16">
            <Label Text="{Binding AddressLine, Source={x:Reference Root}}"
                   Style="{StaticResource lbl13_Regular_TextMid}"
                   IsVisible="{Binding AddressLine, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
            <Label Text="{Binding MetaLine, Source={x:Reference Root}}"
                   Style="{StaticResource lbl11_Mono_TextFaint}"
                   IsVisible="{Binding MetaLine, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
        </VerticalStackLayout>

        <BoxView HeightRequest="1" Style="{StaticResource bx_Divider}" Margin="20,0"/>

    </VerticalStackLayout>

</ContentView>
