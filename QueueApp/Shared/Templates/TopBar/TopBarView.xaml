<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:topbar="clr-namespace:QueueApp.Shared.Templates.TopBar"
             x:Name="Root"
             VerticalOptions="Start"
             x:Class="QueueApp.Shared.Templates.TopBar.TopBarView">

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,14,20,6">

        <topbar:BackButtonView Grid.Column="0"
                               Command="{Binding GoBackCommand, Source={x:Reference Root}}"/>

        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
            <Label Text="{Binding FlowTitle, Source={x:Reference Root}}" Style="{StaticResource lbl15_Bold_TextDark}"
                   IsVisible="{Binding IsFlowActive, Source={x:Reference Root}}"/>
            <Label Text="{Binding BusinessName, Source={x:Reference Root}}" Style="{StaticResource lbl12_Bold_TextMuted}"
                   IsVisible="{Binding BusinessName, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
        </VerticalStackLayout>
    </Grid>

</ContentView>
