<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QueueApp.Services.Api.Intake.Models"
             x:Name="Root"
             x:Class="QueueApp.Shared.Templates.IntakeAnswerList.IntakeAnswerListView">

    <!--
        The questions a visit was asked and what was said back, in the order they were asked, with
        each question as it was worded at the time. Answers carry their own label, so nothing here
        reads the current field definitions and nothing here changes if the shop later edits them.
        Shared: the customer reads it on their visit, the shop reads the same list off either
        operator board, and only the file-open command differs between them.
    -->
    <VerticalStackLayout Spacing="10">
        <Label Text="{Binding SectionTitle, Source={x:Reference Root}}"
               Style="{StaticResource lbl15_Bold_TextDark}"/>

        <Border Style="{StaticResource brd13_Raised}" Padding="14,4">
            <VerticalStackLayout Spacing="0"
                                 BindableLayout.ItemsSource="{Binding Answers, Source={x:Reference Root}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:IntakeAnswer">
                        <VerticalStackLayout Spacing="4" Padding="0,10">
                            <Label Text="{Binding Label}"
                                   Style="{StaticResource lbl13_Regular_TextLight}"/>

                            <Label Text="{Binding DisplayText}"
                                   IsVisible="{Binding HasAnswer}"
                                   Style="{StaticResource lbl13_Regular_TextMid}">
                                <!-- A file answer is the one that can be opened rather than read. -->
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFile}" Value="True">
                                        <Setter Property="Style" Value="{StaticResource lbl13_Bold_Action}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenFileCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- An optional question nobody answered still shows: the shop has to be
                                 able to tell "asked, not answered" from "never asked". -->
                            <Label Text="Not answered"
                                   IsVisible="{Binding HasAnswer, Converter={StaticResource InvertedBoolConverter}}"
                                   Style="{StaticResource lbl13_Mono_TextMuted}"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>

</ContentView>
