<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="SubPageHeaderView"
             x:Class="QueueApp.Shared.Templates.AlzowSubPageHeader.AlzowSubPageHeader">

    <Grid ColumnDefinitions="48,*,48"
          Padding="16,20,16,16">

        <!-- Back button -->
        <ImageButton Grid.Column="0"
                     Source="{Binding BackIcon, Source={x:Reference SubPageHeaderView}}"
                     HeightRequest="24"
                     WidthRequest="24"
                     VerticalOptions="Center"
                     HorizontalOptions="Start"
                     BackgroundColor="Transparent"
                     Command="{Binding BackCommand, Source={x:Reference SubPageHeaderView}}"/>

        <!-- Title -->
        <Label Grid.Column="1"
               Text="{Binding Title, Source={x:Reference SubPageHeaderView}}"
               TextColor="{Binding TitleColor, Source={x:Reference SubPageHeaderView}}"
               Style="{StaticResource lbl18_Bold_TextDark}"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>

    </Grid>
</ContentView>
