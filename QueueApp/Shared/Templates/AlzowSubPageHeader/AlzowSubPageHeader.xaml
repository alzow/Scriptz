<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:topbar="clr-namespace:QueueApp.Shared.Templates.TopBar"
             x:Name="SubPageHeaderView"
             x:Class="QueueApp.Shared.Templates.AlzowSubPageHeader.AlzowSubPageHeader">

    <!-- Rendered by the flows' own top bar, so a pushed sub-page and a flow step carry the same
         header chrome and the same back glyph rather than two that merely look similar. -->
    <topbar:TopBarView FlowTitle="{Binding Title, Source={x:Reference SubPageHeaderView}}"
                       IsFlowActive="True"
                       BusinessName="{Binding Subtitle, Source={x:Reference SubPageHeaderView}}"
                       GoBackCommand="{Binding BackCommand, Source={x:Reference SubPageHeaderView}}"/>

</ContentView>
