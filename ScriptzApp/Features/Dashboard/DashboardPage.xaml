<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScriptzApp.Features.Dashboard"
             x:Class="ScriptzApp.Features.Dashboard.DashboardPage"
             x:DataType="vm:DashboardPageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Cream}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Brown header with greeting + medical aid bar -->
            <Grid BackgroundColor="{StaticResource Brown}"
                  Padding="20,52,20,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Greeting row -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Good morning"
                               FontSize="12" TextColor="{StaticResource BrownLight}"
                               CharacterSpacing="2"/>
                        <Label Text="{Binding WelcomeMessage}"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource Cream}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource Orange}"
                            WidthRequest="42" HeightRequest="42"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13"/>
                        </Border.StrokeShape>
                        <Label Text="💊" FontSize="20"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Medical Aid mini bar -->
                <Border Grid.Row="1"
                        BackgroundColor="#14FAF6F1"
                        StrokeThickness="0"
                        Padding="16,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Medical Aid Savings"
                                   FontSize="12" TextColor="#B3FAF6F1"/>
                            <Label Grid.Column="1" Text="{Binding BenefitRemainingText}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Cream}"/>
                        </Grid>
                        <ProgressBar Progress="{Binding BenefitUsedFraction}"
                                     ProgressColor="{StaticResource Orange}"
                                     BackgroundColor="#26FAF6F1"
                                     HeightRequest="7"/>
                        <Label Text="{Binding BenefitSummaryText}"
                               FontSize="11" TextColor="#73FAF6F1"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Page content -->
            <VerticalStackLayout Padding="16,0,16,24" Spacing="0">

                <!-- Urgent refill alert -->
                <Border IsVisible="{Binding HasUrgentMedication}"
                        BackgroundColor="{StaticResource OrangePale}"
                        Stroke="{StaticResource Orange}"
                        StrokeThickness="1.5"
                        Margin="0,18,0,0"
                        Padding="14,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="⚠️" FontSize="26" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding UrgentMedicationName}"
                                   FontAttributes="Bold" FontSize="14"
                                   TextColor="{StaticResource Brown}"/>
                            <Label Text="{Binding UrgentMedicationSubText}"
                                   FontSize="13" TextColor="{StaticResource BrownMid}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="2"
                                Text="View"
                                Command="{Binding NavigateToMedicationsCommand}"
                                BackgroundColor="{StaticResource Orange}"
                                TextColor="{StaticResource White}"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                Padding="12,8"
                                HeightRequest="36"/>
                    </Grid>
                </Border>

                <!-- Quick Actions section title -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,10">
                    <Label Grid.Column="0" Text="QUICK ACTIONS"
                           Style="{StaticResource SectionTitle}"/>
                </Grid>

                <!-- Quick Actions 2×2 grid -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="10" RowSpacing="10">

                    <!-- Order Script -->
                    <Border Grid.Row="0" Grid.Column="0"
                            BackgroundColor="{StaticResource OrangePale}"
                            Stroke="#33E8621A" StrokeThickness="1"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToMedicationsCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💊" FontSize="28"/>
                            <Label Text="Order Script" FontAttributes="Bold" FontSize="14"
                                   TextColor="{StaticResource TextDark}" Margin="0,6,0,0"/>
                            <Label Text="Upload prescription" FontSize="12"
                                   TextColor="{StaticResource TextLight}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Chronic Meds -->
                    <Border Grid.Row="0" Grid.Column="1"
                            BackgroundColor="{StaticResource TealPale}"
                            Stroke="#331A7A6E" StrokeThickness="1"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToMedicationsCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🔄" FontSize="28"/>
                            <Label Text="Chronic Meds" FontAttributes="Bold" FontSize="14"
                                   TextColor="{StaticResource TextDark}" Margin="0,6,0,0"/>
                            <Label Text="Manage auto-refills" FontSize="12"
                                   TextColor="{StaticResource TextLight}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Shop OTC -->
                    <Border Grid.Row="1" Grid.Column="0"
                            BackgroundColor="{StaticResource GreenPale}"
                            Stroke="#332D6A4F" StrokeThickness="1"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🛍️" FontSize="28"/>
                            <Label Text="Shop OTC" FontAttributes="Bold" FontSize="14"
                                   TextColor="{StaticResource TextDark}" Margin="0,6,0,0"/>
                            <Label Text="Delivery to your door" FontSize="12"
                                   TextColor="{StaticResource TextLight}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Benefits -->
                    <Border Grid.Row="1" Grid.Column="1"
                            BackgroundColor="{StaticResource GoldPale}"
                            Stroke="#33C8860A" StrokeThickness="1"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🏥" FontSize="28"/>
                            <Label Text="Benefits" FontAttributes="Bold" FontSize="14"
                                   TextColor="{StaticResource TextDark}" Margin="0,6,0,0"/>
                            <Label Text="Track medical aid" FontSize="12"
                                   TextColor="{StaticResource TextLight}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Active Scripts section title -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,10">
                    <Label Grid.Column="0" Text="ACTIVE SCRIPTS"
                           Style="{StaticResource SectionTitle}"/>
                    <Label Grid.Column="1" Text="View all"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource Orange}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToMedicationsCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Active Medications list -->
                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding ActiveMedications}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource CreamBorder}"
                                    StrokeThickness="1"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold" FontSize="15"
                                                   TextColor="{StaticResource TextDark}"/>
                                            <Label Text="{Binding SubText}"
                                                   FontSize="13" TextColor="{StaticResource TextLight}"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding StatusBgColor}"
                                                StrokeThickness="0"
                                                Padding="9,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Status}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{Binding StatusColor}"/>
                                        </Border>
                                    </Grid>
                                    <Button Text="🛵 Request Delivery"
                                            IsVisible="{Binding IsReady}"
                                            BackgroundColor="{StaticResource Green}"
                                            TextColor="{StaticResource White}"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            CornerRadius="12"
                                            HeightRequest="44"
                                            Margin="0,12,0,0"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Empty state when no scripts -->
                <Border IsVisible="{Binding HasNoMedications}"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource CreamBorder}"
                        StrokeThickness="1"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="💊" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="No active scripts"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{StaticResource TextDark}"
                               HorizontalOptions="Center"/>
                        <Label Text="Submit a prescription to get started"
                               FontSize="13" TextColor="{StaticResource TextLight}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Pharmacy partner card -->
                <Border BackgroundColor="{StaticResource Brown}"
                        StrokeThickness="0"
                        Margin="0,16,0,0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Spacing="14">
                            <Border BackgroundColor="{StaticResource Orange}"
                                    WidthRequest="52" HeightRequest="52"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Label Text="💊" FontSize="26"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="Laxmi Pharmacy"
                                           FontAttributes="Bold" FontSize="15"
                                           TextColor="{StaticResource Cream}"/>
                                    <Border BackgroundColor="#33E8621A"
                                            StrokeThickness="0" Padding="8,3">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20"/>
                                        </Border.StrokeShape>
                                        <Label Text="Partner" FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource Orange}"/>
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="Ext 1 · Open now · Pay on delivery"
                                       FontSize="13" TextColor="{StaticResource BrownLight}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,14,0,0">
                            <Border Grid.Column="0" BackgroundColor="#1AFAF6F1"
                                    Stroke="#26FAF6F1" StrokeThickness="1" Padding="0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="📞 Call" FontSize="12"
                                       TextColor="{StaticResource Cream}" HorizontalOptions="Center"/>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#1AFAF6F1"
                                    Stroke="#26FAF6F1" StrokeThickness="1" Padding="0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="📍 Map" FontSize="12"
                                       TextColor="{StaticResource Cream}" HorizontalOptions="Center"/>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="#1AFAF6F1"
                                    Stroke="#26FAF6F1" StrokeThickness="1" Padding="0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="💬 Chat" FontSize="12"
                                       TextColor="{StaticResource Cream}" HorizontalOptions="Center"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
