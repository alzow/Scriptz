<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScriptzApp.Features.Medications"
             x:Class="ScriptzApp.Features.Medications.MedicationsListPage"
             x:DataType="vm:MedicationsListPageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Cream}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Brown header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Brown}"
              Padding="20,52,20,24">
            <VerticalStackLayout Spacing="2">
                <Label Text="My Scripts"
                       FontSize="24" FontAttributes="Bold"
                       TextColor="{StaticResource Cream}"/>
                <Label Text="Prescriptions &amp; orders"
                       FontSize="13" TextColor="{StaticResource BrownLight}"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Tab bar -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource CreamDark}"
                StrokeThickness="0"
                Margin="16,16,16,0"
                Padding="4">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">
                <!-- Active tab -->
                <Border Grid.Column="0"
                        BackgroundColor="{Binding ActiveTabBg}"
                        StrokeThickness="0"
                        Padding="0,11">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="11"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="active"/>
                    </Border.GestureRecognizers>
                    <Label Text="Active"
                           FontSize="13"
                           FontAttributes="{Binding ActiveTabFontAttr}"
                           TextColor="{Binding ActiveTabTextColor}"
                           HorizontalOptions="Center"/>
                </Border>
                <!-- Submit tab -->
                <Border Grid.Column="1"
                        BackgroundColor="{Binding SubmitTabBg}"
                        StrokeThickness="0"
                        Padding="0,11">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="11"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="submit"/>
                    </Border.GestureRecognizers>
                    <Label Text="Submit New"
                           FontSize="13"
                           FontAttributes="{Binding SubmitTabFontAttr}"
                           TextColor="{Binding SubmitTabTextColor}"
                           HorizontalOptions="Center"/>
                </Border>
                <!-- History tab -->
                <Border Grid.Column="2"
                        BackgroundColor="{Binding HistoryTabBg}"
                        StrokeThickness="0"
                        Padding="0,11">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="11"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="history"/>
                    </Border.GestureRecognizers>
                    <Label Text="History"
                           FontSize="13"
                           FontAttributes="{Binding HistoryTabFontAttr}"
                           TextColor="{Binding HistoryTabTextColor}"
                           HorizontalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Scrollable content -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <ScrollView Padding="16,12,16,0">

                <!-- ACTIVE TAB -->
                <VerticalStackLayout Spacing="12"
                                     IsVisible="{Binding IsActiveTab}">
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding ActiveScripts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScriptDisplayModel">
                                <Border BackgroundColor="{StaticResource White}"
                                        Stroke="{StaticResource CreamBorder}"
                                        StrokeThickness="1"
                                        Padding="16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="{Binding Name}"
                                                       FontAttributes="Bold" FontSize="15"
                                                       TextColor="{StaticResource TextDark}"/>
                                                <Label Text="{Binding QuantityAndRef}"
                                                       FontSize="13" TextColor="{StaticResource TextLight}"/>
                                                <Label Text="{Binding RefillsText}"
                                                       FontSize="12" TextColor="{StaticResource TextLight}"/>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{Binding StatusBgColor}"
                                                    StrokeThickness="0"
                                                    Padding="9,4">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="20"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Status}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="{Binding StatusColor}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Status step indicators -->
                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto"
                                              Margin="0,14,0,0">
                                            <!-- Ordered -->
                                            <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                                                <Border BackgroundColor="{Binding Step1Color}"
                                                        WidthRequest="20" HeightRequest="20"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="✓" FontSize="11" TextColor="White"
                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                                <Label Text="Ordered" FontSize="9"
                                                       TextColor="{Binding Step1Color}"
                                                       FontAttributes="{Binding Step1FontAttr}"
                                                       HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                            <BoxView Grid.Column="1" HeightRequest="2"
                                                     BackgroundColor="{Binding Line1Color}"
                                                     VerticalOptions="Start" Margin="3,9,3,0"/>
                                            <!-- Processing -->
                                            <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                                                <Border BackgroundColor="{Binding Step2Color}"
                                                        WidthRequest="20" HeightRequest="20"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="✓" FontSize="11" TextColor="White"
                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                                <Label Text="Processing" FontSize="9"
                                                       TextColor="{Binding Step2Color}"
                                                       FontAttributes="{Binding Step2FontAttr}"
                                                       HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                            <BoxView Grid.Column="3" HeightRequest="2"
                                                     BackgroundColor="{Binding Line2Color}"
                                                     VerticalOptions="Start" Margin="3,9,3,0"/>
                                            <!-- Ready -->
                                            <VerticalStackLayout Grid.Column="4" Spacing="4" HorizontalOptions="Center">
                                                <Border BackgroundColor="{Binding Step3Color}"
                                                        WidthRequest="20" HeightRequest="20"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="✓" FontSize="11" TextColor="White"
                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                                <Label Text="Ready" FontSize="9"
                                                       TextColor="{Binding Step3Color}"
                                                       FontAttributes="{Binding Step3FontAttr}"
                                                       HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                            <BoxView Grid.Column="5" HeightRequest="2"
                                                     BackgroundColor="{Binding Line3Color}"
                                                     VerticalOptions="Start" Margin="3,9,3,0"/>
                                            <!-- Delivered -->
                                            <VerticalStackLayout Grid.Column="6" Spacing="4" HorizontalOptions="Center">
                                                <Border BackgroundColor="{Binding Step4Color}"
                                                        WidthRequest="20" HeightRequest="20"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="✓" FontSize="11" TextColor="White"
                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                                <Label Text="Delivered" FontSize="9"
                                                       TextColor="{Binding Step4Color}"
                                                       FontAttributes="{Binding Step4FontAttr}"
                                                       HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Button Text="🛵 Request Delivery"
                                                IsVisible="{Binding IsReady}"
                                                BackgroundColor="{StaticResource Green}"
                                                TextColor="{StaticResource White}"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                CornerRadius="12"
                                                HeightRequest="48"
                                                Margin="0,14,0,0"/>
                                        <Label Text="Laxmi Pharmacy is preparing your script"
                                               IsVisible="{Binding IsProcessing}"
                                               FontSize="12" TextColor="{StaticResource TextLight}"
                                               HorizontalOptions="Center"
                                               Margin="0,10,0,0"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Empty state -->
                    <Border IsVisible="{Binding HasNoActiveScripts}"
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource CreamBorder}"
                            StrokeThickness="1"
                            Padding="40,36">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="💊" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="No active scripts"
                                   FontAttributes="Bold" FontSize="16"
                                   TextColor="{StaticResource TextDark}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Submit a new prescription to get started"
                                   FontSize="13" TextColor="{StaticResource TextLight}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SUBMIT TAB -->
                <VerticalStackLayout Spacing="14"
                                     IsVisible="{Binding IsSubmitTab}">

                    <!-- Info banner -->
                    <Border BackgroundColor="{StaticResource GoldPale}"
                            Stroke="#44C8860A" StrokeThickness="1"
                            Padding="14,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Label Text="📸 Take a clear photo of your doctor's prescription, or upload a PDF/image"
                               FontSize="13" TextColor="#7A5C00"/>
                    </Border>

                    <!-- Patient Name -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="PATIENT NAME" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="Full name as on script"
                                   Text="{Binding PatientName}"
                                   HeightRequest="50"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Doctor -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="DOCTOR / PRACTICE" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="e.g. Dr Moosa, Lenasia South"
                                   Text="{Binding DoctorName}"
                                   HeightRequest="50"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Medications -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="MEDICATION(S)" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="List if known, or leave blank"
                                   Text="{Binding MedicationNotes}"
                                   HeightRequest="50"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Notes -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="NOTES FOR PHARMACY" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="15,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <Editor Placeholder="Any special instructions"
                                    Text="{Binding PharmacyNotes}"
                                    MinimumHeightRequest="70"
                                    AutoSize="TextChanges"
                                    TextColor="{StaticResource TextDark}"
                                    PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Upload prescription -->
                    <Border BackgroundColor="{StaticResource CreamDark}"
                            Stroke="{StaticResource CreamBorder}"
                            StrokeThickness="2"
                            Padding="32">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="📄" FontSize="36" HorizontalOptions="Center"/>
                            <Label Text="Tap to upload prescription"
                                   FontSize="14" TextColor="{StaticResource TextLight}"
                                   HorizontalOptions="Center"/>
                            <Label Text="JPG, PNG or PDF"
                                   FontSize="12" TextColor="{StaticResource TextLight}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Delivery Address -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="DELIVERY ADDRESS" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="Your delivery address"
                                   Text="{Binding DeliveryAddress}"
                                   HeightRequest="50"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Submit button -->
                    <Button Text="Submit Script →"
                            Command="{Binding AddMedicationCommand}"
                            BackgroundColor="{StaticResource Brown}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="14"
                            HeightRequest="54"/>
                    <Label Text="Pay on delivery · No upfront cost"
                           TextColor="{StaticResource TextLight}"
                           FontSize="12" HorizontalOptions="Center"
                           Margin="0,0,0,8"/>
                </VerticalStackLayout>

                <!-- HISTORY TAB -->
                <VerticalStackLayout Spacing="12"
                                     IsVisible="{Binding IsHistoryTab}">
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding DeliveredScripts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScriptDisplayModel">
                                <Border BackgroundColor="{StaticResource White}"
                                        Stroke="{StaticResource CreamBorder}"
                                        StrokeThickness="1"
                                        Padding="16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="{Binding Name}"
                                                       FontAttributes="Bold" FontSize="15"
                                                       TextColor="{StaticResource TextDark}"/>
                                                <Label Text="{Binding QuantityAndRef}"
                                                       FontSize="13" TextColor="{StaticResource TextLight}"/>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1"
                                                    BackgroundColor="#1AB07850"
                                                    StrokeThickness="0"
                                                    Padding="9,4">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="20"/>
                                                </Border.StrokeShape>
                                                <Label Text="Delivered"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="{StaticResource BrownLight}"/>
                                            </Border>
                                        </Grid>
                                        <Button Text="Reorder"
                                                BackgroundColor="{StaticResource OrangePale}"
                                                TextColor="{StaticResource Orange}"
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                CornerRadius="10"
                                                HeightRequest="42"
                                                Margin="0,12,0,0"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Empty state -->
                    <Border IsVisible="{Binding HasNoHistory}"
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource CreamBorder}"
                            StrokeThickness="1"
                            Padding="40,36">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="📋" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="No history yet"
                                   FontAttributes="Bold" FontSize="16"
                                   TextColor="{StaticResource TextDark}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </ScrollView>
        </RefreshView>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource Orange}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Scale="1.5"/>
        </Grid>

    </Grid>

</ContentPage>
