<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScriptzApp.Features.Medications"
             x:Class="ScriptzApp.Features.Medications.MedicationDetailPage"
             x:DataType="vm:MedicationDetailPageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Cream}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Brown header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Brown}"
              Padding="20,52,20,24">
            <Grid ColumnDefinitions="Auto,*">
                <Label Grid.Column="0" Text="←" FontSize="24"
                       TextColor="#80FAF6F1" VerticalOptions="Center"
                       Margin="0,0,16,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="{Binding PageTitle}"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource Cream}"/>
                    <Label Text="Medication details"
                           FontSize="13" TextColor="{StaticResource BrownLight}"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- Scrollable form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Medication Name -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="MEDICATION NAME *" Style="{StaticResource SectionTitle}"/>
                    <Border BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource CreamBorder}"
                            StrokeThickness="1.5" Padding="15,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13"/>
                        </Border.StrokeShape>
                        <Entry Placeholder="e.g. Metformin"
                               Text="{Binding Name}"
                               HeightRequest="50"
                               TextColor="{StaticResource TextDark}"
                               PlaceholderColor="{StaticResource TextLight}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Generic Name -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="GENERIC NAME" Style="{StaticResource SectionTitle}"/>
                    <Border BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource CreamBorder}"
                            StrokeThickness="1.5" Padding="15,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13"/>
                        </Border.StrokeShape>
                        <Entry Placeholder="e.g. Metformin Hydrochloride"
                               Text="{Binding GenericName}"
                               HeightRequest="50"
                               TextColor="{StaticResource TextDark}"
                               PlaceholderColor="{StaticResource TextLight}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Dosage & Form -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Text="DOSAGE *" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="500mg"
                                   Text="{Binding Dosage}"
                                   HeightRequest="50"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextLight}"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="FORM *" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <Picker ItemsSource="{Binding FormOptions}"
                                    SelectedItem="{Binding Form}"
                                    TextColor="{StaticResource TextDark}"
                                    Title="Select"
                                    HeightRequest="50"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Frequency -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="FREQUENCY *" Style="{StaticResource SectionTitle}"/>
                    <Border BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource CreamBorder}"
                            StrokeThickness="1.5" Padding="15,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13"/>
                        </Border.StrokeShape>
                        <Picker ItemsSource="{Binding FrequencyOptions}"
                                SelectedItem="{Binding Frequency}"
                                TextColor="{StaticResource TextDark}"
                                Title="Select frequency"
                                HeightRequest="50"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Instructions -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="INSTRUCTIONS" Style="{StaticResource SectionTitle}"/>
                    <Border BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource CreamBorder}"
                            StrokeThickness="1.5" Padding="15,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13"/>
                        </Border.StrokeShape>
                        <Editor Placeholder="e.g. Take with food, avoid alcohol"
                                Text="{Binding Instructions}"
                                TextColor="{StaticResource TextDark}"
                                PlaceholderColor="{StaticResource TextLight}"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="70"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Dates -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Text="START DATE *" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="12,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <DatePicker Date="{Binding StartDate}"
                                        TextColor="{StaticResource TextDark}"
                                        HeightRequest="50"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="END DATE" Style="{StaticResource SectionTitle}"/>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource CreamBorder}"
                                StrokeThickness="1.5" Padding="12,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <DatePicker Date="{Binding EndDate}"
                                        TextColor="{StaticResource TextDark}"
                                        HeightRequest="50"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Chronic / Auto-refill card -->
                <Border BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource Orange}"
                        StrokeThickness="1.5"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="🔄" FontSize="26" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="12,0" VerticalOptions="Center">
                                <Label Text="Chronic Medication Auto-Refill"
                                       FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource TextDark}"/>
                                <Label Text="Automatically reorder when running low"
                                       FontSize="12" TextColor="{StaticResource TextLight}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding IsChronic}"
                                    OnColor="{StaticResource Orange}"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <!-- Refill days picker (only when chronic) -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsChronic}">
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource CreamBorder}"/>
                            <Label Text="Refill when supply reaches:"
                                   FontSize="12" TextColor="{StaticResource TextMid}"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Text="3 days"
                                        Command="{Binding SetRefillDaysCommand}"
                                        CommandParameter="3"
                                        BackgroundColor="{Binding RefillDays, Converter={StaticResource EqualsToColorConverter}, ConverterParameter='3|#E8621A|#E8DDD0'}"
                                        TextColor="{Binding RefillDays, Converter={StaticResource EqualsToColorConverter}, ConverterParameter='3|#FFFFFF|#6B4C35'}"
                                        CornerRadius="10"
                                        FontSize="13"
                                        HeightRequest="38"/>
                                <Button Grid.Column="1"
                                        Text="5 days"
                                        Command="{Binding SetRefillDaysCommand}"
                                        CommandParameter="5"
                                        BackgroundColor="{Binding RefillDays, Converter={StaticResource EqualsToColorConverter}, ConverterParameter='5|#E8621A|#E8DDD0'}"
                                        TextColor="{Binding RefillDays, Converter={StaticResource EqualsToColorConverter}, ConverterParameter='5|#FFFFFF|#6B4C35'}"
                                        CornerRadius="10"
                                        FontSize="13"
                                        HeightRequest="38"/>
                                <Button Grid.Column="2"
                                        Text="7 days"
                                        Command="{Binding SetRefillDaysCommand}"
                                        CommandParameter="7"
                                        BackgroundColor="{Binding RefillDays, Converter={StaticResource EqualsToColorConverter}, ConverterParameter='7|#E8621A|#E8DDD0'}"
                                        TextColor="{Binding RefillDays, Converter={StaticResource EqualsToColorConverter}, ConverterParameter='7|#FFFFFF|#6B4C35'}"
                                        CornerRadius="10"
                                        FontSize="13"
                                        HeightRequest="38"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Active status toggle -->
                <Border BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource CreamBorder}"
                        StrokeThickness="1"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Active Medication"
                                   FontAttributes="Bold" FontSize="14"
                                   TextColor="{StaticResource TextDark}"/>
                            <Label Text="Currently taking this medication"
                                   FontSize="12" TextColor="{StaticResource TextLight}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsActive}"
                                OnColor="{StaticResource Green}"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Delete button (edit mode only) -->
                <Button Text="🗑️ Delete Medication"
                        Command="{Binding DeleteMedicationCommand}"
                        IsVisible="{Binding IsEditMode}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Red}"
                        BorderWidth="1.5"
                        TextColor="{StaticResource Red}"
                        CornerRadius="14"
                        HeightRequest="50"
                        Margin="0,8,0,8"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom action buttons -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Padding="20,16"
              BackgroundColor="{StaticResource White}">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    BorderColor="{StaticResource CreamBorder}"
                    BorderWidth="1.5"
                    TextColor="{StaticResource TextMid}"
                    CornerRadius="14"
                    HeightRequest="52"/>
            <Button Grid.Column="1"
                    Text="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{StaticResource Orange}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="52"/>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource Orange}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Scale="1.5"/>
        </Grid>

    </Grid>

</ContentPage>
