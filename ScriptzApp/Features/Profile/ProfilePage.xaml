<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScriptzApp.Features.Profile"
             x:Class="ScriptzApp.Features.Profile.ProfilePage"
             x:DataType="vm:ProfilePageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Cream}"
             Title="Profile"
             IconImageSource="profile_tab.png">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Brown header with avatar -->
            <Grid BackgroundColor="{StaticResource Brown}"
                  Padding="20,52,20,28">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border BackgroundColor="{StaticResource Orange}"
                            WidthRequest="72" HeightRequest="72"
                            StrokeThickness="0"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36"/>
                        </Border.StrokeShape>
                        <Label Text="👤" FontSize="32"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="{Binding FullName}"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource Cream}"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding EmailAndLocation}"
                           FontSize="13" TextColor="{StaticResource BrownLight}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16,16,16,24" Spacing="16">

                <!-- Medical Aid Benefits card -->
                <Border BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource CreamBorder}"
                        StrokeThickness="1" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🏥 Medical Aid Benefits"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{StaticResource TextDark}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Savings used"
                                   FontSize="13" TextColor="{StaticResource TextMid}"/>
                            <Label Grid.Column="1"
                                   Text="{Binding BenefitUsedText}"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource TextDark}"/>
                        </Grid>
                        <ProgressBar Progress="{Binding BenefitFraction}"
                                     ProgressColor="{StaticResource Orange}"
                                     BackgroundColor="{StaticResource CreamBorder}"
                                     HeightRequest="12"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding BenefitPctText}"
                                   FontSize="12" TextColor="{StaticResource TextLight}"/>
                            <Label Grid.Column="1"
                                   Text="{Binding BenefitRemainingText}"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource Green}"/>
                        </Grid>
                        <!-- Stats grid -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                              ColumnSpacing="8" RowSpacing="8" Margin="0,4,0,0">
                            <Border Grid.Row="0" Grid.Column="0"
                                    BackgroundColor="{StaticResource CreamDark}"
                                    StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Scripts this month"
                                           FontSize="11" TextColor="{StaticResource TextLight}"/>
                                    <Label Text="3" FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource TextDark}"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1"
                                    BackgroundColor="{StaticResource CreamDark}"
                                    StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Total orders"
                                           FontSize="11" TextColor="{StaticResource TextLight}"/>
                                    <Label Text="12" FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource TextDark}"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0"
                                    BackgroundColor="{StaticResource CreamDark}"
                                    StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Next renewal"
                                           FontSize="11" TextColor="{StaticResource TextLight}"/>
                                    <Label Text="1 Mar" FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource TextDark}"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1"
                                    BackgroundColor="{StaticResource CreamDark}"
                                    StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Medical aid"
                                           FontSize="11" TextColor="{StaticResource TextLight}"/>
                                    <Label Text="Discovery" FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource TextDark}"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Settings sections -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="ACCOUNT" Style="{StaticResource SectionTitle}"/>
                    <Border BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource CreamBorder}"
                            StrokeThickness="1" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="16,14"
                                  ColumnSpacing="12">
                                <Label Grid.Column="0" Text="👤" FontSize="18"/>
                                <Label Grid.Column="1" Text="Personal Details"
                                       FontSize="14" TextColor="{StaticResource TextDark}"/>
                                <Label Grid.Column="3" Text="›" FontSize="20"
                                       TextColor="{StaticResource CreamBorder}"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource CreamBorder}" Margin="16,0"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="16,14" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="📍" FontSize="18"/>
                                <Label Grid.Column="1" Text="Delivery Addresses"
                                       FontSize="14" TextColor="{StaticResource TextDark}"/>
                                <Label Grid.Column="3" Text="›" FontSize="20"
                                       TextColor="{StaticResource CreamBorder}"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource CreamBorder}" Margin="16,0"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="16,14" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="🔔" FontSize="18"/>
                                <Label Grid.Column="1" Text="Notifications"
                                       FontSize="14" TextColor="{StaticResource TextDark}"/>
                                <Label Grid.Column="3" Text="›" FontSize="20"
                                       TextColor="{StaticResource CreamBorder}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="PREFERENCES" Style="{StaticResource SectionTitle}"/>
                    <Border BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource CreamBorder}"
                            StrokeThickness="1" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="16,14" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="💊" FontSize="18"/>
                                <Label Grid.Column="1" Text="Linked Pharmacy"
                                       FontSize="14" TextColor="{StaticResource TextDark}"/>
                                <Label Grid.Column="2" Text="Laxmi Pharmacy"
                                       FontSize="13" TextColor="{StaticResource TextLight}"/>
                                <Label Grid.Column="3" Text="›" FontSize="20"
                                       TextColor="{StaticResource CreamBorder}"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource CreamBorder}" Margin="16,0"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="16,14" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="💳" FontSize="18"/>
                                <Label Grid.Column="1" Text="Payment Method"
                                       FontSize="14" TextColor="{StaticResource TextDark}"/>
                                <Label Grid.Column="2" Text="Pay on Delivery"
                                       FontSize="13" TextColor="{StaticResource TextLight}"/>
                                <Label Grid.Column="3" Text="›" FontSize="20"
                                       TextColor="{StaticResource CreamBorder}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Sign Out -->
                <Button Text="Sign Out"
                        Command="{Binding LogoutCommand}"
                        BackgroundColor="{StaticResource RedPale}"
                        BorderColor="#33C0392B"
                        BorderWidth="1.5"
                        TextColor="{StaticResource Red}"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="14"
                        HeightRequest="52"/>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
