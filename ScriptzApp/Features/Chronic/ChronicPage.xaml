<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScriptzApp.Features.Chronic"
             x:Class="ScriptzApp.Features.Chronic.ChronicPage"
             x:DataType="vm:ChronicPageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Cream}"
             Title="Chronic"
             IconImageSource="chronic_tab.png">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Brown header -->
            <Grid BackgroundColor="{StaticResource Brown}"
                  Padding="20,52,20,24">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Chronic Meds"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="{StaticResource Cream}"/>
                    <Label Text="Auto-refill management"
                           FontSize="13" TextColor="{StaticResource BrownLight}"/>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16,16,16,24" Spacing="12">

                <!-- Info banner -->
                <Border BackgroundColor="{StaticResource TealPale}"
                        Stroke="#331A7A6E" StrokeThickness="1"
                        Padding="14,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Label Text="🔄 Auto-refill orders your medication 5 days before you run out, so you never miss a dose."
                           FontSize="13" TextColor="{StaticResource Teal}" FontAttributes="Bold"/>
                </Border>

                <!-- Meds list -->
                <VerticalStackLayout Spacing="12"
                                     BindableLayout.ItemsSource="{Binding ChronicMeds}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChronicMedItem">
                            <Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource CreamBorder}"
                                    StrokeThickness="1"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="12">

                                    <!-- Name + badge -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold" FontSize="15"
                                                   TextColor="{StaticResource TextDark}"/>
                                            <Label Text="{Binding Schedule}"
                                                   FontSize="13" TextColor="{StaticResource TextLight}"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding StockBg}"
                                                StrokeThickness="0" Padding="9,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding StockLabel}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{Binding StockColor}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Supply bar -->
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="Supply remaining"
                                                   FontSize="12" TextColor="{StaticResource TextLight}"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding DaysLeftText}"
                                                   FontSize="12" FontAttributes="Bold"
                                                   TextColor="{Binding BarColor}"/>
                                        </Grid>
                                        <ProgressBar Progress="{Binding SupplyFraction}"
                                                     ProgressColor="{Binding BarColor}"
                                                     BackgroundColor="{StaticResource CreamBorder}"
                                                     HeightRequest="8"/>
                                    </VerticalStackLayout>

                                    <!-- Auto-refill toggle -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Auto-refill" FontSize="12"
                                                   TextColor="{StaticResource TextLight}"/>
                                            <Label Text="{Binding NextOrderText}"
                                                   IsVisible="{Binding AutoRefill}"
                                                   FontSize="12" FontAttributes="Bold"
                                                   TextColor="{StaticResource Teal}"/>
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1"
                                                IsToggled="{Binding AutoRefill}"
                                                OnColor="{StaticResource Teal}"
                                                VerticalOptions="Center"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Add button -->
                <Border BackgroundColor="{StaticResource CreamDark}"
                        Stroke="{StaticResource CreamBorder}"
                        StrokeThickness="1.5"
                        Padding="0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Label Text="+ Add Chronic Medication"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource TextMid}"
                           HorizontalOptions="Center"/>
                </Border>

                <!-- How it works card -->
                <Border BackgroundColor="{StaticResource Brown}"
                        StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="💡 How auto-refill works"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{StaticResource Cream}"/>
                        <VerticalStackLayout Spacing="10"
                                             BindableLayout.ItemsSource="{Binding HowItWorksSteps}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:HowItWorksStep">
                                    <HorizontalStackLayout Spacing="10">
                                        <Border BackgroundColor="{StaticResource Orange}"
                                                WidthRequest="22" HeightRequest="22"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="11"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Number}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource White}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="{Binding Text}"
                                               FontSize="13" TextColor="{StaticResource BrownLight}"
                                               LineBreakMode="WordWrap" VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
